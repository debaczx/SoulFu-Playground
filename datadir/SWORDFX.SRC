//-----------------------------------------------------------------------
// TRUE if the sword hits a little softer to pay for draining...
int Soft(int ext)
  if(SwordElement(ext) == WEAPON_VARIANT_UNHOLY)
    if(SwordTier(ext) != SWORD_TIER_GREAT && SwordTier(ext) != SWORD_TIER_DRAGON)
      return TRUE
  return FALSE

//-----------------------------------------------------------------------
// TRUE if the character is undead (high wound defense)...
int Undead(int who)
  if(who.defwoun > 0 && who.defwoun < 128)
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// TRUE if the character has a burn ticker on it (PGSHOT.Burn)...
int Burning(int index)
  int i, child
  i = 0
  while(i < MAX_PARTICLE)
    child = FindParticle(i)
    if(child)
      if(child.xhand == BURN_TICKER && child.target == index)
        if(SystemGet(SYS_PARTICLESCRIPTFILE, 0, i) == "FILE:PGSHOT.RUN")
          return TRUE
    i++
  return FALSE

//-----------------------------------------------------------------------
// Frames left of a character's chill...
int Chilled(int who)
  return ((FileReadByte(who, CHILL_OFFSET+1)<<8) | FileReadByte(who, CHILL_OFFSET))

//-----------------------------------------------------------------------
// Decides whether a swing's effect goes off (called by PATTACK.FrameEvent
// as the swing starts, with self being the character)...  Stormbringer
// goes off after blocking, Soulrender once five souls are stored (both
// are only spent when the swing connects, see DragonHit)...
int SwingProc(int self, int ext)
  int tier, element
  tier = SwordTier(ext)
  element = SwordElement(ext)
  if(tier == SWORD_TIER_DRAGON && element == WEAPON_VARIANT_VOLT)
    if(FileReadByte(self, SWORD_STORM_OFFSET))
      return 1
    return 0
  if(tier == SWORD_TIER_DRAGON && element == WEAPON_VARIANT_UNHOLY)
    if(FileReadByte(self, SWORD_SOULS_OFFSET) >= 5)
      return 1
    return 0
  if(RollDice(1, 100) <= Chance(ext))
    return 1
  return 0

//-----------------------------------------------------------------------
// The holder of a sword just blocked a hit (PATTACK.Event)...  Charges
// Stormbringer...
int Blocked(int who)
  int ext
  ext = XITEM.Get(who, 243)
  if(IsSword(ext))
    if(SwordTier(ext) == SWORD_TIER_DRAGON && SwordElement(ext) == WEAPON_VARIANT_VOLT)
      if(FileReadByte(who, SWORD_STORM_OFFSET) == 0)
        FileWriteByte(who, SWORD_STORM_OFFSET, 1)
        PFLASH.Effect(who, "FILE:LITESPRK.RGB", YELLOW, TRUE, 1.2)
        PlaySound("FILE:-SHOCK.RAW", 300, 160)
  return TRUE

//-----------------------------------------------------------------------
// Short lightning bolt from a point toward a direction (owner & team
// come from the attack particle)...
int Zap(float x, float y, float z, float vx, float vy, int life)
  int self, child
  self = FindSelf()
  SetSpawnTarget(65535)
  SetSpawnOwner(self.owner)
  SetSpawnTeam(self.team)
  child = Spawn(PARTICLE, x, y, z, "FILE:PZAPPY.RUN")
  if(child)
    child.vx = vx
    child.vy = vy
    child.vz = 0.0
    child.length = 3.0
    child.width = 3.0
    child.image = NULL
    child.flags = PART_LIGHT_ON | PART_WALL_COLLISION_ON | PART_CHAR_COLLISION_ON
    child.team = self.team
    child.owner = self.owner
    child.misc4 = 6
    child.misc5 = 0
    child.misc6 = life
    child.misc7 = 48      // 2 damage per zap
    child.evtimer = 1
    child.target = 65535
  return child

//-----------------------------------------------------------------------
// Heals the owner a little, with a puff...
int Mend(int owner, int image)
  GENERIC.RestoreCharacterHits(owner, 1, 0)
  PEMBER.Effect(owner.x, owner.y, owner.z+1.0, 0.0, 0.0, 0.05, 2.0, 255, 12, image)
  return TRUE

//-----------------------------------------------------------------------
// Spawns a free moving attack particle (a bolt of fire, an arcane
// crescent)...
int Bolt(int owner_index, int team, float x, float y, float z, float vx, float vy, int dtype, int damage, int wound, int flags, int life, int image)
  int child
  SetSpawnTarget(65535)
  SetSpawnOwner(owner_index)
  SetSpawnTeam(team)
  child = Spawn(PARTICLE, x, y, z, "FILE:PATTACK.RUN")
  if(child)
    child.vx = vx
    child.vy = vy
    child.vz = 0.0
    child.misc6 = damage
    child.dtype = dtype
    child.misc7 = wound
    child.width = 1.4
    child.length = 1.4
    child.misc0 = 128
    child.evtimer = life
    child.number = flags
    child.image = image
    child.flags = child.flags | PART_LIGHT_ON
  return child

//-----------------------------------------------------------------------
// Lightning jumps from the target to up to count other enemies, nearest
// first (within 12 feet)...
int Chain(int target, int count)
  int self, i, who, found, done, best, used0, used1, used2
  float x, y, z, dx, dy, sl, bestsl
  self = FindSelf()
  z = target.z + (target.height*0.5)
  PlaySound("FILE:-SHOCK.RAW", 245 + RollDice(1, 20), 255)
  done = 0
  used0 = 255
  used1 = 255
  used2 = 255
  while(done < count)
    best = 255
    bestsl = 12.0
    i = 0
    while(i < MAX_CHARACTER)
      who = FindByIndex(i)
      if(who && who != target && i != used0 && i != used1 && i != used2)
        if(who.team != self.team && who.team != TEAM_NEUTRAL && who.hits > 0)
          dx = who.x - target.x
          dy = who.y - target.y
          sl = sqrt(dx*dx + dy*dy)
          if(sl < bestsl && sl > 0.1)
            bestsl = sl
            best = i
      i++
    if(best >= MAX_CHARACTER)
      return done
    who = FindByIndex(best)
    dx = (who.x - target.x)/bestsl
    dy = (who.y - target.y)/bestsl
    x = target.boxsize + 0.5
    Zap(target.x + (dx*x), target.y + (dy*x), z, dx*1.2, dy*1.2, 22)
    if(done == 0)
      used0 = best
    if(done == 1)
      used1 = best
    if(done == 2)
      used2 = best
    done++
  return done

//-----------------------------------------------------------------------
// Does something to everyone near a point...
//   kind 1: chill enemies    kind 2: set enemies burning
//   kind 3: heal allies (and the holder)
int Area(float x, float y, float range, int kind, int skip)
  int self, i, who, count
  float dx, dy
  self = FindSelf()
  count = 0
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(who && i != skip)
      dx = who.x - x
      dy = who.y - y
      if((dx*dx + dy*dy) < (range*range) && who.hits > 0 && who.team != TEAM_NEUTRAL)
        if(who.team != self.team)
          if(kind == 1)
            XITEM.Chill(who, CHILL_TIME)
            PSMOKE.Effect(who.x, who.y, who.z+1.0, 0.0, 0.0, 0.03, 1.5, 0.05, FALSE, ICE_SMOKE_COLOR, 200, 25)
            count++
          if(kind == 2)
            PGSHOT.Burn(i, self.owner, 4)
            count++
        else
          if(kind == 3)
            GENERIC.RestoreCharacterHits(who, 2, 0)
            PEMBER.Effect(who.x, who.y, who.z+1.0, 0.0, 0.0, 0.06, 3.0, 255, 10, "FILE:SPARK4.RGB")
            count++
    i++
  return count

//-----------------------------------------------------------------------
// Ring of ice puffs...
int FrostRing(float x, float y, float z)
  int i
  float angle
  PlaySound("FILE:-SPELL03.RAW", 200 + RollDice(1, 30), 255)
  i = 0
  while(i < 10)
    angle = i * 36.0
    PSMOKE.Effect(x, y, z, sin(angle)*0.25, sin(angle+90.0)*0.25, 0.0, 1.2, 0.08, FALSE, ICE_SMOKE_COLOR, 220, 20)
    PEMBER.Effect(x, y, z, sin(angle)*0.3, sin(angle+90.0)*0.3, 0.02, 0.8, 255, 14, "FILE:ICE1.RGB")
    i++
  return TRUE

//-----------------------------------------------------------------------
// Wyrmfang...  The Dragon Sword breathes fire when the attack button is
// held through the swing (IDSWORD.FrameEvent, self is the character)...
int Breath(int self)
  int index, i
  float x, y, z, a, sx, sy
  index = FindIndex(self)
  x = self.x + (self.frontx*1.5)
  y = self.y + (self.fronty*1.5)
  z = self.z + (self.height*0.6)
  sx = -self.fronty
  sy = self.frontx
  PlaySound("FILE:-SPELL03.RAW", 150 + RollDice(1, 20), 255)
  i = 0
  while(i < 5)
    a = (i-2)*0.22
    Bolt(index, self.team, x, y, z, (self.frontx + (sx*a))*0.7, (self.fronty + (sy*a))*0.7, DAMAGE_FIRE, 3, 1, SPECIAL_FLAG_CHOP_THROUGH, 14, "FILE:FIRE1.RGB")
    PEMBER.Effect(x, y, z, (self.frontx + (sx*a))*0.5, (self.fronty + (sy*a))*0.5, 0.02, 1.6, 255, 16, "FILE:FIRE0.RGB")
    i++
  return TRUE

//-----------------------------------------------------------------------
// Nightshade (Obsidian Blade, Poison)...  Called every frame while held
// (IOBLADE.Refresh, self is the character): the holder shrugs off poison,
// and poisoned enemies nearby are slowed...
int Nightshade(int self)
  int i, who
  float dx, dy
  if(self.pstimer > 0)
    self.pstimer = 0
  if((SystemGet(SYS_MAINGAMEFRAME, 0, 0) & 15) == 0)
    i = 0
    while(i < MAX_CHARACTER)
      who = FindByIndex(i)
      if(who)
        if(who.team != self.team && who.team != TEAM_NEUTRAL && who.hits > 0 && who.pstimer > 0)
          dx = who.x - self.x
          dy = who.y - self.y
          if((dx*dx + dy*dy) < 144.0)
            XITEM.Chill(who, 30)
      i++
  return TRUE

//-----------------------------------------------------------------------
// Called by PATTACK.Event just before a tempered sword's damage...  Can
// knock the target down, returns bonus damage + (bonus wounds<<4)...
int PreHit(int owner, int target)
  int self, ext, tier, element, bonus
  self = FindSelf()
  ext = self.red
  tier = SwordTier(ext)
  element = SwordElement(ext)
  bonus = 0
  if(tier == SWORD_TIER_GREAT)
    if(element == WEAPON_VARIANT_FIRE)
      // Cinder Cleaver...  Burning enemies take more...
      if(Burning(self.target))
        bonus = 2
    if(element == WEAPON_VARIANT_ICE)
      // Shatter...  Chilled enemies take a wound and go down...
      if(Chilled(target))
        bonus = 16
        target.combo = 4
        PSPARK.Effect(target.x, target.y, target.z+(target.height*0.5), 12, 4)
    if(element == WEAPON_VARIANT_POISON)
      // Plague Cleaver...  Poisoned enemies take a wound...
      if(target.pstimer > 0)
        bonus = 16
    if(element == WEAPON_VARIANT_HOLY)
      // Judgement...  Undead go down...
      if(Undead(target))
        target.combo = 4
  if(tier == SWORD_TIER_OBSIDIAN && element == WEAPON_VARIANT_ICE && self.green)
    // Black Ice...  Frozen stiff, down they go...
    target.combo = 4
  if(tier == SWORD_TIER_DRAGON && element == WEAPON_VARIANT_HOLY)
    // Dawnbringer...  Undead are blasted back...
    if(Undead(target))
      target.combo = 4
  return bonus

//-----------------------------------------------------------------------
// The attack particle (self) of a tempered sword hit an enemy...
int Hit(int owner, int target)
  int self, tier
  self = FindSelf()
  tier = SwordTier(self.red)
  if(tier == SWORD_TIER_GREAT)
    return GreatHit(owner, target)
  if(tier == SWORD_TIER_OBSIDIAN)
    return ObsidianHit(owner, target)
  if(tier == SWORD_TIER_DRAGON)
    return DragonHit(owner, target)
  if(self.green)
    return BasicHit(owner, target)
  return FALSE

//-----------------------------------------------------------------------
// Short Sword and Sword...  Only called when the swing's chance came up...
int BasicHit(int owner, int target)
  int self, ext, tier, element, i, who, found
  float x, y, z, fx, fy, dx, dy, sl


  self = FindSelf()
  ext = self.red
  tier = SwordTier(ext)
  element = SwordElement(ext)
  fx = owner.frontx
  fy = owner.fronty
  z = target.z + (target.height*0.5)


  if(element == WEAPON_VARIANT_MAGIC && self.blue == 0)
    self.blue = 1
    if(tier == SWORD_TIER_SHORT)
      // Spell Needle...  A bolt goes on through the target...
      sl = target.boxsize + 1.0
      PMISSILE.DirectedEffect(target.x + (fx*sl), target.y + (fy*sl), z, fx*0.3, fy*0.3, 0.0, self.owner, "FILE:SPARK5.RGB", "FILE:SPARK6.RGB")
    else
      // Spellblade...  A homing missile follows the swing...
      PMISSILE.DirectedEffect(owner.x + (fx*1.5), owner.y + (fy*1.5), owner.z + (owner.height*0.6), fx*0.25, fy*0.25, 0.05, self.owner, "FILE:SPARK5.RGB", "FILE:SPARK6.RGB")


  if(element == WEAPON_VARIANT_FIRE)
    // Brand / Ember Edge...  Burning (every enemy the swing hits)...
    PGSHOT.Burn(self.target, self.owner, 4)


  if(element == WEAPON_VARIANT_ICE)
    // Icicle / Frost Edge...
    XITEM.Chill(target, CHILL_TIME)
    PSMOKE.Effect(target.x, target.y, z, 0.0, 0.0, 0.03, 1.5, 0.05, FALSE, ICE_SMOKE_COLOR, 200, 25)


  if(element == WEAPON_VARIANT_VOLT && self.blue == 0)
    self.blue = 1
    PlaySound("FILE:-SHOCK.RAW", 245 + RollDice(1, 20), 255)
    if(tier == SWORD_TIER_SHORT)
      // Lightning Rod...  Runs on through the target...
      sl = target.boxsize + 0.5
      Zap(target.x + (fx*sl), target.y + (fy*sl), z, fx*1.2, fy*1.2, 20)
    else
      // Spark Blade...  Jumps to the nearest other enemy...
      found = 255
      sl = 12.0
      i = 0
      while(i < MAX_CHARACTER)
        who = FindByIndex(i)
        if(who && who != target)
          if(who.team != self.team && who.team != TEAM_NEUTRAL && who.hits > 0)
            dx = who.x - target.x
            dy = who.y - target.y
            x = sqrt(dx*dx + dy*dy)
            if(x < sl && x > 0.1)
              sl = x
              found = i
        i++
      who = NULL
      if(found < MAX_CHARACTER)
        who = FindByIndex(found)
      if(who)
        dx = (who.x - target.x)/sl
        dy = (who.y - target.y)/sl
        x = target.boxsize + 0.5
        Zap(target.x + (dx*x), target.y + (dy*x), z, dx*1.2, dy*1.2, 20)


  if(element == WEAPON_VARIANT_POISON)
    // Sting / Viper Edge...
    STANDARD.PoisonCharacter(self.target, self.owner, 300)


  if(element == WEAPON_VARIANT_HOLY && self.blue == 0)
    // Blessed Point / Blessed Blade...  Heals once per swing...
    self.blue = 1
    Mend(owner, "FILE:SPARK4.RGB")


  if(element == WEAPON_VARIANT_UNHOLY && self.blue == 0)
    // Leech Point / Leech Blade...  Drains once per swing...
    if(!(target.flags & CHAR_NO_BACKSTAB))
      self.blue = 1
      Mend(owner, "FILE:SPARK8.RGB")
  return TRUE

//-----------------------------------------------------------------------
// Great Sword...
int GreatHit(int owner, int target)
  int self, element, killed, count, i
  float x, y, z, fx, fy, angle


  self = FindSelf()
  element = SwordElement(self.red)
  fx = owner.frontx
  fy = owner.fronty
  x = target.x
  y = target.y
  z = target.z + (target.height*0.5)
  killed = FALSE
  if(target.hits == 0)
    killed = TRUE


  if(element == WEAPON_VARIANT_MAGIC && self.blue == 0)
    // Arc Cleaver...  Every swing that connects sends a crescent onward...
    self.blue = 1
    PlaySound("FILE:BAD3.RAW", 300 + RollDice(1, 40), 200)
    Bolt(self.owner, self.team, owner.x + (fx*2.0), owner.y + (fy*2.0), owner.z + (owner.height*0.5), fx*0.6, fy*0.6, DAMAGE_BASH, 2, 1, SPECIAL_FLAG_CHOP_THROUGH | SPECIAL_FLAG_INVERT_DEFWOUN, 20, "FILE:SPARK6.RGB")


  if(element == WEAPON_VARIANT_FIRE)
    // Cinder Cleaver...  Sets them burning, and burning foes burst when they die...
    if(killed)
      if(Burning(self.target))
        PEXPLODE.Effect(x, y, z, 0.0, 0.0, 0.0, DAMAGE_FIRE, 3, 1, self.owner, self.team, "FILE:FIRE1.RGB", 128, 48)
    else
      if(self.green)
        PGSHOT.Burn(self.target, self.owner, 4)


  if(element == WEAPON_VARIANT_ICE && self.green)
    // Shatter...  Chills (chilled enemies shatter, see PreHit)...
    XITEM.Chill(target, CHILL_TIME)
    PSMOKE.Effect(x, y, z, 0.0, 0.0, 0.03, 1.5, 0.05, FALSE, ICE_SMOKE_COLOR, 200, 25)


  if(element == WEAPON_VARIANT_VOLT && self.blue == 0)
    // Thunder Cleaver...  Static builds with every swing that connects...
    self.blue = 1
    count = FileReadByte(owner, SWORD_STATIC_OFFSET) + 1
    if(count >= 4)
      count = 0
      PlaySound("FILE:-SHOCK.RAW", 220 + RollDice(1, 20), 255)
      i = 0
      angle = RollDice(1, 45)
      while(i < 8)
        Zap(x + sin(angle)*(target.boxsize+0.5), y + sin(angle+90.0)*(target.boxsize+0.5), z, sin(angle)*1.0, sin(angle+90.0)*1.0, 16)
        angle = angle + 45.0
        i++
    else
      PSPARK.Effect(owner.x, owner.y, owner.z+(owner.height*0.6), 4, 4)
    FileWriteByte(owner, SWORD_STATIC_OFFSET, count)


  if(element == WEAPON_VARIANT_POISON)
    // Plague Cleaver...  Poisons, and poisoned foes leave a cloud when they die...
    if(killed)
      if(target.pstimer > 0)
        PPSNBALL.ShotEffect(x, y, z+0.5, 0.0, 0.0, -0.5, self.owner, 96)
    else
      if(self.green)
        STANDARD.PoisonCharacter(self.target, self.owner, 300)


  if(element == WEAPON_VARIANT_HOLY && self.green)
    // Judgement...  Summoned undead may be banished outright...
    if(Undead(target) && (target.eflags & ENCHANT_FLAG_SUMMON_3))
      PSPARK.Effect(x, y, z, 12, 4)
      PEMBER.Effect(x, y, z, 0.0, 0.0, 0.05, 3.0, 255, 12, "FILE:SPARK4.RGB")
      GoPoof(POOF_TARGET)


  if(element == WEAPON_VARIANT_UNHOLY && killed)
    // Reaper...  A kill mends a hard wound...
    if(!(target.flags & CHAR_NO_BACKSTAB))
      GENERIC.RestoreCharacterHits(owner, 1, 1)
      PEMBER.Effect(owner.x, owner.y, owner.z+1.0, 0.0, 0.0, 0.05, 2.5, 255, 16, "FILE:SPARK8.RGB")
  return TRUE

//-----------------------------------------------------------------------
// Obsidian Blade...
int ObsidianHit(int owner, int target)
  int self, element, i, child
  float x, y, z, fx, fy, sx, sy, a


  self = FindSelf()
  element = SwordElement(self.red)
  fx = owner.frontx
  fy = owner.fronty
  x = target.x
  y = target.y
  z = target.z + (target.height*0.5)


  if(element == WEAPON_VARIANT_MAGIC)
    // Spellbreaker...  Strips buffs, and sometimes raises a deflecting sphere...
    target.eflags = target.eflags & (255-STRIP_FLAGS)
    if(self.green && self.blue == 0)
      self.blue = 1
      if(!(owner.eflags & ENCHANT_FLAG_DEFLECT))
        owner.eflags = owner.eflags | ENCHANT_FLAG_DEFLECT
        child = PDFLECT.Effect(owner, TRUE)
        if(child)
          child.misc7 = 200  // Fragile...  Shatters after a few deflections...


  if(element == WEAPON_VARIANT_FIRE && self.green && self.blue == 0)
    // Flare...  A short burst of flame out of the swing...
    self.blue = 1
    sx = -fy
    sy = fx
    PlaySound("FILE:-SPELL03.RAW", 180 + RollDice(1, 20), 220)
    x = owner.x + (fx*1.5)
    y = owner.y + (fy*1.5)
    z = owner.z + (owner.height*0.5)
    i = 0
    while(i < 3)
      a = (i-1)*0.3
      Bolt(self.owner, self.team, x, y, z, (fx + (sx*a))*0.6, (fy + (sy*a))*0.6, DAMAGE_FIRE, 2, 0, SPECIAL_FLAG_CHOP_THROUGH, 12, "FILE:FIRE1.RGB")
      i++


  if(element == WEAPON_VARIANT_ICE && self.green)
    // Black Ice...  Frozen stiff (long chill, knocked down in PreHit)...
    XITEM.Chill(target, CHILL_TIME*3)
    FrostRing(x, y, z)


  if(element == WEAPON_VARIANT_VOLT && self.green && self.blue == 0)
    // Chain Edge...
    self.blue = 1
    Chain(target, 3)


  if(element == WEAPON_VARIANT_POISON && self.green)
    // Nightshade...  (Also see Nightshade(), for while it's held)...
    STANDARD.PoisonCharacter(self.target, self.owner, 300)


  if(element == WEAPON_VARIANT_HOLY && self.green && self.blue == 0)
    // Aegis...  A moment where nothing can touch the holder...
    self.blue = 1
    if(owner.intimer < 45)
      owner.intimer = 45
    PFLASH.Effect(owner, "FILE:LITESPRK.RGB", WHITE, TRUE, 1.5)


  if(element == WEAPON_VARIANT_UNHOLY && self.blue < 3)
    // Hungering Edge...  Drains every enemy hit, up to three a swing...
    if(!(target.flags & CHAR_NO_BACKSTAB))
      self.blue = self.blue + 1
      Mend(owner, "FILE:SPARK8.RGB")
  return TRUE

//-----------------------------------------------------------------------
// Dragon Sword...
int DragonHit(int owner, int target)
  int self, element, i, killed, was_cold, souls
  float x, y, z, fx, fy, sx, sy, a


  self = FindSelf()
  element = SwordElement(self.red)
  fx = owner.frontx
  fy = owner.fronty
  x = target.x
  y = target.y
  z = target.z + (target.height*0.5)
  killed = FALSE
  if(target.hits == 0)
    killed = TRUE


  if(element == WEAPON_VARIANT_MAGIC && self.green && self.blue == 0)
    // Arcane Wrath...  Three homing missiles...
    self.blue = 1
    sx = -fy
    sy = fx
    PlaySound("FILE:BAD3.RAW", 300 + RollDice(1, 40), 200)
    i = 0
    while(i < 3)
      a = (i-1)*0.5
      PMISSILE.DirectedEffect(owner.x + (fx*1.5), owner.y + (fy*1.5), owner.z + (owner.height*0.6), (fx + (sx*a))*0.3, (fy + (sy*a))*0.3, 0.05, self.owner, "FILE:SPARK5.RGB", "FILE:SPARK6.RGB")
      i++


  if(element == WEAPON_VARIANT_FIRE && killed)
    // Wyrmfang...  A kill spreads the fire to everyone nearby (breath: see Breath())...
    PEXPLODE.Effect(x, y, z, 0.0, 0.0, 0.0, DAMAGE_FIRE, 0, 0, self.owner, self.team, "FILE:FIRE1.RGB", 128, 48)
    Area(x, y, 6.0, 2, self.target)


  if(element == WEAPON_VARIANT_ICE)
    // Winter's Edge...  Every hit chills, a chilled foe's death sets off a frost nova...
    was_cold = Chilled(target)
    XITEM.Chill(target, CHILL_TIME)
    if(killed && was_cold)
      FrostRing(x, y, z)
      PEMBER.Effect(x, y, z, 0.0, 0.0, 0.0, 8.0, 255, 10, "FILE:ICE1.RGB")
      Area(x, y, 8.0, 1, self.target)


  if(element == WEAPON_VARIANT_VOLT && self.green && self.blue == 0)
    // Stormbringer...  A blocked hit charged the blade...
    self.blue = 1
    FileWriteByte(owner, SWORD_STORM_OFFSET, 0)
    Chain(target, 3)
    PSPARK.Effect(x, y, z, 12, 4)


  if(element == WEAPON_VARIANT_POISON && self.green && self.blue == 0)
    // Miasma...  A big poison cloud...
    self.blue = 1
    i = 0
    a = RollDice(1, 120)
    while(i < 3)
      PPSNBALL.ShotEffect(x + sin(a)*2.5, y + sin(a+90.0)*2.5, z + 1.0, 0.0, 0.0, -0.5, self.owner, 160)
      a = a + 120.0
      i++


  if(element == WEAPON_VARIANT_HOLY)
    // Dawnbringer...  Undead are blasted back, kills heal everyone nearby...
    if(Undead(target))
      target.vx = fx*0.8
      target.vy = fy*0.8
      target.vz = 0.4
      PEMBER.Effect(x, y, z, 0.0, 0.0, 0.05, 3.0, 255, 12, "FILE:SPARK4.RGB")
    if(killed)
      PlaySound("FILE:-SPELL01.RAW", 280 + RollDice(1, 20), 255)
      Area(owner.x, owner.y, 10.0, 3, 65535)


  if(element == WEAPON_VARIANT_UNHOLY)
    // Soulrender...  Kills store souls, five of them make the next hit burst...
    if(self.green && self.blue == 0)
      self.blue = 1
      FileWriteByte(owner, SWORD_SOULS_OFFSET, 0)
      PEXPLODE.Effect(x, y, z, 0.0, 0.0, 2.3, DAMAGE_BASH, 5, 2, self.owner, self.team, "FILE:SPARK8.RGB", UNHOLY_COLOR, 160)
      GENERIC.RestoreCharacterHits(owner, 3, 0)
    if(killed && !(target.flags & CHAR_NO_BACKSTAB))
      souls = FileReadByte(owner, SWORD_SOULS_OFFSET)
      if(souls < 5)
        FileWriteByte(owner, SWORD_SOULS_OFFSET, souls+1)
        PEMBER.Effect(x, y, z, (owner.x-x)*0.05, (owner.y-y)*0.05, 0.05, 2.0, 255, 20, "FILE:SPARK8.RGB")
  return TRUE

//-----------------------------------------------------------------------
// NOTE: Files must end with a function-level line (see XITEM.SRC)...
int Unused()
  return FALSE

//-----------------------------------------------------------------------
