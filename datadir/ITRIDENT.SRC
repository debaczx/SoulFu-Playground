// Trident (KIND_TRIDENT, Dagger block)...  Three prongs cover a wider spot than the Spear.  One hand thrusts, both hands (other hand empty) sweep.
#define DAMAGE_TYPE DAMAGE_EDGE
#define DAMAGE_LOW  1
#define DAMAGE_HIGH 3
#define WOUND_LOW   1
#define WOUND_HIGH  1
#define TWO_HAND_BONUS 0  // Extra damage with both hands on the pole

//-----------------------------------------------------------------------
int GetName()
  STANDARD.ItemName("TRIDENT", NULL, DAMAGE_TYPE, DAMAGE_LOW, DAMAGE_HIGH, WOUND_LOW, WOUND_HIGH)

//-----------------------------------------------------------------------
// TRUE while the other hand is empty, so both hands are on the pole...
int TwoHanded()
  int self, other
  self = FindSelf()
  other = self.eqleft
  if(SystemGet(SYS_WEAPONGRIP, 0, 0) == MODEL_LEFT_FILE)
    other = self.eqright
  return (other == ITEM_NONE)

//-----------------------------------------------------------------------
// Called when attack particle is supposed to be spawned
int FrameEvent()
  int grip, damage, wound, self
  grip = SystemGet(SYS_WEAPONGRIP, 0, 0)
  damage = RollDice(1, DAMAGE_HIGH-DAMAGE_LOW+1)+DAMAGE_LOW-1
  wound = RollDice(1, WOUND_HIGH-WOUND_LOW+1)+WOUND_LOW-1
  self = FindSelf()
  if(TwoHanded())
    PATTACK.FrameEvent(DAMAGE_TYPE, damage+TWO_HAND_BONUS, wound, grip, 110, WEAPON_RADIUS_LARGE, 0, SystemGet(SYS_ITEMINDEX, 0, 0)&7)
  else
    PATTACK.FrameEvent(DAMAGE_TYPE, damage, wound, grip, 120, WEAPON_RADIUS_LARGE, 0, SystemGet(SYS_ITEMINDEX, 0, 0)&7)
  PlaySound("FILE:SWIPE.RAW", 200 + RollDice(1, 50), 255)

//-----------------------------------------------------------------------
// Called when item is first used, to start proper animation...  One hand thrusts, two hands sweep.
int Event()
  if(TwoHanded())
    STANDARD.WeaponAttackStart(WEAPON_RELOAD_SHORT, WEAPON_ATTACK_SLASH)
  else
    STANDARD.WeaponAttackStart(WEAPON_RELOAD_SHORT, WEAPON_ATTACK_THRUST)

//-----------------------------------------------------------------------
// Called to put item in character's hand
int ModelSetup()
  int self, grip

  grip = SystemGet(SYS_WEAPONGRIP, 0, 0)
  if(grip == MODEL_LEFT_FILE || grip == MODEL_RIGHT_FILE)
    self = FindSelf()

    ModelAssign(self+grip, "FILE:TRIDENT2.RDY")
    ModelAssign(self+grip+4, "FILE:STEEL.RGB")
    ModelAssign(self+grip+8, "FILE:=SPEAR.RGB")
    XITEM.WeaponModelSetup(self, grip)  // Artifact texture, if any...
    ModelAssign(self+grip+12, "FILE:LITESWIP.RGB")
    ModelAssign(self+grip+16, "FILE:GOLD.RGB")
    ModelAssign(self+grip+20, WHITE)

//-----------------------------------------------------------------------
// Called when we're allowed to spawn a particle for the
// item's enchantment effect.  Must manually check if item
// is enchanted or not...
int Refresh()
  STANDARD.WeaponRefresh(50, 1.0)

//-----------------------------------------------------------------------
