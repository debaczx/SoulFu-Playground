// Spear (item 135)...  Hits like a Dagger (quick thrust, low damage) but reaches
// further than any other weapon.  Item 135 is a single item number, not a block of
// 8 like the other weapons, so it has no built-in elemental variants and can't be
// enchanted (PATTACK.FrameEvent treats it as plain).
#define DAMAGE_TYPE DAMAGE_EDGE
#define DAMAGE_LOW  0
#define DAMAGE_HIGH 2
#define WOUND_LOW   1
#define WOUND_HIGH  1
#define SPEAR_RANGE 127   // Hits at the spearhead...  WEAPON_RANGE_EXTRA_LONG is 115, the Dagger's is 80

//-----------------------------------------------------------------------
int GetName()
  STANDARD.ItemName("SPEAR", NULL, DAMAGE_TYPE, DAMAGE_LOW, DAMAGE_HIGH, WOUND_LOW, WOUND_HIGH)

//-----------------------------------------------------------------------
// Called when attack particle is supposed to be spawned
int FrameEvent()
  int grip, damage, wound

  grip = SystemGet(SYS_WEAPONGRIP, 0, 0)
  damage = RollDice(1, DAMAGE_HIGH-DAMAGE_LOW+1)+DAMAGE_LOW-1
  wound = RollDice(1, WOUND_HIGH-WOUND_LOW+1)+WOUND_LOW-1
  PATTACK.FrameEvent(DAMAGE_TYPE, damage, wound, grip, SPEAR_RANGE, WEAPON_RADIUS_MEDIUM, 0, 0)
  PlaySound("FILE:SWIPE.RAW", 200 + RollDice(1, 50), 255)


//-----------------------------------------------------------------------
// Called when item is first used, to start proper animation
int Event()
  STANDARD.WeaponAttackStart(WEAPON_RELOAD_SHORT, WEAPON_ATTACK_THRUST)

//-----------------------------------------------------------------------
// Called to put item in character's hand
int ModelSetup()
  int self, grip

  grip = SystemGet(SYS_WEAPONGRIP, 0, 0)
  if(grip == MODEL_LEFT_FILE || grip == MODEL_RIGHT_FILE)
    self = FindSelf()

    ModelAssign(self+grip, "FILE:SPEAR.RDY")
    ModelAssign(self+grip+4, "FILE:STEEL.RGB")
    ModelAssign(self+grip+8, "FILE:=SPEAR.RGB")
    XITEM.WeaponModelSetup(self, grip)  // Artifact texture, if any...
    ModelAssign(self+grip+12, "FILE:LITESWIP.RGB")
    ModelAssign(self+grip+16, "FILE:STEEL.RGB")
    ModelAssign(self+grip+20, WHITE)

//-----------------------------------------------------------------------
