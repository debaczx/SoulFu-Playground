#define DAMAGE_TYPE DAMAGE_EDGE
#define DAMAGE_LOW  1
#define DAMAGE_HIGH 6
#define WOUND_LOW   1
#define WOUND_HIGH  1

//-----------------------------------------------------------------------
int GetName()
  int ext
  ext = SystemGet(SYS_ITEMEXT, 0, 0)
  if(SWORDFX.IsSword(ext))
    // Tempered by the Soldier...
    STANDARD.ItemName(SWORDFX.Name(ext), NULL, DAMAGE_TYPE, DAMAGE_LOW, DAMAGE_HIGH, WOUND_LOW, WOUND_HIGH)
    return TRUE
  STANDARD.ItemName("OBSIDIAN BLADE", NULL, DAMAGE_TYPE, DAMAGE_LOW, DAMAGE_HIGH, WOUND_LOW, WOUND_HIGH)

//-----------------------------------------------------------------------
// Called when attack particle is supposed to be spawned
int FrameEvent()
  int grip, damage, wound, self

  self = FindSelf()
  grip = SystemGet(SYS_WEAPONGRIP, 0, 0)
  damage = RollDice(1, DAMAGE_HIGH-DAMAGE_LOW+1)+DAMAGE_LOW-1
  wound = RollDice(1, WOUND_HIGH-WOUND_LOW+1)+WOUND_LOW-1
  PATTACK.FrameEvent(DAMAGE_TYPE, damage, wound, grip, WEAPON_RANGE_MEDIUM, WEAPON_RADIUS_LARGE, SPECIAL_FLAG_CHOP_THROUGH, SystemGet(SYS_ITEMINDEX, 0, 0)&7)
  PlaySound("FILE:SWIPE.RAW", 225 + RollDice(1, 50), 255)

//-----------------------------------------------------------------------
// Called when item is first used, to start proper animation
int Event()
  STANDARD.WeaponAttackStart(WEAPON_RELOAD_MEDIUM, WEAPON_ATTACK_SLASH)

//-----------------------------------------------------------------------
// Called to put item in character's hand
int ModelSetup()
  int self, grip

  grip = SystemGet(SYS_WEAPONGRIP, 0, 0)
  if(grip == MODEL_LEFT_FILE || grip == MODEL_RIGHT_FILE)
    self = FindSelf()

    ModelAssign(self+grip, "FILE:OBLADE.RDY")
    ModelAssign(self+grip+4, "FILE:DSTEEL.RGB")
    ModelAssign(self+grip+8, "FILE:=OBLADE.RGB")
    XITEM.WeaponModelSetup(self, grip)  // Artifact texture, if any...
    ModelAssign(self+grip+12, "FILE:LITESWIP.RGB")
    ModelAssign(self+grip+16, "FILE:=OBLADE.RGB")
    ModelAssign(self+grip+20, WHITE)

//-----------------------------------------------------------------------
// Called when we're allowed to spawn a particle for the
// item's enchantment effect.  Must manually check if item
// is enchanted or not...
int Refresh()
  int ext
  STANDARD.WeaponRefresh(100, 1.0)
  // Nightshade keeps its holder free of poison and slows poisoned foes...
  ext = SystemGet(SYS_ITEMEXT, 0, 0)
  if(SWORDFX.IsSword(ext))
    if(SWORDFX.SwordTier(ext) == SWORD_TIER_OBSIDIAN && SWORDFX.SwordElement(ext) == WEAPON_VARIANT_POISON)
      SWORDFX.Nightshade(FindSelf())
  return TRUE

//-----------------------------------------------------------------------

