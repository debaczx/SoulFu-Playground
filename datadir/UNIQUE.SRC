//-----------------------------------------------------------------------
// Called by STANDARD.ItemName for any item with an extension, before the
// name is written...  Uniques' names start with ^ (drawn in gold)...
int NameStart()
  if(CurrentId())
    StringAppend(NAME_STRING, "^", 256)
  return TRUE

//-----------------------------------------------------------------------
// Called by STANDARD.ItemName after the name is written...
int NameEnd()
  int uq
  uq = CurrentId()
  if(uq)
    StringAppend(NAME_STRING, " - ", 256)
    StringAppend(NAME_STRING, Info(uq), 256)
  return TRUE


//-----------------------------------------------------------------------
// Drops...
//-----------------------------------------------------------------------
// Maybe turns a chest roll into its unique...  key is item | (raw_ext<<8),
// as RANDOM.ChestLoot makes it...  The drop is only counted when the chest
// actually gives it (Found)...
int MaybeUnique(int key)
  int item, uq
  item = key & 255
  uq = IdFor(item, XITEM.KindOf(key >> 8))
  if(uq == 0)
    return key
  if(SystemGet(SYS_UNIQUEFOUND, uq, 0) >= UNIQUE_MAX_DROPS)
    return key
  if(RollDice(1, 100) > UNIQUE_CHANCE)
    return key
  // Uniques are always the plain item...
  if(item >= ITEM_DAGGER)
    item = item & 248
  else
    item = item & 252
  return (item | (XITEM.KindExt(XITEM.KindOf(key >> 8), XITEM_UNIQUE) << 8))

//-----------------------------------------------------------------------
// A chest gave this item...  Counts it if it's a unique...
int Found(int key)
  int uq
  uq = Id(key & 255, key >> 8)
  if(uq)
    SystemSet(SYS_UNIQUEFOUND, uq, 0, SystemGet(SYS_UNIQUEFOUND, uq, 0) + 1)
  return uq


//-----------------------------------------------------------------------
// Item hooks...
//-----------------------------------------------------------------------
// Weapon element for this swing (PATTACK.FrameEvent)...  e is the item's
// own enchant variant...
int SwingElement(int e)
  int uq
  uq = CurrentId()
  if(uq == UQ_NIGHTS_EDGE)
    return WEAPON_VARIANT_UNHOLY
  if(uq == UQ_TRICKSTERS_KRIS)
    return RollDice(1, 7)
  if(uq == UQ_DAWNBREAKER || uq == UQ_OATHKEEPER)
    return WEAPON_VARIANT_HOLY
  if(uq == UQ_WYRMHEART)
    return WEAPON_VARIANT_FIRE
  if(uq == UQ_WYVERN_LANCE)
    return WEAPON_VARIANT_VOLT
  if(uq == UQ_TIDE_CALLER)
    return WEAPON_VARIANT_ICE
  return e

//-----------------------------------------------------------------------
// Weapon element shown in the name (STANDARD.ItemName)...
int ShownElement(int e)
  int uq
  uq = CurrentId()
  if(uq == UQ_NIGHTS_EDGE)
    return WEAPON_VARIANT_UNHOLY
  if(uq == UQ_DAWNBREAKER || uq == UQ_OATHKEEPER)
    return WEAPON_VARIANT_HOLY
  if(uq == UQ_WYRMHEART)
    return WEAPON_VARIANT_FIRE
  if(uq == UQ_WYVERN_LANCE)
    return WEAPON_VARIANT_VOLT
  if(uq == UQ_TIDE_CALLER)
    return WEAPON_VARIANT_ICE
  return e

//-----------------------------------------------------------------------
// Extra damage per hit (XITEM.ArtifactDamage)...
int Damage()
  int uq
  uq = CurrentId()
  if(uq == UQ_RAT_KINGS_TOOTH)
    return -2
  if(uq == UQ_MERCY)
    return -1
  return 0

//-----------------------------------------------------------------------
// Damage of a swing that depends on the holder (PATTACK.FrameEvent)...
int SwingDamage(int self, int damage)
  if(CurrentId() == UQ_BERSERKERS_EDGE)
    // Berserker's Edge: +1 for every 10% of max hits lost...
    if(self.hitsmax > 0 && self.hits < self.hitsmax)
      damage = damage + (((self.hitsmax - self.hits) * 10) / self.hitsmax)
  return damage

//-----------------------------------------------------------------------
// Defense changes, while STANDARD.DefenseRating adds up the worn items...
int Defense(int self)
  if(Worn(self, UQ_NIGHTS_EDGE))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_WOUND, -1)
  if(Worn(self, UQ_SHROUD_OF_THE_LICH))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_WOUND, -2)
  if(Worn(self, UQ_MEDUSAS_MIRROR))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_FIRE, -2)
  if(Worn(self, UQ_WRATH_OF_AGES))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_VOLT, -2)
  if(Worn(self, UQ_COAT_OF_RINGS))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_ACID, 1)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_FIRE, 1)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_ICE, 1)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_VOLT, 1)
  if(Worn(self, UQ_BULWARK_VISOR))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_EDGE, 2)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_BASH, 2)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_ACID, 2)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_FIRE, 2)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_ICE, 2)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_VOLT, 2)
  if(Worn(self, UQ_DUELISTS_GRACE))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_EDGE, -2)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_BASH, -2)
  if(Worn(self, UQ_CHAIN_OF_PENANCE))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_EDGE, -1)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_BASH, -1)
  if(Worn(self, UQ_WYRMHEART))
    // Any fire defense keeps burns off (PBURNING.Effect)...
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_FIRE, 4)
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_ICE, -2)
  if(Worn(self, UQ_MUDWALKER))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_ACID, 1)
  if(Worn(self, UQ_MANTLE_OF_KNIVES))
    SystemSet(SYS_DEFENSERATING, 0, DAMAGE_EDGE, -2)
  if(Worn(self, UQ_PHALANX))
    if(FileReadByte(self, UNIQUE_STILL_OFFSET))
      SystemSet(SYS_DEFENSERATING, 0, DAMAGE_EDGE, PHALANX_DEF)
      SystemSet(SYS_DEFENSERATING, 0, DAMAGE_BASH, PHALANX_DEF)
  return TRUE

//-----------------------------------------------------------------------
// Gatekeeper: can't be knocked down (STANDARD.DamageAction)...
int Unshaken(int who)
  return Worn(who, UQ_GATEKEEPER)

//-----------------------------------------------------------------------
// Mudwalker: can't be poisoned (STANDARD.PoisonCharacter)...
int NoPoison(int who)
  return Worn(who, UQ_MUDWALKER)

//-----------------------------------------------------------------------
// Silent Step: big backstabs do double (PATTACK.SRC)...
int Backstab(int who)
  return Worn(who, UQ_SILENT_STEP)

//-----------------------------------------------------------------------
// Ironbrow: can't be stunned, knocked down or petrified (STANDARD.SRC)...
int Steadfast(int who)
  return Worn(who, UQ_IRONBROW)

//-----------------------------------------------------------------------
// Price of buying from a shop (Stride of Kings takes 20% off)...
int ShopPrice(int who, int price)
  if(price > 0)
    if(Worn(who, UQ_STRIDE_OF_KINGS))
      price = (price * 4) / 5
  return price

//-----------------------------------------------------------------------
// Hare's Breeches: the wearer can't be chilled (XITEM.Chill)...
int NoChill(int who)
  return Worn(who, UQ_HARES_BREECHES)

//-----------------------------------------------------------------------
// Berserker's Edge: healing potions do nothing (IHEAL, ISHEAL)...
int NoPotions(int who)
  if(Worn(who, UQ_BERSERKERS_EDGE))
    PlaySound("FILE:-SPELL00.RAW", 128, 160)
    PFLASH.Effect(who, "FILE:LITESPRK.RGB", 16711680, TRUE, 0.8)
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// TRUE in a boss room (Kingslayer, Executioner)...
int BossRoom()
  int room
  room = SystemGet(SYS_MAPROOM, 0, MAP_ROOM_CURRENT)
  if(SystemGet(SYS_MAPROOM, room, MAP_ROOM_FLAGS) & MAP_ROOM_FLAG_BOSS)
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// Mana a spell costs (Hood of Whispers takes 1 off, never below 1)...
int SpellCost(int self, int cost)
  if(cost > 1)
    if(Worn(self, UQ_HOOD_OF_WHISPERS))
      return (cost - 1)
  return cost


//-----------------------------------------------------------------------
// Combat hooks (PATTACK.SRC and CPLAYER.Event)...
//-----------------------------------------------------------------------
// Resistance of a character to a damage type (negative is a weakness)...
int Resist(int who, int type)
  int value
  value = FileReadByte(who, 97 + type)
  if(value > 127)
    value = value - 256
  return value

//-----------------------------------------------------------------------
// Damages a character by amount after its defense (so 1 always hurts)...
int Hurt(int who, int type, int amount, int attacker)
  int res
  if(!who || amount < 1)
    return FALSE
  res = Resist(who, type)
  if(res > 0)
    amount = amount + res
  if(amount > 255)
    amount = 255
  SystemSet(SYS_DAMAGECHARACTER, FindIndex(who), (type<<16) | (amount<<8), FindIndex(attacker))
  return TRUE

//-----------------------------------------------------------------------
// A melee swing from hand xhand (1 left, 2 right) is about to hurt a foe...
// Returns the damage it does (before defense)...
int PreHit(int owner, int target, int xhand, int amount)
  int uq
  if(xhand != 1 && xhand != 2)
    return amount
  // Sparrow's Wing: the first hit after a block hits harder...
  if(FileReadByte(owner, UNIQUE_COUNTER_OFFSET))
    FileWriteByte(owner, UNIQUE_COUNTER_OFFSET, 0)
    uq = IdIn(owner, 242)
    if(uq == UQ_SPARROWS_WING)
      amount = amount + COUNTER_BONUS
      PSPARK.Effect(target.x, target.y, target.z + (target.height*0.6), 6, 1)
    if(Worn(owner, UQ_RIPOSTE))
      amount = amount * 2
      PFLASH.Effect(target, "FILE:LITESPRK.RGB", UNIQUE_GOLD, TRUE, 1.0)
  // Warlord's Crest: harder hits near whoever wears it...
  if(CrestNear(owner))
    amount = amount + 2
  // Crest of Valour: harder hits in boss rooms...
  if(IdIn(owner, 246) == UQ_CREST_OF_VALOUR)
    if(BossRoom())
      amount = amount + 2
  uq = HandId(owner, xhand)
  if(uq == UQ_GREMF_CLEAVER)
    if(target.boxsize <= SMALL_SIZE)
      return (amount + (amount >> 1))
    if(target.boxsize >= LARGE_SIZE && amount > 1)
      amount = (amount * 3) / 4
    return amount
  if(uq == UQ_DUELISTS_GRACE)
    // Every third hit strikes twice...
    if(Count(owner, 3) == 0)
      PSPARK.Effect(target.x, target.y, target.z + (target.height*0.6), 6, 1)
      return (amount * 2)
    return amount
  if(uq == UQ_CHAIN_OF_PENANCE)
    // Each hit in a row adds 1 (getting hit starts it over, see Damaged)...
    amount = amount + FileReadByte(owner, UNIQUE_COUNT_OFFSET)
    if(FileReadByte(owner, UNIQUE_COUNT_OFFSET) < PENANCE_MAX)
      FileWriteByte(owner, UNIQUE_COUNT_OFFSET, FileReadByte(owner, UNIQUE_COUNT_OFFSET) + 1)
    return amount
  if(uq == UQ_EARTHSHAKER)
    if(Count(owner, QUAKE_HITS) == 0)
      Quake(owner, target)
    return amount
  if(uq == UQ_BASTION_BREAKER)
    // Half the foe's edge defense doesn't count...
    if(target.defedge > 0 && target.defedge < 128)
      amount = amount + (target.defedge >> 1)
    return amount
  if(uq == UQ_WYVERN_LANCE)
    if(!(owner.flags & CHAR_ON_GROUND))
      return (amount * 2)
    return amount
  if(uq == UQ_KINGSLAYER)
    if(BossRoom())
      return (amount * 2)
    if(amount > 1)
      amount = (amount * 3) / 4
    return amount
  if(uq == UQ_EXECUTIONER)
    // Finishes off foes below a quarter of their hits (not in boss rooms)...
    if(target.hits > 0 && target.hits * 4 <= target.hitsmax)
      if(!BossRoom())
        amount = amount + target.hits + 20
        if(amount > 250)
          amount = 250
        PFLASH.Effect(target, "FILE:LITESPRK.RGB", 16711680, TRUE, 1.0)
    return amount
  if(uq == UQ_DAWNBREAKER)
    // Undead go down...
    if(SWORDFX.Undead(target))
      if(RollDice(1, 100) <= DAWN_CHANCE)
        target.combo = 4
        PFLASH.Effect(target, "FILE:LITESPRK.RGB", 16777088, TRUE, 1.0)
    return amount
  return amount

//-----------------------------------------------------------------------
// Unique number of the weapon that swung from hand xhand (1 left, 2 right)...
// A polearm held in both hands (other hand empty) can swing from either...
int HandId(int owner, int xhand)
  int slot
  slot = 241 + xhand
  if(FileReadByte(owner, slot) == ITEM_NONE)
    slot = 244 - xhand
    if(!XITEM.IsPole(owner, slot))
      return 0
  return IdIn(owner, slot)

//-----------------------------------------------------------------------
// Warlord's Crest: TRUE if the owner or an ally close by wears it...
int CrestNear(int owner)
  int i, who
  float dx, dy
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(who)
      if(who.team == owner.team && who.hits > 0)
        if(Worn(who, UQ_WARLORDS_CREST))
          dx = who.x - owner.x
          dy = who.y - owner.y
          if(dx*dx + dy*dy < CREST_RANGE*CREST_RANGE)
            return TRUE
    i++
  return FALSE

//-----------------------------------------------------------------------
// Counts a hit (UNIQUE_COUNT_OFFSET) from 0 to every-1 and around...
// Returns the new count (0 every every'th hit)...
int Count(int owner, int every)
  int n
  n = FileReadByte(owner, UNIQUE_COUNT_OFFSET) + 1
  if(n >= every)
    n = 0
  FileWriteByte(owner, UNIQUE_COUNT_OFFSET, n)
  return n

//-----------------------------------------------------------------------
// Earthshaker: a shockwave hurts and knocks down other foes near the target...
int Quake(int owner, int target)
  int i, who
  float dx, dy
  PlaySound("FILE:BAD5.RAW", 120, 255)
  PSPARK.Effect(target.x, target.y, target.z, 16, 1)
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(DWARFFX.Foe(owner, who) && who != target)
      dx = who.x - target.x
      dy = who.y - target.y
      if(dx*dx + dy*dy < QUAKE_RANGE*QUAKE_RANGE)
        Hurt(who, DAMAGE_BASH, QUAKE_DAMAGE, owner)
        DWARFFX.KnockDown(who, target.x, target.y)
    i++
  return TRUE

//-----------------------------------------------------------------------
// Wyrmheart: foes near one that dies catch fire...
int Burst(int owner, int target)
  int i, who
  float dx, dy
  PFLASH.Effect(target, "FILE:LITESPRK.RGB", 16744448, TRUE, 1.5)
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(DWARFFX.Foe(owner, who))
      dx = who.x - target.x
      dy = who.y - target.y
      if(dx*dx + dy*dy < BURST_RANGE*BURST_RANGE)
        PBURNING.Effect(who, 4, FindIndex(owner))
    i++
  return TRUE

//-----------------------------------------------------------------------
// A melee swing from a weapon in hand xhand (1 left, 2 right) hit a foe...
// dealt is the hits the foe lost, killed is TRUE if that knocked it out...
int Hit(int owner, int target, int xhand, int dealt, int killed)
  int uq
  if(xhand != 1 && xhand != 2)
    return FALSE
  uq = HandId(owner, xhand)
  if(uq == UQ_NIGHTS_EDGE && killed)
    GENERIC.RestoreCharacterHits(owner, 3, 0)
    PFLASH.Effect(owner, "FILE:LITESPRK.RGB", 8388736, TRUE, 1.0)
    return TRUE
  if(uq == UQ_RAT_KINGS_TOOTH)
    if(RollDice(1, 100) <= RAT_CHANCE)
      Summon(owner, "FILE:CRAT.RUN", 1, RAT_SECONDS)  // A big rat...
    return TRUE
  if(uq == UQ_TITANS_GAVEL)
    if(!killed && target.hits > 0)
      if(RollDice(1, 100) <= GAVEL_CHANCE)
        STANDARD.PetrifyCharacter(FindIndex(target), FindIndex(owner), GAVEL_FRAMES)
    return TRUE
  if(uq == UQ_MERCY)
    MercyHeal(owner)
    return TRUE
  if(uq == UQ_CORSAIRS_FANG)
    PCOIN.Effect(COIN_DROP, target.x, target.y, target.z + (target.height*0.5))
    PlaySound("FILE:-CASH.RAW", 256, 160)
    return TRUE
  if(uq == UQ_OATHKEEPER)
    if(killed)
      ExperienceFunction(FindIndex(owner), EXPERIENCE_VIRTUE_HONOR, 1, FALSE)
    return TRUE
  if(uq == UQ_WYRMHEART)
    if(killed)
      Burst(owner, target)
    return TRUE
  if(uq == UQ_HIGHLAND_WIND)
    if(!killed && target.hits > 0)
      if(RollDice(1, 100) <= WIND_CHANCE)
        DWARFFX.KnockDown(target, owner.x, owner.y)
    return TRUE
  if(uq == UQ_TIDE_CALLER)
    if(!killed)
      XITEM.Chill(target, CHILL_TIME)
    return TRUE
  if(uq == UQ_TINKERS_MALLET)
    if(RollDice(1, 100) <= REFILL_CHANCE)
      Refill(owner)
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// Tinker's Mallet: puts an arrow back in the first quiver that isn't full...
int Refill(int owner)
  int i, item
  i = 224
  while(i < 246)
    if(i != 240 && i != 241)
      item = FileReadByte(owner, i)
      if(item > ITEM_QUIVER_10 && item <= ITEM_QUIVER_1)
        FileWriteByte(owner, i, item - 1)
        PlaySound("FILE:-BOW00.RAW", 300, 128)
        return TRUE
    i++
  return FALSE

//-----------------------------------------------------------------------
// Unique bows and crossbows: an arrow (child) was just loosed from hand xhand...
// Called by each launcher's FrameEvent...
int Shot(int self, int child, int xhand)
  int uq, extra, secs
  float sx, sy
  if(!child)
    return FALSE
  uq = IdIn(self, 241 + xhand)
  if(uq == 0)
    return FALSE
  child.number = ARROW_UNIQUE
  if(uq == UQ_WHISPERWIND)
    child.vx = child.vx * WIND_SPEED
    child.vy = child.vy * WIND_SPEED
    child.vz = child.vz * WIND_SPEED
  if(uq == UQ_HUNTERS_MOON)
    // Two more arrows, one to each side (free)...
    sx = -child.vy * MOON_SPREAD
    sy = child.vx * MOON_SPREAD
    SetSpawnTarget(FindIndex(self))
    extra = PARROW.FullEffect(child.misc7 & 7, child.x, child.y, child.z, child.vx + sx, child.vy + sy, child.vz, self.team, FindIndex(self))
    if(extra)
      extra.misc7 = child.misc7
      extra.xhand = child.xhand
    extra = PARROW.FullEffect(child.misc7 & 7, child.x, child.y, child.z, child.vx - sx, child.vy - sy, child.vz, self.team, FindIndex(self))
    if(extra)
      extra.misc7 = child.misc7
      extra.xhand = child.xhand
  if(uq == UQ_STORMSTRING)
    secs = (FileReadByte(self, UNIQUE_SHOTS_OFFSET) + 1) % STORM_SHOTS
    FileWriteByte(self, UNIQUE_SHOTS_OFFSET, secs)
    if(secs == 0)
      DWARFFX.Chain(self, 3)
  if(uq == UQ_SNIPERS_PATIENCE)
    if(FileReadByte(self, UNIQUE_STILL_OFFSET) >= SNIPE_SECONDS)
      child.number = ARROW_UNIQUE | ARROW_SNIPE
      PFLASH.Effect(self, "FILE:LITESPRK.RGB", UNIQUE_GOLD, TRUE, 0.8)
    FileWriteByte(self, UNIQUE_STILL_OFFSET, 0)
  if(uq == UQ_HORNET_NEST)
    // Each bolt costs one more...
    UseArrow(self)
  return TRUE

//-----------------------------------------------------------------------
// Takes one arrow out of the first quiver...
int UseArrow(int self)
  int i, item
  i = 224
  while(i < 246)
    if(i != 240 && i != 241)
      item = FileReadByte(self, i)
      if(item >= ITEM_QUIVER_10 && item <= ITEM_QUIVER_1)
        if(item == ITEM_QUIVER_1)
          item = ITEM_NONE
        else
          item++
        FileWriteByte(self, i, item)
        return TRUE
    i++
  return FALSE

//-----------------------------------------------------------------------
// An arrow from a unique launcher is about to hurt a foe (PARROW.SRC)...
// self is the arrow...  Returns the damage it does...
int ArrowHit(int owner, int target, int damage)
  int self, uq
  self = FindSelf()
  if(!(self.number & ARROW_UNIQUE) || !owner)
    return damage
  if(self.xhand != 1 && self.xhand != 2)
    return damage
  if(target.team == owner.team)
    return damage
  uq = IdIn(owner, 241 + self.xhand)
  if(self.number & ARROW_SNIPE)
    damage = damage * 3
    PFLASH.Effect(target, "FILE:LITESPRK.RGB", UNIQUE_GOLD, TRUE, 1.2)
  if(uq == UQ_WHISPERWIND && damage > 1)
    damage--
  if(uq == UQ_WINDFORCE)
    damage = damage + 2
    target.vx = target.vx + (self.vx * PUSH_SPEED)
    target.vy = target.vy + (self.vy * PUSH_SPEED)
  if(uq == UQ_HORNET_NEST)
    STANDARD.PoisonCharacter(FindIndex(target), FindIndex(owner), POISON_FRAMES)
  self.number = 0  // Once per arrow...
  return damage

//-----------------------------------------------------------------------
// Mercy: heals the most hurt ally nearby (the holder too)...
int MercyHeal(int owner)
  int i, who, best, pct, bestpct
  float dx, dy
  best = NULL
  bestpct = 100
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(who)
      if(who.team == owner.team && who.hits > 0 && who.hitsmax > 0)
        dx = who.x - owner.x
        dy = who.y - owner.y
        if(dx*dx + dy*dy < MERCY_RANGE*MERCY_RANGE)
          pct = (who.hits * 100) / who.hitsmax
          if(pct < bestpct)
            bestpct = pct
            best = who
    i++
  if(!best)
    return FALSE
  GENERIC.RestoreCharacterHits(best, MERCY_HEAL, 0)
  PFLASH.Effect(best, "FILE:LITESPRK.RGB", 8454016, TRUE, 0.8)
  return TRUE

//-----------------------------------------------------------------------
// The holder was just hurt (Damaged)...  Thornback bites back at foes
// close enough to be fighting hand to hand (bites and stings too)...
int Struck(int holder)
  int attacker, dealt
  float dx, dy, reach
  if(IdIn(holder, 242) != UQ_THORNBACK)
    return FALSE
  attacker = FindByIndex(SystemGet(SYS_GLOBALATTACKER, 0, 0))
  if(!attacker || attacker == holder)
    return FALSE
  if(attacker.team == holder.team || attacker.hits == 0)
    return FALSE
  dx = attacker.x - holder.x
  dy = attacker.y - holder.y
  reach = holder.boxsize + attacker.boxsize + 3.0
  if(dx*dx + dy*dy > reach*reach)
    return FALSE
  dealt = SystemGet(SYS_DAMAGEAMOUNT, 0, 0)
  if(dealt < 1)
    return FALSE
  Hurt(attacker, DAMAGE_EDGE, (dealt + 1) >> 1, holder)
  PSPARK.Effect(attacker.x, attacker.y, attacker.z + (attacker.height*0.6), 6, 1)
  return TRUE

//-----------------------------------------------------------------------
// holder blocked attacker's attack, which would have done damage...
// melee is TRUE for swings (not arrows and such)...
int Blocked(int holder, int attacker, int amount, int melee)
  int uq
  if(holder.team == attacker.team || attacker.hits == 0)
    return FALSE
  uq = IdIn(holder, 242)
  if(uq == UQ_AEGIS_OF_THE_SQUIRE)
    GENERIC.RestoreCharacterHits(holder, 1, 0)
    PFLASH.Effect(holder, "FILE:LITESPRK.RGB", 8454016, TRUE, 0.8)
    return TRUE
  if(uq == UQ_SPARROWS_WING)
    FileWriteByte(holder, UNIQUE_COUNTER_OFFSET, 1)
    return TRUE
  if(!melee)
    return FALSE
  if(uq == UQ_MEDUSAS_MIRROR)
    STANDARD.PetrifyCharacter(FindIndex(attacker), FindIndex(holder), 120)
    return TRUE
  if(uq == UQ_THORNBACK)
    Hurt(attacker, DAMAGE_EDGE, (amount + 1) >> 1, holder)
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// The wearer was just damaged (CPLAYER.Event, before anything else)...
int Damaged(int self)
  int room
  Struck(self)
  Wrath(self)
  Anvil(self)
  Fortress(self)
  if(Worn(self, UQ_CHAIN_OF_PENANCE))
    FileWriteByte(self, UNIQUE_COUNT_OFFSET, 0)  // The chain starts over...
  if(Worn(self, UQ_RIPOSTE))
    FileWriteByte(self, UNIQUE_COUNTER_OFFSET, 1)  // Riposte: the next hit strikes back double...
  Sync(self)  // Squire's Promise...
  if(self.hits == 0)
    // Unbroken: a killing blow leaves 1 hit, once per room...
    if(Worn(self, UQ_UNBROKEN))
      room = SystemGet(SYS_MAPROOM, 0, MAP_ROOM_CURRENT) + 1
      if(ReadShort(self, UNIQUE_ROOM_OFFSET) != room)
        WriteShort(self, UNIQUE_ROOM_OFFSET, room)
        self.hits = 1
        if(self.intimer < 120)
          self.intimer = 120
        PFLASH.Effect(self, "FILE:LITESPRK.RGB", UNIQUE_GOLD, TRUE, 2.0)
        PlaySound("FILE:BAD5.RAW", 160, 255)
        StartTimer(self)
    return TRUE
  // Blinkhide: sometimes blinks a short way off...
  if(Worn(self, UQ_BLINKHIDE))
    if(RollDice(1, 100) <= BLINK_CHANCE)
      Blink(self)
  return TRUE

//-----------------------------------------------------------------------
// The foe that just hurt a character, if it's close enough to be fighting
// hand to hand (NULL if not)...
int MeleeAttacker(int self)
  int attacker
  float dx, dy, reach
  attacker = FindByIndex(SystemGet(SYS_GLOBALATTACKER, 0, 0))
  if(!DWARFFX.Foe(self, attacker))
    return NULL
  dx = attacker.x - self.x
  dy = attacker.y - self.y
  reach = self.boxsize + attacker.boxsize + 3.0
  if(dx*dx + dy*dy > reach*reach)
    return NULL
  return attacker

//-----------------------------------------------------------------------
// Anvil Greaves: sometimes knocks a melee attacker down...
int Anvil(int self)
  int attacker
  if(!Worn(self, UQ_ANVIL_GREAVES))
    return FALSE
  if(RollDice(1, 100) > ANVIL_CHANCE)
    return FALSE
  attacker = MeleeAttacker(self)
  if(!attacker)
    return FALSE
  PlaySound("FILE:BLOCK.RAW", 150, 255)
  DWARFFX.KnockDown(attacker, self.x, self.y)
  return TRUE

//-----------------------------------------------------------------------
// Fortress: standing still, a quarter of each hit's damage comes back...
int Fortress(int self)
  int dealt
  if(!Worn(self, UQ_FORTRESS) || self.hits == 0)
    return FALSE
  if(self.action != ACTION_STAND && self.action != ACTION_STUN_BEGIN && self.action != ACTION_STUN)
    return FALSE
  // A quarter, with the leftover as a chance (so 1 damage hits come back 1 time in 4)...
  dealt = SystemGet(SYS_DAMAGEAMOUNT, 0, 0)
  if(RollDice(1, 4) <= (dealt & 3))
    dealt = dealt + 4
  dealt = dealt >> 2
  if(dealt < 1)
    return FALSE
  GENERIC.RestoreCharacterHits(self, dealt, 0)
  return TRUE

//-----------------------------------------------------------------------
// Wrath of Ages: sometimes lightning strikes back at whoever hurt the wearer...
int Wrath(int self)
  int attacker
  if(!Worn(self, UQ_WRATH_OF_AGES))
    return FALSE
  if(RollDice(1, 100) > WRATH_CHANCE)
    return FALSE
  attacker = FindByIndex(SystemGet(SYS_GLOBALATTACKER, 0, 0))
  if(!DWARFFX.Foe(self, attacker))
    return FALSE
  PlaySound("FILE:-SHOCK.RAW", 245 + RollDice(1, 20), 200)
  DWARFFX.ZapAt(self, attacker)
  Hurt(attacker, DAMAGE_VOLT, WRATH_DAMAGE, self)
  PSPARK.Effect(attacker.x, attacker.y, attacker.z + (attacker.height*0.6), 8, 1)
  return TRUE

//-----------------------------------------------------------------------
// Moves a character a short way in a random direction, if there's room...
int Blink(int self)
  int tries
  float angle, x, y, z
  tries = 0
  while(tries < 8)
    angle = RollDice(1, 360)
    x = self.x + sin(angle)*4.0
    y = self.y + sin(angle+90.0)*4.0
    z = GENERIC.AreaHeightXY(x, y, self.boxsize)
    if(z < (self.z+2.0) && z > (self.z-3.0))
      if(TestLocation(x, y, z, self.boxsize))
        PFLASH.Effect(self, "FILE:LITESPRK.RGB", 8421631, TRUE, 1.0)
        self.x = x
        self.y = y
        self.z = z
        self.vx = 0.0
        self.vy = 0.0
        PFLASH.Effect(self, "FILE:LITESPRK.RGB", 8421631, TRUE, 1.0)
        PlaySound("FILE:-SPELL00.RAW", 300, 160)
        return TRUE
    tries++
  return FALSE


//-----------------------------------------------------------------------
// Minions...
//-----------------------------------------------------------------------
int ReadShort(int who, int offset)
  return (FileReadByte(who, offset) | (FileReadByte(who, offset+1) << 8))

//-----------------------------------------------------------------------
int WriteShort(int who, int offset, int value)
  FileWriteByte(who, offset, value & 255)
  FileWriteByte(who, offset+1, (value >> 8) & 255)
  return TRUE

//-----------------------------------------------------------------------
// The character's item minion, if it's still around...
int Minion(int self)
  int index, pet, script
  index = ReadShort(self, UNIQUE_MINION_OFFSET)
  if(index == 0)
    return NULL
  index--
  pet = FindByIndex(index)
  if(pet)
    if(pet.owner == FindIndex(self) && pet.hits > 0)
      script = SystemGet(SYS_CHARACTERSCRIPTFILE, 0, index)
      if(script == "FILE:CRAT.RUN" || script == "FILE:CWRAITHE.RUN" || script == "FILE:CWUFF.RUN" || script == "FILE:CSKULTON.RUN")
        return pet
  WriteShort(self, UNIQUE_MINION_OFFSET, 0)
  return NULL

//-----------------------------------------------------------------------
// Calls a minion for seconds (MINION_FOREVER: while the item is worn)...
// subtype goes in the top 2 bits (SetSpawnSubtype)...  Only one item minion at a time...
int Summon(int self, int script, int subtype, int seconds)
  int index, child
  float x, y, z
  if(Minion(self))
    return NULL
  index = FindIndex(self)
  x = self.x + self.frontx*(self.boxsize + 2.0)
  y = self.y + self.fronty*(self.boxsize + 2.0)
  z = GENERIC.AreaHeightXY(x, y, 1.5)
  if(!TestLocation(x, y, z, 1.5) || z > (self.z + 2.0))
    x = self.x
    y = self.y
    z = self.z
  SetSpawnOwner(index)
  SetSpawnTeam(self.team)
  SetSpawnSubtype(subtype << 6)
  child = Spawn(CHARACTER, x, y, z, script)
  SetSpawnOwner(index)
  SetSpawnTeam(self.team)
  if(child)
    child.aitimer = 30
    child.spin = self.spin
    child.level = 1
    child.item00 = ITEM_NONE
    WriteShort(self, UNIQUE_MINION_OFFSET, FindIndex(child) + 1)
    FileWriteByte(self, UNIQUE_MLEFT_OFFSET, seconds)
    PFLASH.Effect(child, "FILE:LITESPRK.RGB", UNIQUE_GOLD, TRUE, 1.5)
    StartTimer(self)
  return child

//-----------------------------------------------------------------------
// Sends the item minion away...
int Dismiss(int self)
  int pet, old
  pet = Minion(self)
  if(pet)
    PFLASH.Effect(pet, "FILE:LITESPRK.RGB", UNIQUE_GOLD, TRUE, 1.5)
    old = self.target
    self.target = FindIndex(pet)
    GoPoof(POOF_TARGET)
    self.target = old
  WriteShort(self, UNIQUE_MINION_OFFSET, 0)
  return TRUE


//-----------------------------------------------------------------------
// Worn effects...
//-----------------------------------------------------------------------
// Starts the one second timer if it isn't running...
int StartTimer(int self)
  if(ReadShort(self, UNIQUE_TIMER_OFFSET) == 0)
    WriteShort(self, UNIQUE_TIMER_OFFSET, TICK_FRAMES)
  return TRUE

//-----------------------------------------------------------------------
// Brings the worn effects up to date (equipment changed, or a timer tick)...
// Called from CPLAYER.DefenseRating and Tick...
int Sync(int self)
  int speed, mana, hits, wear, pet
  // Walk speed (charact.c reads it)...
  speed = 0
  if(Worn(self, UQ_ROAD_BOOTS))
    speed = speed + 15
  if(Worn(self, UQ_UNBROKEN))
    speed = speed - 10
  if(Worn(self, UQ_EXECUTIONER))
    speed = speed - 10
  if(Worn(self, UQ_SPARROWS_WING))
    speed = speed + 10
  if(Worn(self, UQ_HARES_BREECHES))
    speed = speed + 20
  if(Worn(self, UQ_UNDYING_COLOSSUS))
    speed = speed - 10
  if(Worn(self, UQ_DUELISTS_GRACE))
    speed = speed + 15
  if(Worn(self, UQ_EARTHSHAKER))
    speed = speed - 10
  if(Worn(self, UQ_PHALANX))
    speed = speed - 10
  FileWriteByte(self, UNIQUE_SPEED_OFFSET, speed & 255)
  SyncStats(self)
  // Starwoven Sash: more max mana, fewer max hits...
  wear = Worn(self, UQ_STARWOVEN_SASH)
  if(wear && FileReadByte(self, UNIQUE_SASH_OFFSET) == 0)
    mana = self.manamax >> 1
    if(self.manamax + mana > 255)
      mana = 255 - self.manamax
    hits = self.hitsmax / 5
    if(hits >= self.hitsmax)
      hits = self.hitsmax - 1
    self.manamax = self.manamax + mana
    self.hitsmax = self.hitsmax - hits
    if(self.hits > self.hitsmax - self.hitstap)
      self.hits = self.hitsmax - self.hitstap
    FileWriteByte(self, UNIQUE_MANA_OFFSET, mana)
    FileWriteByte(self, UNIQUE_HITS_OFFSET, hits)
    FileWriteByte(self, UNIQUE_SASH_OFFSET, 1)
  if(!wear && FileReadByte(self, UNIQUE_SASH_OFFSET))
    mana = FileReadByte(self, UNIQUE_MANA_OFFSET)
    if(mana > self.manamax)
      mana = self.manamax
    self.manamax = self.manamax - mana
    if(self.mana > self.manamax)
      self.mana = self.manamax
    self.hitsmax = self.hitsmax + FileReadByte(self, UNIQUE_HITS_OFFSET)
    FileWriteByte(self, UNIQUE_MANA_OFFSET, 0)
    FileWriteByte(self, UNIQUE_HITS_OFFSET, 0)
    FileWriteByte(self, UNIQUE_SASH_OFFSET, 0)
  // A wraith only stays while the Shroud is worn...
  pet = Minion(self)
  if(pet && FileReadByte(self, UNIQUE_MLEFT_OFFSET) == MINION_FOREVER)
    if(!KeepsMinion(self))
      Dismiss(self)
  if(NeedsTimer(self))
    StartTimer(self)
  return TRUE

//-----------------------------------------------------------------------
// Stat changes from worn uniques...  What's applied is kept in the
// character (UNIQUE_STATS_OFFSET, UNIQUE_INTS_OFFSET) so it comes off again...
int SyncStats(int self)
  int s, d, n, packed, olds, oldd, oldn
  s = 0
  d = 0
  n = 0
  if(Worn(self, UQ_TITANS_GAVEL))
    d = d - 2
  if(Worn(self, UQ_BULWARK_VISOR))
    d = d - 1
  if(Worn(self, UQ_HARES_BREECHES))
    s = s - 1
  if(Worn(self, UQ_BASTION_BREAKER))
    d = d - 2
  if(Worn(self, UQ_FORTRESS))
    d = d - 1
  if(Worn(self, UQ_IRONBROW))
    n = n - 2
  if(Worn(self, UQ_CREST_OF_VALOUR))
    s = s + 2
  if(Worn(self, UQ_STRIDE_OF_KINGS))
    s = s + 1
    d = d + 1
    n = n + 1
  if(Worn(self, UQ_CROWN_OF_THE_OLD_KING))
    s = s - 1
    d = d - 1
    n = n - 1
  if(Worn(self, UQ_WINDFORCE))
    d = d - 2
  if(Worn(self, UQ_SQUIRES_PROMISE))
    if(self.hits * 2 < self.hitsmax)
      s = s + 2
      d = d + 2
      n = n + 2
  packed = FileReadByte(self, UNIQUE_STATS_OFFSET)
  olds = Nibble(packed & 15)
  oldd = Nibble(packed >> 4)
  oldn = Nibble(FileReadByte(self, UNIQUE_INTS_OFFSET) & 15)
  if(s == olds && d == oldd && n == oldn)
    return FALSE
  s = ShiftStat(self, 86, olds, s)
  d = ShiftStat(self, 87, oldd, d)
  n = ShiftStat(self, 88, oldn, n)
  FileWriteByte(self, UNIQUE_STATS_OFFSET, (s & 15) | ((d & 15) << 4))
  FileWriteByte(self, UNIQUE_INTS_OFFSET, n & 15)
  return TRUE

//-----------------------------------------------------------------------
// Signed 4 bit value...
int Nibble(int value)
  if(value > 7)
    return (value - 16)
  return value

//-----------------------------------------------------------------------
// Moves a stat (character offset) from the applied change to the wanted
// one, never below 1...  Returns the change now applied...
int ShiftStat(int self, int offset, int applied, int want)
  int old, value
  old = FileReadByte(self, offset)
  value = old - applied
  value = value + want
  if(value < 1)
    value = 1
  if(value > 255)
    value = 255
  FileWriteByte(self, offset, value)
  value = value - old
  return (applied + value)

//-----------------------------------------------------------------------
// TRUE if the character wears something whose minion stays while worn...
int KeepsMinion(int self)
  if(Worn(self, UQ_SHROUD_OF_THE_LICH) || Worn(self, UQ_CROWN_OF_THE_OLD_KING) || Worn(self, UQ_WOODSMANS_FRIEND))
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// TRUE if anything the character wears (or its minion) needs the timer...
int NeedsTimer(int self)
  if(ReadShort(self, UNIQUE_MINION_OFFSET))
    return TRUE
  if(ReadShort(self, UNIQUE_ROOM_OFFSET))
    return TRUE
  if(Worn(self, UQ_TEMPLARS_MANTLE) || Worn(self, UQ_CIRCLET_OF_STORMS) || Worn(self, UQ_SHROUD_OF_THE_LICH))
    return TRUE
  if(Worn(self, UQ_SQUIRES_PROMISE) || Worn(self, UQ_UNDYING_COLOSSUS) || Worn(self, UQ_WELLSPRING_SASH))
    return TRUE
  if(KeepsMinion(self) || Worn(self, UQ_PHALANX) || Worn(self, UQ_SNIPERS_PATIENCE))
    return TRUE
  if(Worn(self, UQ_WARDENS_WATCH) || Worn(self, UQ_MANTLE_OF_KNIVES) || Worn(self, UQ_SIEGEWALKER))
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// Once a second (EVENT_UNIQUE_TIMER)...
int Tick(int self)
  int left, wait, secs, room, pet
  if(self.hits == 0)
    WriteShort(self, UNIQUE_TIMER_OFFSET, TICK_FRAMES)
    return FALSE
  secs = (FileReadByte(self, UNIQUE_TICK_OFFSET) + 1) & 255
  FileWriteByte(self, UNIQUE_TICK_OFFSET, secs)
  // Unbroken is ready again in a new room...
  room = ReadShort(self, UNIQUE_ROOM_OFFSET)
  if(room && room != SystemGet(SYS_MAPROOM, 0, MAP_ROOM_CURRENT) + 1)
    WriteShort(self, UNIQUE_ROOM_OFFSET, 0)
  // Auras...
  if(Worn(self, UQ_TEMPLARS_MANTLE))
    HolyAura(self)
  if(Worn(self, UQ_CIRCLET_OF_STORMS))
    if((secs & 1) == 0)
      StormZap(self)
  if(Worn(self, UQ_WELLSPRING_SASH))
    Wellspring(self)
  Stillness(self)
  if(Worn(self, UQ_WARDENS_WATCH))
    Ward(self)
  if(Worn(self, UQ_MANTLE_OF_KNIVES))
    if(secs % KNIFE_SECONDS == 0)
      Knife(self)
  if(Worn(self, UQ_SIEGEWALKER))
    Trample(self)
  if(Worn(self, UQ_UNDYING_COLOSSUS))
    if(secs % REGEN_SECONDS == 0)
      if(self.hits < self.hitsmax - self.hitstap)
        GENERIC.RestoreCharacterHits(self, 1, 0)
  // Minions...
  if(Minion(self))
    left = FileReadByte(self, UNIQUE_MLEFT_OFFSET)
    if(left != MINION_FOREVER)
      left--
      FileWriteByte(self, UNIQUE_MLEFT_OFFSET, left)
      if(left <= 0)
        Dismiss(self)
  else
    if(KeepsMinion(self))
      wait = FileReadByte(self, UNIQUE_MWAIT_OFFSET)
      if(wait > 0)
        FileWriteByte(self, UNIQUE_MWAIT_OFFSET, wait - 1)
      else
        pet = NULL
        if(Worn(self, UQ_SHROUD_OF_THE_LICH))
          pet = Summon(self, "FILE:CWRAITHE.RUN", 2, MINION_FOREVER)  // A sword wraith...
        else
          if(Worn(self, UQ_CROWN_OF_THE_OLD_KING))
            pet = Summon(self, "FILE:CSKULTON.RUN", 0, MINION_FOREVER)  // A skeleton...
          else
            pet = Summon(self, "FILE:CWUFF.RUN", 0, MINION_FOREVER)  // A wuff...
        if(pet)
          FileWriteByte(self, UNIQUE_MWAIT_OFFSET, WRAITH_WAIT)
  Sync(self)
  if(NeedsTimer(self))
    WriteShort(self, UNIQUE_TIMER_OFFSET, TICK_FRAMES)
  return TRUE

//-----------------------------------------------------------------------
// Counts seconds standing still (Phalanx, Sniper's Patience)...  Phalanx's
// defense changes when that starts or stops...
int Stillness(int self)
  int x, y, still, old
  float fx, fy
  fx = self.x * 2.0
  fy = self.y * 2.0
  x = fx
  y = fy
  x = x & 255
  y = y & 255
  old = FileReadByte(self, UNIQUE_STILL_OFFSET)
  still = 0
  if(x == FileReadByte(self, UNIQUE_SPOT_OFFSET) && y == FileReadByte(self, UNIQUE_SPOT_OFFSET+1))
    still = old + 1
    if(still > 250)
      still = 250
  FileWriteByte(self, UNIQUE_SPOT_OFFSET, x)
  FileWriteByte(self, UNIQUE_SPOT_OFFSET+1, y)
  FileWriteByte(self, UNIQUE_STILL_OFFSET, still)
  if(Worn(self, UQ_PHALANX))
    if(old == 0 && still > 0)
      SystemSet(SYS_CHARFASTFUNCTION, FindIndex(self), 0, FAST_FUNCTION_DEFENSERATING)
    if(old > 0 && still == 0)
      SystemSet(SYS_CHARFASTFUNCTION, FindIndex(self), 0, FAST_FUNCTION_DEFENSERATING)
  return still

//-----------------------------------------------------------------------
// The nearest foe within range of a character (NULL if none)...
int NearestFoe(int self, float range)
  int i, who, best
  float dx, dy, sl, bestsl
  best = NULL
  bestsl = range*range
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(DWARFFX.Foe(self, who))
      dx = who.x - self.x
      dy = who.y - self.y
      sl = dx*dx + dy*dy
      if(sl < bestsl)
        bestsl = sl
        best = who
    i++
  return best

//-----------------------------------------------------------------------
// Warden's Watch: strikes the nearest foe in reach...
int Ward(int self)
  int who
  who = NearestFoe(self, WARD_RANGE + self.boxsize)
  if(!who)
    return FALSE
  Hurt(who, DAMAGE_EDGE, WARD_DAMAGE, self)
  PSPARK.Effect(who.x, who.y, who.z + (who.height*0.6), 8, 1)
  PlaySound("FILE:SWIPE.RAW", 200 + RollDice(1, 50), 200)
  return TRUE

//-----------------------------------------------------------------------
// Mantle of Knives: throws a blade at the nearest foe...
int Knife(int self)
  int who, dex, aimed
  float vx, vy, vz
  who = NearestFoe(self, KNIFE_RANGE)
  if(!who)
    return FALSE
  // Aim at a foe in front, or else behind...
  dex = 50
  AutoAim(1.2, 70.0, self.spin, self.team, dex, 32000, AUTOAIM_CRUNCH_BALLISTIC)
  aimed = AutoAim(0.0, 0.0, 0, 0, 0, 0, AUTOAIM_TARGET)
  if(aimed >= MAX_CHARACTER)
    AutoAim(1.2, 70.0, (self.spin + 32768) & 65535, self.team, dex, 32000, AUTOAIM_CRUNCH_BALLISTIC)
    aimed = AutoAim(0.0, 0.0, 0, 0, 0, 0, AUTOAIM_TARGET)
    if(aimed >= MAX_CHARACTER)
      return FALSE
  vx = AutoAim(0.0, 0.0, 0, 0, 0, 0, AUTOAIM_X)
  vy = AutoAim(0.0, 0.0, 0, 0, 0, 0, AUTOAIM_Y)
  vz = AutoAim(0.0, 0.0, 0, 0, 0, 0, AUTOAIM_Z)
  SetSpawnOwner(FindIndex(self))
  SetSpawnTeam(self.team)
  PTHRAXE.Effect(self.x, self.y, self.z + (self.height*0.6), vx, vy, vz, DAMAGE_EDGE, KNIFE_DAMAGE, 0)
  PlaySound("FILE:SWIPE.RAW", 220 + RollDice(1, 50), 200)
  return TRUE

//-----------------------------------------------------------------------
// Siegewalker: walking into a foe knocks it down...
int Trample(int self)
  int who
  if(self.action != ACTION_WALK)
    return FALSE
  who = NearestFoe(self, self.boxsize + 2.0)
  if(!who)
    return FALSE
  Hurt(who, DAMAGE_BASH, 1, self)
  DWARFFX.KnockDown(who, self.x, self.y)
  PlaySound("FILE:BLOCK.RAW", 150, 255)
  return TRUE

//-----------------------------------------------------------------------
// Wellspring Sash: out of mana, half of it comes back, once a room...
int Wellspring(int self)
  int room
  if(self.mana > 0 || self.manamax < 2)
    return FALSE
  room = SystemGet(SYS_MAPROOM, 0, MAP_ROOM_CURRENT) + 1
  if(ReadShort(self, UNIQUE_WELL_OFFSET) == room)
    return FALSE
  WriteShort(self, UNIQUE_WELL_OFFSET, room)
  self.mana = self.manamax >> 1
  PFLASH.Effect(self, "FILE:LITESPRK.RGB", 8421631, TRUE, 1.5)
  PlaySound("FILE:-SPELL00.RAW", 256, 200)
  return TRUE

//-----------------------------------------------------------------------
// Templar's Mantle: undead foes nearby take 1 damage...
int HolyAura(int self)
  int i, who, any
  float dx, dy
  any = FALSE
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(DWARFFX.Foe(self, who))
      if(who.defwoun >= 50 && who.defwoun < 128)
        dx = who.x - self.x
        dy = who.y - self.y
        if(dx*dx + dy*dy < AURA_RANGE*AURA_RANGE)
          Hurt(who, DAMAGE_FIRE, 1, self)
          PFLASH.Effect(who, "FILE:LITESPRK.RGB", 16777088, TRUE, 0.8)
          any = TRUE
    i++
  return any

//-----------------------------------------------------------------------
// Circlet of Storms: zaps the nearest foe for 1 mana...
int StormZap(int self)
  int i, who, best
  float dx, dy, sl, bestsl
  if(self.mana < 1)
    return FALSE
  best = NULL
  bestsl = ZAP_RANGE
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(DWARFFX.Foe(self, who))
      dx = who.x - self.x
      dy = who.y - self.y
      sl = sqrt(dx*dx + dy*dy)
      if(sl < bestsl)
        bestsl = sl
        best = who
    i++
  if(!best)
    return FALSE
  self.mana = self.mana - 1
  PlaySound("FILE:-SHOCK.RAW", 245 + RollDice(1, 20), 200)
  DWARFFX.ZapAt(self, best)
  return TRUE

//-----------------------------------------------------------------------
// NOTE: The script compiler doesn't close an if() block that sits on the
// very last line of a file, so files end with a function level line.
//-----------------------------------------------------------------------
