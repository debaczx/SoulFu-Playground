//-----------------------------------------------------------------------
// <ZZ> Unique items...  Found, not crafted.  Each one is a normal item
//      type (which supplies the model and base stats) plus an extension
//      value from XITEM_UNIQUE_BASE up (see DEFINE.TXT and XITEM.SRC).
//
//      Every base item and kind has exactly one unique.  Those all share
//      the extension XITEM_UNIQUE, and the base item and kind say which
//      unique it is (UQ_ numbers below).  The Archmage Robe came
//      first and keeps its own value, XITEM_ARCHMAGE_ROBE.
//
//      Uniques can't be enchanted, modified or salvaged (any extension
//      that isn't a mod blocks those).  A chest item that has a unique
//      becomes it UNIQUE_CHANCE percent of the time, at most
//      UNIQUE_MAX_DROPS times per game (SYS_UNIQUEFOUND)...
//
//      Worn uniques keep a little state in the character (UNIQUE_*_OFFSET,
//      saved with the game).  A one second timer (EVENT_UNIQUE_TIMER, see
//      CPLAYER.Event) runs auras and the item minion.  A character has at
//      most one item minion at a time...
//-----------------------------------------------------------------------
#define UNIQUE_MAX_DROPS       2     // Each unique drops at most this many times per game
#define UNIQUE_CHANCE          10    // Percent chance a chest item that has a unique is that unique
// Character data: unique item state (16 bytes, saved with the game, see object.c)...
#define UNIQUE_TIMER_OFFSET    672   // unsigned short: counts down, EVENT_UNIQUE_TIMER at 0
#define UNIQUE_SPEED_OFFSET    674   // signed char: walk speed percent from worn uniques (charact.c)
#define UNIQUE_SASH_OFFSET     675   // Starwoven Sash: 1 while its mana/hits change is applied
#define UNIQUE_MINION_OFFSET   676   // unsigned short: the item minion's character index + 1 (0 = none)
#define UNIQUE_MLEFT_OFFSET    678   // Seconds the minion has left (255 = while the item is worn)
#define UNIQUE_MWAIT_OFFSET    679   // Seconds before a lost minion comes back
#define UNIQUE_ROOM_OFFSET     680   // unsigned short: Unbroken: the room it saved the wearer in + 1
#define UNIQUE_MANA_OFFSET     682   // Starwoven Sash: mana max it added
#define UNIQUE_HITS_OFFSET     683   // Starwoven Sash: hits max it took
#define UNIQUE_TICK_OFFSET     684   // Seconds counter for slower auras
// Unique numbers (UNIQUE.SRC), one per base item and kind...  Never renumber (saves count drops by number)...
#define UQ_NIGHTS_EDGE         1     // Obsidian Blade
#define UQ_MEDUSAS_MIRROR      2     // Mirror Shield
#define UQ_THORNBACK           3     // Spiked Shield kind
#define UQ_UNBROKEN            4     // Heavy Platemail
#define UQ_HOOD_OF_WHISPERS    5     // Apprentice Hood kind
#define UQ_TEMPLARS_MANTLE     6     // Light Platemail
#define UQ_CIRCLET_OF_STORMS   7     // Archon Hood kind
#define UQ_ROAD_BOOTS          8     // Leather Pants
#define UQ_STARWOVEN_SASH      9     // Archon Sash kind
#define UQ_RAT_KINGS_TOOTH     10    // Dagger
#define UQ_SHROUD_OF_THE_LICH  11    // Archon Vestments kind
#define UQ_BLINKHIDE           12    // Shadow Vest kind
#define UQ_TRICKSTERS_KRIS     13    // Kris kind
#define UQ_LAST                13
#define TICK_FRAMES      60    // Frames per unique timer tick (one second)
#define MINION_FOREVER   255   // UNIQUE_MLEFT_OFFSET value: stays while the item is worn
#define RAT_SECONDS      20    // Rat King's Tooth: how long a rat stays
#define RAT_CHANCE       15    // Rat King's Tooth: percent chance per hit to call a rat
#define WRAITH_WAIT      30    // Shroud of the Lich: seconds before a lost wraith comes back
#define BLINK_CHANCE     20    // Blinkhide: percent chance per hit taken to blink away
#define AURA_RANGE       6.0   // Templar's Mantle: reach of the holy aura
#define ZAP_RANGE        10.0  // Circlet of Storms: reach of the zaps


//-----------------------------------------------------------------------
// Archmage Robe...  A Leather Cuirass with its own name, colors and
// ROBE_MANA_REGEN percent faster mana regeneration (MREGEN.SRC)...
int IsRobe(int ext)
  return ((ext & 255) == XITEM_ARCHMAGE_ROBE)

//-----------------------------------------------------------------------
int WearingRobe(int who)
  if((who.eqbody & 252) != ITEM_BODY_1)
    return FALSE
  return IsRobe(XITEM.Get(who, 247))

//-----------------------------------------------------------------------
// Appended to the robe's name...  Reads the define so the tooltip
// always matches the real number...
int RobeName()
  StringAppend(NAME_STRING, " (MANA REGEN +", 256)
  StringAppendNumber(NAME_STRING, ROBE_MANA_REGEN, 256)
  StringAppend(NAME_STRING, "%)", 256)
  return TRUE


//-----------------------------------------------------------------------
// Which unique...
//-----------------------------------------------------------------------
// Unique number of an item (0 if it isn't one)...  item is the item byte,
// raw_ext the slot's whole extension (kind bits and all)...
int Id(int item, int raw_ext)
  int kind
  if((raw_ext & 255) != XITEM_UNIQUE)
    return 0
  return IdFor(item, XITEM.KindOf(raw_ext))

//-----------------------------------------------------------------------
// Unique number for a base item and kind, whether or not it is one...
// Enchant variants are ignored (item & 248 for weapons, & 252 for armour)...
int IdFor(int item, int kind)
  if(item >= ITEM_DAGGER)
    item = item & 248
  else
    item = item & 252
  if(kind == 0)
    if(item == ITEM_OBSIDIAN_BLADE)
      return UQ_NIGHTS_EDGE
    if(item == ITEM_MIRROR_SHIELD)
      return UQ_MEDUSAS_MIRROR
    if(item == ITEM_BODY_4)
      return UQ_UNBROKEN
    if(item == ITEM_BODY_3)
      return UQ_TEMPLARS_MANTLE
    if(item == ITEM_LEGS_1)
      return UQ_ROAD_BOOTS
    if(item == ITEM_DAGGER)
      return UQ_RAT_KINGS_TOOTH
    return 0
  if(kind == KIND_SPIKED_SHIELD)
    return UQ_THORNBACK
  if(kind == KIND_APPRENTICE_HOOD)
    return UQ_HOOD_OF_WHISPERS
  if(kind == KIND_ARCHON_HOOD)
    return UQ_CIRCLET_OF_STORMS
  if(kind == KIND_ARCHON_SASH)
    return UQ_STARWOVEN_SASH
  if(kind == KIND_ARCHON_VESTMENTS)
    return UQ_SHROUD_OF_THE_LICH
  if(kind == KIND_SHADOW_VEST)
    return UQ_BLINKHIDE
  if(kind == KIND_KRIS)
    return UQ_TRICKSTERS_KRIS
  return 0

//-----------------------------------------------------------------------
// Unique number of the item in a character's slot...
int IdIn(int who, int slot)
  return Id(FileReadByte(who, slot), XITEM.GetRaw(who, slot))

//-----------------------------------------------------------------------
// Unique number of the item whose callback is running right now...
int CurrentId()
  return Id(SystemGet(SYS_ITEMINDEX, 0, 0), SystemGet(SYS_ITEMEXT, 0, 1))

//-----------------------------------------------------------------------
// TRUE if a character wears or holds the unique...
int Worn(int who, int uq)
  if(!who)
    return FALSE
  if(IdIn(who, 242) == uq || IdIn(who, 243) == uq)
    return TRUE
  if(who.sflags & SCRIPT_ALLOW_HELM)
    if(IdIn(who, 246) == uq)
      return TRUE
  if(who.sflags & SCRIPT_ALLOW_BODY)
    if(IdIn(who, 247) == uq)
      return TRUE
  if(who.sflags & SCRIPT_ALLOW_LEGS)
    if(IdIn(who, 248) == uq)
      return TRUE
  return FALSE


