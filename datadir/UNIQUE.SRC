#define UQ_SIEGEWALKER         61    // Bastion Greaves kind
#define UQ_GATEKEEPER          62    // Chain Helm
#define UQ_LAST                62
#define TICK_FRAMES      60    // Frames per unique timer tick (one second)
#define MINION_FOREVER   255   // UNIQUE_MLEFT_OFFSET value: stays while the item is worn
#define RAT_SECONDS      20    // Rat King's Tooth: how long a rat stays
#define RAT_CHANCE       15    // Rat King's Tooth: percent chance per hit to call a rat
#define WRAITH_WAIT      30    // Shroud of the Lich: seconds before a lost wraith comes back
#define BLINK_CHANCE     20    // Blinkhide: percent chance per hit taken to blink away
#define AURA_RANGE       6.0   // Templar's Mantle: reach of the holy aura
#define ZAP_RANGE        10.0  // Circlet of Storms: reach of the zaps
#define GAVEL_CHANCE     10    // Titan's Gavel: percent chance per hit to petrify
#define GAVEL_FRAMES     120   // Titan's Gavel: how long the petrify lasts
#define DAWN_CHANCE      33    // Dawnbreaker: percent chance per hit to knock undead down
#define MERCY_HEAL       2     // Mercy: hits healed per hit
#define MERCY_RANGE      8.0   // Mercy: reach of the heal
#define COIN_DROP        2     // Corsair's Fang: coins per hit
#define COUNTER_BONUS    3     // Sparrow's Wing: extra damage on the hit after a block
#define WRATH_CHANCE     20    // Wrath of Ages: percent chance per hit taken to zap back
#define WRATH_DAMAGE     3     // Wrath of Ages: damage of the zap (on top of the bolt's own)
#define REGEN_SECONDS    3     // Undying Colossus: seconds per hit regained
#define SMALL_SIZE       1.3   // Gremf Cleaver: foes this size or smaller take +50% (rats, gremfs)
#define LARGE_SIZE       2.0   // Gremf Cleaver: foes this size or bigger take -25% (porcs, ogres)
#define WIND_CHANCE      25    // Highland Wind: percent chance per hit to knock the foe down
#define BURST_RANGE      5.0   // Wyrmheart: reach of the fire burst when a foe dies
#define PENANCE_MAX      5     // Chain of Penance: most extra damage from hits in a row
#define QUAKE_HITS       4     // Earthshaker: every this many hits makes a shockwave
#define QUAKE_RANGE      5.0   // Earthshaker: reach of the shockwave
#define QUAKE_DAMAGE     3     // Earthshaker: damage of the shockwave
#define ANVIL_CHANCE     15    // Anvil Greaves: percent chance to knock down a melee attacker
#define WIND_SPEED       1.5   // Whisperwind: arrow speed multiplier
#define PUSH_SPEED       0.8   // Windforce: how hard arrows push foes back
#define MOON_SPREAD      0.12  // Hunter's Moon: sideways spread of the extra arrows
#define STORM_SHOTS      5     // Stormstring: every this many shots calls lightning
#define SNIPE_SECONDS    2     // Sniper's Patience: seconds standing still for a triple bolt
#define ARROW_SNIPE      1     // Arrow flag (particle number): triple damage
#define ARROW_UNIQUE     2     // Arrow flag (particle number): shot from a unique (see ArrowHit)
#define POISON_FRAMES    300   // Hornet Nest: poison length
#define WARD_RANGE       5.0   // Warden's Watch: reach of the auto hits
#define WARD_DAMAGE      2     // Warden's Watch: damage of an auto hit
#define REFILL_CHANCE    25    // Tinker's Mallet: percent chance per hit to put an arrow back
#define KNIFE_SECONDS    3     // Mantle of Knives: seconds between blades
#define KNIFE_RANGE      12.0  // Mantle of Knives: reach
#define KNIFE_DAMAGE     3     // Mantle of Knives: blade damage
#define CREST_RANGE      8.0   // Warlord's Crest: reach of the damage bonus
#define PHALANX_DEF      3     // Phalanx: edge and bash defense while still


//-----------------------------------------------------------------------
// Archmage Robe...  A Leather Cuirass with its own name, colors and
// ROBE_MANA_REGEN percent faster mana regeneration (MREGEN.SRC)...
int IsRobe(int ext)
  return ((ext & 255) == XITEM_ARCHMAGE_ROBE)

//-----------------------------------------------------------------------
int WearingRobe(int who)
  if((who.eqbody & 252) != ITEM_BODY_1)
    return FALSE
  return IsRobe(XITEM.Get(who, 247))

//-----------------------------------------------------------------------
// Appended to the robe's name...  Reads the define so the tooltip
// always matches the real number...
int RobeName()
  StringAppend(NAME_STRING, " (MANA REGEN +", 256)
  StringAppendNumber(NAME_STRING, ROBE_MANA_REGEN, 256)
  StringAppend(NAME_STRING, "%)", 256)
  return TRUE


//-----------------------------------------------------------------------
// Which unique...
//-----------------------------------------------------------------------
// Unique number of an item (0 if it isn't one)...  item is the item byte,
// raw_ext the slot's whole extension (kind bits and all)...
int Id(int item, int raw_ext)
  int kind
  if((raw_ext & 255) != XITEM_UNIQUE)
    return 0
  return IdFor(item, XITEM.KindOf(raw_ext))

//-----------------------------------------------------------------------
// Unique number for a base item and kind, whether or not it is one...
// Enchant variants are ignored (item & 248 for weapons, & 252 for armour)...
int IdFor(int item, int kind)
  if(item >= ITEM_DAGGER)
    item = item & 248
  else
    item = item & 252
  if(kind == 0)
    if(item == ITEM_OBSIDIAN_BLADE)
      return UQ_NIGHTS_EDGE
    if(item == ITEM_MIRROR_SHIELD)
      return UQ_MEDUSAS_MIRROR
    if(item == ITEM_BODY_4)
      return UQ_UNBROKEN
    if(item == ITEM_BODY_3)
      return UQ_TEMPLARS_MANTLE
    if(item == ITEM_LEGS_1)
      return UQ_ROAD_BOOTS
    if(item == ITEM_DAGGER)
      return UQ_RAT_KINGS_TOOTH
    if(item == ITEM_GREAT_SWORD)
      return UQ_KINGSLAYER
    if(item == ITEM_BROAD_AXE)
      return UQ_EXECUTIONER
    if(item == ITEM_MACE)
      return UQ_MERCY
    if(item == ITEM_SHORT_SWORD)
      return UQ_SQUIRES_PROMISE
    if(item == ITEM_SHIELD)
      return UQ_AEGIS_OF_THE_SQUIRE
    if(item == ITEM_BODY_2)
      return UQ_COAT_OF_RINGS
    if(item == ITEM_BODY_5)
      return UQ_WRATH_OF_AGES
    if(item == ITEM_SWORD)
      return UQ_OATHKEEPER
    if(item == ITEM_DRAGON_SWORD)
      return UQ_WYRMHEART
    if(item == ITEM_WAR_HAMMER)
      return UQ_EARTHSHAKER
    if(item == ITEM_HELM_4)
      return UQ_IRONBROW
    if(item == ITEM_LEGS_5)
      return UQ_STRIDE_OF_KINGS
    if(item == ITEM_HELM_3)
      return UQ_CREST_OF_VALOUR
    if(item == ITEM_BOW)
      return UQ_WHISPERWIND
    if(item == ITEM_LONG_BOW)
      return UQ_WINDFORCE
    if(item == ITEM_HAMMER)
      return UQ_TINKERS_MALLET
    if(item == ITEM_HATCHET)
      return UQ_WOODSMANS_FRIEND
    if(item == ITEM_HELM_5)
      return UQ_CROWN_OF_THE_OLD_KING
    if(item == ITEM_LEGS_2)
      return UQ_MUDWALKER
    if(item == ITEM_HELM_2)
      return UQ_GATEKEEPER
    return 0
  if(kind == KIND_SPIKED_SHIELD)
    return UQ_THORNBACK
  if(kind == KIND_APPRENTICE_HOOD)
    return UQ_HOOD_OF_WHISPERS
  if(kind == KIND_ARCHON_HOOD)
    return UQ_CIRCLET_OF_STORMS
  if(kind == KIND_ARCHON_SASH)
    return UQ_STARWOVEN_SASH
  if(kind == KIND_ARCHON_VESTMENTS)
    return UQ_SHROUD_OF_THE_LICH
  if(kind == KIND_SHADOW_VEST)
    return UQ_BLINKHIDE
  if(kind == KIND_KRIS)
    return UQ_TRICKSTERS_KRIS
  if(kind == KIND_MAUL)
    return UQ_TITANS_GAVEL
  if(kind == KIND_MORNING_STAR)
    return UQ_DAWNBREAKER
  if(kind == KIND_SABRE)
    return UQ_CORSAIRS_FANG
  if(kind == KIND_GREAT_AXE)
    return UQ_BERSERKERS_EDGE
  if(kind == KIND_BUCKLER)
    return UQ_SPARROWS_WING
  if(kind == KIND_IRON_GREATHELM)
    return UQ_BULWARK_VISOR
  if(kind == KIND_SCOUT_BREECHES)
    return UQ_HARES_BREECHES
  if(kind == KIND_JUGGERNAUT_PLATE)
    return UQ_UNDYING_COLOSSUS
  if(kind == KIND_KUKRI)
    return UQ_GREMF_CLEAVER
  if(kind == KIND_PARRY)
    return UQ_RIPOSTE
  if(kind == KIND_RAPIER)
    return UQ_DUELISTS_GRACE
  if(kind == KIND_CLAYMORE)
    return UQ_HIGHLAND_WIND
  if(kind == KIND_ZWEIHANDER)
    return UQ_BASTION_BREAKER
  if(kind == KIND_FLAIL)
    return UQ_CHAIN_OF_PENANCE
  if(kind == KIND_SPEAR)
    return UQ_WYVERN_LANCE
  if(kind == KIND_IRON_GREAVES)
    return UQ_ANVIL_GREAVES
  if(kind == KIND_MYSTIC_SASH)
    return UQ_WELLSPRING_SASH
  if(kind == KIND_BASTION_PLATE)
    return UQ_FORTRESS
  if(kind == KIND_RECURVE)
    return UQ_HUNTERS_MOON
  if(kind == KIND_COMPOSITE)
    return UQ_STORMSTRING
  if(kind == KIND_LIGHT_CROSSBOW)
    return UQ_SNIPERS_PATIENCE
  if(kind == KIND_REPEATER)
    return UQ_HORNET_NEST
  if(kind == KIND_TRIDENT)
    return UQ_TIDE_CALLER
  if(kind == KIND_PIKE)
    return UQ_PHALANX
  if(kind == KIND_HALBERD)
    return UQ_WARDENS_WATCH
  if(kind == KIND_SHADOW_BREECHES)
    return UQ_SILENT_STEP
  if(kind == KIND_NIGHTBLADE_LEATHERS)
    return UQ_MANTLE_OF_KNIVES
  if(kind == KIND_BASTION_HELM)
    return UQ_WARLORDS_CREST
  if(kind == KIND_BASTION_GREAVES)
    return UQ_SIEGEWALKER
  return 0

//-----------------------------------------------------------------------
// Highest unique number in use (the test shop runs through 1 to this)...
int Last()
  return UQ_LAST

//-----------------------------------------------------------------------
// Item key (item | (raw_ext<<8)) of a unique, as a chest would give it...
// New uniques need a line here too (the test shop stocks them from it)...
int KeyOf(int uq)
  if(uq == UQ_NIGHTS_EDGE)
    return MakeKey(ITEM_OBSIDIAN_BLADE, 0)
  if(uq == UQ_MEDUSAS_MIRROR)
    return MakeKey(ITEM_MIRROR_SHIELD, 0)
  if(uq == UQ_THORNBACK)
    return MakeKey(ITEM_SHIELD, KIND_SPIKED_SHIELD)
  if(uq == UQ_UNBROKEN)
    return MakeKey(ITEM_BODY_4, 0)
  if(uq == UQ_HOOD_OF_WHISPERS)
