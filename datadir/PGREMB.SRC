//-----------------------------------------------------------------------
// Gremf Bomb particle...  Bounces like a gronnade, then bursts into a
// harmless purple blast and summons three friendly Gremfs...
//-----------------------------------------------------------------------
#define hit_count     self.misc7
#define GREMF_SUMMONED_FLAG  32    // Bit in a Gremf's eqcol01 (see CGREMF.SRC)

//-----------------------------------------------------------------------
int Effect(float x, float y, float z, float vx, float vy, float vz)
  int child

  child = Spawn(PARTICLE, x, y, z, 0)
  if(child)
    child.image = "FILE:=GRON0.RGB"
    child.red = 200
    child.green = 90
    child.blue = 255
    child.vx = vx
    child.vy = vy
    child.vz = vz
  return child

//-----------------------------------------------------------------------
int Refresh()
  int self, i, child
  float angle, gx, gy


  // Harmless purple blast...  (no damage, so it can't hurt anyone)
  self = FindSelf()
  PSPARK.Effect(self.x, self.y, self.z, 8, 7)
  PEXPLODE.Effect(self.lastx, self.lasty, self.lastz, 0.0, 0.0, 2.3, DAMAGE_FIRE, 0, 0, self.owner, self.team, "FILE:SPARK6.RGB", MAGENTA, 120)
  PlaySound("FILE:BAD4.RAW", 300 + RollDice(1, 50), 200)


  // Summon three friendly Gremfs around the blast...
  i = 0
  angle = RollDice(1, 256) * 1.4
  while(i < 3)
    gx = self.lastx + (sin(angle)*1.5)
    gy = self.lasty + (sin(angle+90.0)*1.5)
    SystemSet(SYS_GLOBALSPAWN, 0, GLOBAL_SPAWN_TEAM, self.team)
    SystemSet(SYS_GLOBALSPAWN, 0, GLOBAL_SPAWN_SUBTYPE, GREMF_SUMMONED_FLAG | (RollDice(1, 16)&15))
    SystemSet(SYS_GLOBALSPAWN, 0, GLOBAL_SPAWN_OWNER, self.owner)
    child = Spawn(CHARACTER, gx, gy, self.lastz + 0.5, "FILE:CGREMF.RUN")
    if(child)
      child.spin = RollDice(1, 256)<<8
      child.aitimer = 10 + RollDice(1, 20)  // Wake up the AI (it only runs when this counts down)...
      child.vz = 0.4
      child.action = ACTION_JUMP_BEGIN
      child.daction = ACTION_JUMP
      child.flags = child.flags | CHAR_FALL_ON
      PFLASH.Effect(child, "FILE:LITESPRK.RGB", MAGENTA, TRUE, 0.9)
    angle = angle + 120.0
    i++
  GoPoof(POOF_SELF)

//-----------------------------------------------------------------------
int Event()
  int self
  self = FindSelf()
  if(self.event == EVENT_HIT_WALL || self.event == EVENT_HIT_FLOOR)
    self.x = self.lastx
    self.y = self.lasty
    self.z = self.lastz
    if(self.vspin < 32768)
      self.vspin = -(self.vspin)
    else
      self.vspin = (65536-self.vspin)
    self.vz = self.vz * -0.5
    if(self.event == EVENT_HIT_WALL)
      self.vx = self.vx * -0.5
      self.vy = self.vy * -0.5
    else
      self.vx = self.vx * 0.5
      self.vy = self.vy * 0.5
      hit_count++
      if(hit_count > 4)
        self.vx = 0
        self.vy = 0
        self.vz = 0
        self.flags = PART_SPIN_ON
        self.vspin = 0
  return TRUE

//-----------------------------------------------------------------------
int Spawn()
  int self
  self = FindSelf()
  self.length = 1.30
  self.width = 1.00
  self.flags = PART_SPIN_ON | PART_WALL_COLLISION_ON | PART_GRAVITY_ON
  self.spin = 27500 - (RollDice(1, 256)<<6)
  if(RollDice(1, 100) > 50)
    self.vspin = 2000
  else
    self.vspin = -2000
  hit_count = 0
  self.colsize = 0.5
  self.timer = 90
  return TRUE

//-----------------------------------------------------------------------
