#define ICE_SMOKE_COLOR (4239600)
#define MUZZLE_OUT      1.8     // How far in front of the G'nome the muzzle is...

//-----------------------------------------------------------------------
// Element of a modded Gonne (WEAPON_VARIANT_*), or 0 for a plain one...
int VariantElement()
  int ext
  ext = (SystemGet(SYS_ITEMEXT, 0, 0) & 255)
  if(ext > XITEM_GONNE_BASE && ext <= (XITEM_GONNE_BASE+7))
    return (ext - XITEM_GONNE_BASE)
  return 0

//-----------------------------------------------------------------------
int GetName()
  int element
  element = VariantElement()
  if(element == WEAPON_VARIANT_MAGIC)
    STANDARD.ItemName("VOLLEY GONNE", "HOMING", DAMAGE_BASH, 0, 2, 1, 1)
    return TRUE
  if(element == WEAPON_VARIANT_FIRE)
    STANDARD.ItemName("ROCKET GONNE", "2 AMMO", DAMAGE_FIRE, 4, 4, 2, 2)
    return TRUE
  if(element == WEAPON_VARIANT_ICE)
    STANDARD.ItemName("FROST BLUNDERBUSS", "CHILLS", DAMAGE_ICE, 2, 2, 1, 1)
    return TRUE
  if(element == WEAPON_VARIANT_VOLT)
    STANDARD.ItemName("ARC BURST", "SHORT", DAMAGE_VOLT, 3, 3, 0, 0)
    return TRUE
  if(element == WEAPON_VARIANT_POISON)
    STANDARD.ItemName("VENOM GONNE", "POISON", DAMAGE_EDGE, 1, 2, 1, 1)
    return TRUE
  if(element == WEAPON_VARIANT_HOLY)
    STANDARD.ItemName("MENDING VOLLEY", "HEALS ALLIES", 255, 0, 0, 0, 0)
    return TRUE
  if(element == WEAPON_VARIANT_UNHOLY)
    STANDARD.ItemName("LEECH GONNE", "DRAINS", DAMAGE_EDGE, 1, 3, 1, 2)
    return TRUE
  STANDARD.ItemName("GONNE", NULL, DAMAGE_EDGE, 2, 4, 1, 3)


//-----------------------------------------------------------------------
// Called to put item in character's hand
int ModelSetup()
  int self, grip

  grip = SystemGet(SYS_WEAPONGRIP, 0, 0)
  if(grip == MODEL_RIGHT_FILE)
    self = FindSelf()

    ModelAssign(self+grip, "FILE:GONNE.RDY")
    ModelAssign(self+grip+4, "FILE:DULL.RGB")
    ModelAssign(self+grip+8, "FILE:=GONNE.RGB")
    ModelAssign(self+grip+12, "FILE:WOODSHIN.RGB")
    ModelAssign(self+grip+16, "FILE:=GONNE.RGB")
    ModelAssign(self+grip+20, WHITE)


    // Modded Gonnes get a barrel in their element's colour...
    grip = VariantElement()
    if(grip == WEAPON_VARIANT_MAGIC)
      ModelAssign(self+MODEL_RIGHT_FILE+4, "FILE:GONDUL1.RGB")
    if(grip == WEAPON_VARIANT_FIRE)
      ModelAssign(self+MODEL_RIGHT_FILE+4, "FILE:GONDUL2.RGB")
    if(grip == WEAPON_VARIANT_ICE)
      ModelAssign(self+MODEL_RIGHT_FILE+4, "FILE:GONDUL3.RGB")
    if(grip == WEAPON_VARIANT_VOLT)
      ModelAssign(self+MODEL_RIGHT_FILE+4, "FILE:GONDUL4.RGB")
    if(grip == WEAPON_VARIANT_POISON)
      ModelAssign(self+MODEL_RIGHT_FILE+4, "FILE:GONDUL5.RGB")
    if(grip == WEAPON_VARIANT_HOLY)
      ModelAssign(self+MODEL_RIGHT_FILE+4, "FILE:GONDUL6.RGB")
    if(grip == WEAPON_VARIANT_UNHOLY)
      ModelAssign(self+MODEL_RIGHT_FILE+4, "FILE:GONDUL7.RGB")
  return TRUE


//-----------------------------------------------------------------------
// Called when attack particle is supposed to be spawned
int FrameEvent()
  int self, dex, element, child
  float vx, vy, vz


  self = FindSelf()
  dex = self.dex
  if(dex > 50)
    dex = 50


  // Aim at the best enemy target...
  AutoAim(1.5, 0.0, self.spin, self.team, dex, 8192 + (164*dex), AUTOAIM_CRUNCH)
  vx = AutoAim(0.0, 0.0, 0, 0, 0, 0, AUTOAIM_X)
  vy = AutoAim(0.0, 0.0, 0, 0, 0, 0, AUTOAIM_Y)
  vz = AutoAim(0.0, 0.0, 0, 0, 0, 0, AUTOAIM_Z)
  element = VariantElement()
  if(element == 0 || element == WEAPON_VARIANT_UNHOLY)
    // Normal bullet...  Leech rounds are normal bullets that drain...
    child = PGONNE.FrameEvent(vx, vy, vz)
    if(child && element)
      child.xhand = WEAPON_VARIANT_UNHOLY
    return TRUE
  SpecialShot(self, element, vx, vy, vz)
  return TRUE

//-----------------------------------------------------------------------
// Uses up to count rounds of ammo from the backpack...  Returns how many
// it found...
int UseAmmo(int self, int count)
  int i, used, item_type
  used = 0
  i = 224
  while(i < 246)
    item_type = ITEM_NONE
    if(i != 240 && i != 241)
      item_type = FileReadByte(self, i)
    if(used < count && item_type >= ITEM_AMMO_10 && item_type <= ITEM_AMMO_1)
      if(item_type == ITEM_AMMO_1)
        item_type = ITEM_NONE
      else
        item_type++
      FileWriteByte(self, i, item_type)
      used++
    else
      i++
  return used

//-----------------------------------------------------------------------
// Fires a modded Gonne's shot...  dx, dy, dz is the aim (any length)...
int SpecialShot(int self, int element, float dx, float dy, float dz)
  int index, used, i, child
  float x, y, z, sx, sy, length, a, tx, ty


  // Ammo...  Rockets take two rounds...
  used = 1
  if(element == WEAPON_VARIANT_FIRE)
    used = 2
  used = UseAmmo(self, used)
  if(used == 0)
    ButtonSound()
    self.action = ACTION_GONNE_NO_AMMO
    return FALSE


  // Unit aim, and a sideways vector for spreading shots...
  length = sqrt(dx*dx + dy*dy + dz*dz)
  if(length < 0.01)
    dx = self.frontx
    dy = self.fronty
    dz = 0.0
    length = 1.0
  dx = dx/length
  dy = dy/length
  dz = dz/length
  sx = -dy
  sy = dx
  index = FindIndex(self)
  x = self.x + (self.frontx*MUZZLE_OUT)
  y = self.y + (self.fronty*MUZZLE_OUT)
  z = self.z + (self.height*0.55)


  // Bang...
  PCASING.Effect(0, self.x + (self.frontx*0.8), self.y + (self.fronty*0.8), z)
  PEMBER.Effect(x, y, z, dx*0.05, dy*0.05, 0.0, 1.5, 192, 12, "FILE:FIRE0.RGB")
  PSMOKE.Effect(x, y, z, dx*0.05, dy*0.05, 0.02, 1.0, 0.05, FALSE, 128, 160, 30)


  if(element == WEAPON_VARIANT_MAGIC)
    // Missile Volley...  Three homing magic missiles...
    PlaySound("FILE:BAD3.RAW", 300 + RollDice(1, 40), 200)
    i = 0
    while(i < 3)
      a = (i-1)*0.5
      PMISSILE.DirectedEffect(x, y, z, (dx + sx*a)*0.35, (dy + sy*a)*0.35, dz*0.35, index, "FILE:SPARK5.RGB", "FILE:SPARK6.RGB")
      i++


  if(element == WEAPON_VARIANT_FIRE)
    // Homing Rocket...
    PlaySound("FILE:BAD3.RAW", 180 + RollDice(1, 20), 255)
    PGSHOT.Effect(x, y, z, dx*0.45, dy*0.45, dz*0.45, index, WEAPON_VARIANT_FIRE)
    if(used < 2)
      // Only had one round...  Weak rocket...  Still flies...
      ButtonSound()


  if(element == WEAPON_VARIANT_ICE)
    // Frost Blunderbuss...  Short, wide blast of frost that chills...
    PlaySound("FILE:-SPELL03.RAW", 200 + RollDice(1, 30), 255)
    i = 0
    while(i < 3)
      a = (i-1)*0.45
      tx = dx + (sx*a)
      ty = dy + (sy*a)
      child = PATTACK.Effect(x, y, z, tx*0.55, ty*0.55, dz*0.55, DAMAGE_ICE, 2, 1, 1.0, 0.15, 10, 0)
      if(child)
        child.xhand = XHAND_CHILL
      i++
    i = 0
    while(i < 14)
      a = (RollDice(1, 100) - 50) * 0.012
      tx = (dx + (sx*a)) * (0.25 + (RollDice(1, 100)*0.004))
      ty = (dy + (sy*a)) * (0.25 + (RollDice(1, 100)*0.004))
      PSMOKE.Effect(x, y, z, tx, ty, (RollDice(1, 100)-50)*0.002, 0.8, 0.08, FALSE, ICE_SMOKE_COLOR, 220, 18)
      if(i & 1)
        PEMBER.Effect(x, y, z, tx, ty, 0.0, 0.7, 255, 14, "FILE:ICE1.RGB")
      i++


  if(element == WEAPON_VARIANT_VOLT)
    // Arc Burst...  A short fan of lightning...
    PlaySound("FILE:-SHOCK.RAW", 245 + RollDice(1, 20), 255)
    SetSpawnTarget(65535)
    SetSpawnOwner(index)
    SetSpawnTeam(self.team)
    i = 0
    while(i < 4)
      a = (i*0.3) - 0.45
      child = Spawn(PARTICLE, x, y, z, "FILE:PZAPPY.RUN")
      if(child)
        child.vx = (dx + (sx*a)) * 1.1
        child.vy = (dy + (sy*a)) * 1.1
        child.vz = dz * 1.1
        child.length = 3.0
        child.width = 3.0
        child.image = NULL
        child.flags = PART_LIGHT_ON | PART_WALL_COLLISION_ON | PART_CHAR_COLLISION_ON
        child.team = self.team
        child.owner = index
        child.misc4 = 6       // Length of trail
        child.misc5 = 0       // Bright, straight-ish...
        child.misc6 = 14      // Time before poof...  Short range...
        child.misc7 = 64      // Charge (3 damage)
        child.evtimer = 1
        child.target = 65535
      i++


  if(element == WEAPON_VARIANT_POISON)
    // Venom darts...  Two, slightly apart...
    PlaySound("FILE:BAD3.RAW", 380 + RollDice(1, 40), 160)
    PGSHOT.Effect(x, y, z, (dx + sx*0.08)*0.9, (dy + sy*0.08)*0.9, dz*0.9, index, WEAPON_VARIANT_POISON)
    PGSHOT.Effect(x, y, z, (dx - sx*0.08)*0.9, (dy - sy*0.08)*0.9, dz*0.9, index, WEAPON_VARIANT_POISON)


  if(element == WEAPON_VARIANT_HOLY)
    // Mending Volley...  Three missiles that seek out hurt allies...
    PlaySound("FILE:-SPELL03.RAW", 330 + RollDice(1, 30), 200)
    i = 0
    while(i < 3)
      a = (i-1)*0.6
      PGSHOT.Effect(x, y, z, (dx + sx*a)*0.3, (dy + sy*a)*0.3, (dz*0.3)+0.05, index, WEAPON_VARIANT_HOLY)
      i++
  return TRUE

//-----------------------------------------------------------------------
// Called when item is first used, to start proper animation
int Event()
  int self, grip, reload_time, dex, i, found, item_type, index

  // Modify reload time by dexterity...
  self = FindSelf()
  grip = SystemGet(SYS_WEAPONGRIP, 0, 0)
  reload_time = WEAPON_RELOAD_LONG
  dex = self.dex
  if(dex > 50)
    dex = 50
  reload_time = reload_time - ((dex*reload_time)/50)


  if(self.action == ACTION_WALK || self.action == ACTION_STAND || self.action == ACTION_JUMP || self.action == ACTION_DOUBLE)
    if(grip == MODEL_RIGHT_FILE)
      if(self.rrtimer == 0)


        // Check for ammo in inventory...
        found = FALSE
        i = 224
        while(i < 246)
          if(i != 240 && i != 241)
            item_type = FileReadByte(self, i)
            if(item_type >= ITEM_AMMO_10 && item_type <= ITEM_AMMO_1)
              found = TRUE
              // Long reload on odd shots
              if(item_type & 1)
                self.rrtimer = reload_time
              i = 255
          i++


        // Fire off a shot...
        self.action = ACTION_GONNE_RIGHT
        self.daction = ACTION_STAND
        ButtonHandled()

//-----------------------------------------------------------------------
