//-----------------------------------------------------------------------
// <ZZ> Runes (the Wizard's Inscribe and the Mystic's Invoke, see
//      IMODIFY.SRC and IRUNE.SRC)...  A Blank Rune plus Magic Cores.
//      The extension is base + (rank*8) + element:
//          161-183  Wizard runes   Attack spells, each with a twist
//          185-207  Mystic runes   Turrets and monster forms
//      Rank I takes 1 core, Rank II 2 more, Rank III 3 more (all of the
//      rune's element).  Salvage gives every core back.
//      Design: rune-wheel-ideas.md
//
//      This file is also the script of every rune particle.  misc7 is
//      the particle's kind (RUNE_*), misc6 its rank (0-2), misc5 its age
//      or ticks, misc4 a helper value and misc0-3 a list of the last
//      characters it hurt (255 is an empty slot)...  These particles
//      never use image2 (it shares bytes with misc0-3)...
//-----------------------------------------------------------------------
#define ICE_SMOKE_COLOR  (4239600)
#define POISON_COLOR     (192<<8)
#define RUNE_CAST        1    // Short delay while the caster's hands move, then the spell...
#define RUNE_STAR        2    // Starfall spark
#define RUNE_STAR_SPLIT  3    // Rank III Starfall spark's split
#define RUNE_PHOENIX     4
#define RUNE_GLACIER     5    // Glacier Line crawler (invisible, raises the spikes)
#define RUNE_ICE_PATCH   6    // Rank III slippery ice
#define RUNE_STORM       7    // Storm Orb
#define RUNE_SEED_SHOT   8    // Leech Seed flying
#define RUNE_SEED        9    // Leech Seed planted in a foe
#define RUNE_HALO        10   // One Halo blade
#define RUNE_SINGULARITY 11
#define RUNE_SHRINE      20
#define RUNE_EYE         21   // Arcane Eye
#define RUNE_EYE_BOLT    22
#define RUNE_SPORE       23   // Spore Pod
#define RUNE_FORM        30   // Timer for a Mystic's monster form (morphs, then turns back)
#define EMPTY            255


//-----------------------------------------------------------------------
// TRUE if ext is an inscribed or invoked rune (not a blank one)...
int IsRune(int ext)
  ext = ext & 255
  if(ext > XITEM_RUNE_WIZARD_BASE && ext < (XITEM_RUNE_MYSTIC_BASE+24))
    if(ext & 7)
      return TRUE
  return FALSE

//-----------------------------------------------------------------------
// TRUE if ext is a Mystic rune...
int IsMysticRune(int ext)
  ext = ext & 255
  if(ext > XITEM_RUNE_MYSTIC_BASE && ext < (XITEM_RUNE_MYSTIC_BASE+24))
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// Rank of a rune, 0 (I) to 2 (III)...
int RuneRank(int ext)
  ext = ext & 255
  if(ext > XITEM_RUNE_MYSTIC_BASE)
    return ((ext - XITEM_RUNE_MYSTIC_BASE)>>3)
  return ((ext - XITEM_RUNE_WIZARD_BASE)>>3)

//-----------------------------------------------------------------------
// Element of a rune...
int RuneElement(int ext)
  return (ext & 7)

//-----------------------------------------------------------------------
// Cores spent on a rune so far (refunded by Salvage)...
int CoresSpent(int ext)
  int rank
  rank = RuneRank(ext)
  if(rank == 0)
    return 1
  if(rank == 1)
    return 3
  return 6

//-----------------------------------------------------------------------
// Mana a cast costs...
int ManaCost(int ext)
  return (2 + RuneRank(ext))

//-----------------------------------------------------------------------
// Second line of the name...
int RankName(int ext)
  int rank
  rank = RuneRank(ext)
  if(rank == 0)
    return "RANK I RUNE"
  if(rank == 1)
    return "RANK II RUNE"
  return "RANK III RUNE"

//-----------------------------------------------------------------------
// Spell name (generated by gen_rune.py)...
int Name(int ext)
  int element, rank
  element = RuneElement(ext)
  rank = RuneRank(ext)
  if(IsMysticRune(ext))
    if(element == 1)
      if(rank == 0)
        return "ARCANE EYE"
      if(rank == 1)
        return "ARCANE EYE"
      if(rank == 2)
        return "ARCANE EYE"
    if(element == 2)
      if(rank == 0)
        return "HOT DOG"
      if(rank == 1)
        return "RED WHELP"
      if(rank == 2)
        return "RED DRAGON"
    if(element == 3)
      if(rank == 0)
        return "WINTER WUFF"
      if(rank == 1)
        return "WINTER WUFF"
      if(rank == 2)
        return "WINTER WUFF"
    if(element == 4)
      if(rank == 0)
        return "DIRE WUFF"
      if(rank == 1)
        return "DIRE WUFF"
      if(rank == 2)
        return "DIRE WUFF"
    if(element == 5)
      if(rank == 0)
        return "SPORE POD"
      if(rank == 1)
        return "SPORE POD"
      if(rank == 2)
        return "SPORE POD"
    if(element == 6)
      if(rank == 0)
        return "SHRINE"
      if(rank == 1)
        return "SHRINE"
      if(rank == 2)
        return "SHRINE"
    if(element == 7)
      if(rank == 0)
        return "EYE BAT"
      if(rank == 1)
        return "PETRIFF EYE"
      if(rank == 2)
        return "PETRIFF EYE"
  if(element == 1)
    if(rank == 0)
      return "STARFALL"
    if(rank == 1)
      return "STARFALL"
    if(rank == 2)
      return "STARFALL"
  if(element == 2)
    if(rank == 0)
      return "PHOENIX"
    if(rank == 1)
      return "PHOENIX"
    if(rank == 2)
      return "PHOENIX"
  if(element == 3)
    if(rank == 0)
      return "GLACIER LINE"
    if(rank == 1)
      return "GLACIER LINE"
    if(rank == 2)
      return "GLACIER LINE"
  if(element == 4)
    if(rank == 0)
      return "STORM ORB"
    if(rank == 1)
      return "STORM ORB"
    if(rank == 2)
      return "STORM ORB"
  if(element == 5)
    if(rank == 0)
      return "LEECH SEED"
    if(rank == 1)
      return "LEECH SEED"
    if(rank == 2)
      return "LEECH SEED"
  if(element == 6)
    if(rank == 0)
      return "HALO"
    if(rank == 1)
      return "HALO"
    if(rank == 2)
      return "HALO"
  if(element == 7)
    if(rank == 0)
      return "SINGULARITY"
    if(rank == 1)
      return "SINGULARITY"
    if(rank == 2)
      return "SINGULARITY"
  return NULL

