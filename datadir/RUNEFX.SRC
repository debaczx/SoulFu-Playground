//-----------------------------------------------------------------------
// Generic helpers...
//-----------------------------------------------------------------------
int Foe(int holder, int who)
  if(holder && who)
    if(who.team != holder.team && who.team != TEAM_NEUTRAL && who.hits > 0)
      return TRUE
  return FALSE

//-----------------------------------------------------------------------
int Undead(int who)
  if(who.defwoun > 0 && who.defwoun < 128)
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// Damages character i with self (a particle) as the attacker...
int Hurt(int self, int i, int dtype, int damage, int wound)
  int old
  old = self.target
  self.target = i
  DamageTarget(dtype, damage, wound)
  self.target = old
  return TRUE

//-----------------------------------------------------------------------
// The hit list (misc0-3)...
int Listed(int self, int i)
  if(self.misc0 == i || self.misc1 == i || self.misc2 == i || self.misc3 == i)
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
int AddListed(int self, int i)
  // Oldest out first (it has usually moved away by then)...
  self.misc0 = self.misc1
  self.misc1 = self.misc2
  self.misc2 = self.misc3
  self.misc3 = i
  return TRUE

//-----------------------------------------------------------------------
int ClearListed(int self)
  self.misc0 = EMPTY
  self.misc1 = EMPTY
  self.misc2 = EMPTY
  self.misc3 = EMPTY
  return TRUE

//-----------------------------------------------------------------------
// Nearest foe of holder to a point, or 65535...  skip is a character to
// leave out...
int Nearest(int holder, float x, float y, float range, int skip)
  int i, who, best
  float dx, dy, dd, bestdd
  best = 65535
  bestdd = range*range
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(i != skip && Foe(holder, who))
      dx = who.x - x
      dy = who.y - y
      dd = dx*dx + dy*dy
      if(dd < bestdd)
        bestdd = dd
        best = i
    i++
  return best

//-----------------------------------------------------------------------
// The nth foe (wrapping around) within range of a point, or 65535...
// Lets a volley spread itself over the foes...
int NthFoe(int holder, float x, float y, float range, int n)
  int i, who, count, want
  float dx, dy
  count = 0
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(Foe(holder, who))
      dx = who.x - x
      dy = who.y - y
      if((dx*dx + dy*dy) < (range*range))
        count++
    i++
  if(count == 0)
    return 65535
  want = n % count
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(Foe(holder, who))
      dx = who.x - x
      dy = who.y - y
      if((dx*dx + dy*dy) < (range*range))
        if(want == 0)
          return i
        want--
    i++
  return 65535

//-----------------------------------------------------------------------
// Steers a particle straight at a character's middle...
int SteerAt(int self, int who, float speed)
  float dx, dy, dz, dist
  dx = who.x - self.x
  dy = who.y - self.y
  dz = (who.z + (who.height*0.5)) - self.z
  dist = sqrt(dx*dx + dy*dy + dz*dz)
  if(dist < 0.05)
    return FALSE
  self.vx = (dx/dist)*speed
  self.vy = (dy/dist)*speed
  self.vz = (dz/dist)*speed
  return TRUE

//-----------------------------------------------------------------------
// Spawns a rune particle (this file's script)...
int NewPart(int holder, int kind, int rank, float x, float y, float z, int image, float size)
  int child
  SetSpawnOwner(FindIndex(holder))
  SetSpawnTeam(holder.team)
  SetSpawnTarget(65535)
  child = Spawn(PARTICLE, x, y, z, 0)
  if(child)
    child.image = image
    child.flags = PART_LIGHT_ON
    child.length = size
    child.width = size
    child.alpha = 255
    child.team = holder.team
    child.owner = FindIndex(holder)
    child.target = 65535
    child.misc7 = kind
    child.misc6 = rank
    child.misc5 = 0
    child.misc4 = 0
    child.misc3 = EMPTY
    child.misc2 = EMPTY
    child.misc1 = EMPTY
    child.misc0 = EMPTY
    child.timer = 1
    child.vx = 0.0
    child.vy = 0.0
    child.vz = 0.0
  return child

//-----------------------------------------------------------------------
// Fades a particle out and poofs it...  TRUE once it's gone...
int Fade(int self, int amount)
  if(self.alpha <= amount)
    GoPoof(POOF_SELF)
    return TRUE
  self.alpha = self.alpha - amount
  return FALSE


//-----------------------------------------------------------------------
// Casting...
//-----------------------------------------------------------------------
// Called by IRUNE.Event (self is the caster, ext the rune)...  Pays the
// mana and starts the spell...
int Cast(int self, int ext)
  int index, child, cost
  if(!self)
    return FALSE
  if(self.action != ACTION_WALK && self.action != ACTION_STAND && self.action != ACTION_JUMP && self.action != ACTION_DOUBLE)
    return FALSE
  ButtonHandled()
  index = FindIndex(self)
  if(!IsRune(ext))
    // Blank...  Inscribe or Invoke it first...
    if(IndexIsLocalPlayer(index))
      BuzzerSound()
    return FALSE
  cost = ManaCost(ext)
  if(!MagicWillWork(self.manamax, self.mana, cost))
    if(IndexIsLocalPlayer(index))
      BuzzerSound()
    return FALSE
  if(IsMysticRune(ext) && FormScript(ext, 0))
    // Can't change form while already changed, or while riding...
    if(self.eflags & ENCHANT_FLAG_MORPH || FindByIndex(self.mount) || FindByIndex(self.rider))
      if(IndexIsLocalPlayer(index))
        BuzzerSound()
      return FALSE
  if(!STANDARD.ItemReload(self))
    return FALSE
  self.mana = self.mana - cost
  self.action = ACTION_MAGIC
  self.daction = ACTION_STAND
  SetSpawnOwner(index)
  SetSpawnTeam(self.team)
  PDELAY.Effect(ITEM_RUNE, self.x, self.y, self.z+self.height)
  child = NewPart(self, RUNE_CAST, RuneRank(ext), self.x, self.y, self.z, NULL, 0.0)
  if(child)
    child.flags = 0
    child.misc4 = ext & 255
    child.timer = 0
    child.evtimer = 15
  return TRUE

//-----------------------------------------------------------------------
// The spell goes off (self is the RUNE_CAST particle)...
int Release(int self, int holder, int ext)
  int rank, element, i, count, child, holder_index
  float x, y, z, fx, fy, angle
  rank = RuneRank(ext)
  element = RuneElement(ext)
  holder_index = FindIndex(holder)
  fx = holder.frontx
  fy = holder.fronty
  x = holder.x + fx
  y = holder.y + fy
  z = holder.z + (holder.height*0.7)
  if(IsMysticRune(ext))
    if(element == WEAPON_VARIANT_HOLY)
      return Turret(holder, RUNE_SHRINE, rank, "FILE:LITEBALL.RGB", 2.0, 0.6)
    if(element == WEAPON_VARIANT_MAGIC)
      return Turret(holder, RUNE_EYE, rank, "FILE:SPARK11.RGB", 1.8, 1.5)
    if(element == WEAPON_VARIANT_POISON)
      return Turret(holder, RUNE_SPORE, rank, "FILE:POISON1.RGB", 2.2, 0.8)
    // The rest are monster forms...
    child = NewPart(holder, RUNE_FORM, rank, holder.x, holder.y, holder.z, NULL, 0.0)
    if(child)
      child.flags = 0
      child.misc4 = ext & 255
      child.misc0 = holder_index
      child.target = holder_index
      child.timer = 0
      child.evtimer = 1
    return TRUE


  if(element == WEAPON_VARIANT_MAGIC)
    // Starfall...  Sparks shoot up, hang, then dive...
    PlaySound("FILE:-SPELL01.RAW", 300 + RollDice(1, 30), 220)
    count = 3
    if(rank == 1)
      count = 5
    if(rank == 2)
      count = 8
    i = 0
    while(i < count)
      child = NewPart(holder, RUNE_STAR, rank, x, y, z, "FILE:STAR0.RGB", 0.9)
      if(child)
        child.flags = PART_LIGHT_ON | PART_SPIN_ON
        child.vspin = 3000
        child.red = 255
        child.green = 190
        child.blue = 255
        child.misc4 = i
        angle = (i * 360.0) / count
        child.vx = sin(angle)*0.07
        child.vy = sin(angle+90.0)*0.07
        child.vz = 0.42 + (RollDice(1, 10)*0.01)
      i++
    return TRUE


  if(element == WEAPON_VARIANT_FIRE)
    // Phoenix...
    PlaySound("FILE:-SPELL02.RAW", 230 + RollDice(1, 20), 255)
    child = NewPart(holder, RUNE_PHOENIX, rank, x + fx, y + fy, z, "FILE:FIRE2.RGB", 2.6)
    if(child)
      child.vx = fx*0.55
      child.vy = fy*0.55
    return TRUE


  if(element == WEAPON_VARIANT_ICE)
    // Glacier Line...
    PlaySound("FILE:-SPELL03.RAW", 200 + RollDice(1, 20), 255)
    child = NewPart(holder, RUNE_GLACIER, rank, holder.x + (fx*1.5), holder.y + (fy*1.5), holder.z + 0.3, NULL, 0.0)
    if(child)
      child.flags = PART_WALL_COLLISION_ON
      child.vx = fx*0.45
      child.vy = fy*0.45
    return TRUE


  if(element == WEAPON_VARIANT_VOLT)
    // Storm Orb...
    PlaySound("FILE:-SHOCK.RAW", 200 + RollDice(1, 20), 255)
    child = NewPart(holder, RUNE_STORM, rank, x + fx, y + fy, z, "FILE:SPARK3.RGB", 2.2)
    if(child)
      child.flags = PART_LIGHT_ON | PART_SPIN_ON | PART_WALL_COLLISION_ON
      child.vspin = 2500
      child.vx = fx*0.05
      child.vy = fy*0.05
      child.timer = 2
    return TRUE


  if(element == WEAPON_VARIANT_POISON)
    // Leech Seed...
    PlaySound("FILE:-SPELL03.RAW", 280 + RollDice(1, 20), 220)
    i = Nearest(holder, holder.x + (fx*6.0), holder.y + (fy*6.0), 9.0, 65535)
    return SeedShot(holder, rank, x, y, z, i, fx*0.6, fy*0.6)


  if(element == WEAPON_VARIANT_HOLY)
    // Halo...
    PlaySound("FILE:-SPELL01.RAW", 260 + RollDice(1, 20), 255)
    count = 2
    if(rank == 1)
      count = 4
    if(rank == 2)
      count = 6
      HEALFX.Ward(holder)
    i = 0
    while(i < count)
      child = NewPart(holder, RUNE_HALO, rank, holder.x, holder.y, z, "FILE:SPARK4.RGB", 1.3)
      if(child)
        child.flags = PART_LIGHT_ON | PART_SPIN_ON
        child.vspin = 4000
        child.misc4 = (i * 256) / count
        child.evtimer = 360 + (rank*60)
      i++
    return TRUE


  // Singularity...
  PlaySound("FILE:-SPELL02.RAW", 160 + RollDice(1, 20), 255)
  child = NewPart(holder, RUNE_SINGULARITY, rank, x + fx, y + fy, z, "FILE:SPARK6.RGB", 1.2)
  if(child)
    child.flags = PART_LIGHT_ON | PART_SPIN_ON | PART_WALL_COLLISION_ON
    child.vspin = 6000
    child.vx = fx*0.4
    child.vy = fy*0.4
  return TRUE


//-----------------------------------------------------------------------
// Wizard spells...
//-----------------------------------------------------------------------
// Starfall spark (and its Rank III splits)...
int DoStar(int self)
  int holder, who
  holder = FindOwner()
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.timer = 1
  if(self.misc5 < 250)
    self.misc5++
  if((self.misc5 & 3) == 0)
    PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.0, 0.5, self.alpha, 16, "FILE:SPARK5.RGB")
  if(self.misc5 < 18)
    // Rising...
    self.vx = self.vx*0.92
    self.vy = self.vy*0.92
    self.vz = self.vz*0.92
    return TRUE
  if(self.misc5 < 30)
    // Hanging...
    self.vx = self.vx*0.6
    self.vy = self.vy*0.6
    self.vz = self.vz*0.6
    return TRUE
  if(self.misc5 == 30)
    self.target = NthFoe(holder, self.x, self.y, 18.0, self.misc4)
    self.flags = PART_LIGHT_ON | PART_SPIN_ON | PART_CHAR_COLLISION_ON | PART_WALL_COLLISION_ON
    if(self.target < MAX_CHARACTER)
      PlaySound("FILE:-SPELL01.RAW", 380 + RollDice(1, 40), 120)
  if(self.misc5 > 150)
    Fade(self, 25)
    return TRUE
  who = FindTarget()
  if(!Foe(holder, who))
    self.target = Nearest(holder, self.x, self.y, 18.0, 65535)
    who = FindTarget()
  if(who)
    SteerAt(self, who, 0.75)
  else
    if(self.misc5 < 120)
      self.misc5 = 120
    self.vz = self.vz - 0.01
  return TRUE

//-----------------------------------------------------------------------
int StarHit(int self, int holder, int who)
  int i, child
  Hurt(self, FindIndex(who), DAMAGE_BASH, RollDice(1, 3)+1, 1)
  PSPARK.Effect(self.x, self.y, self.z, 10, 2)
  PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.0, 4.0, 255, 16, "FILE:SPARK5.RGB")
  if(self.misc7 == RUNE_STAR && self.misc6 == 2)
    // Splits into two smaller sparks that find other foes...
    i = 0
    while(i < 2)
      child = NewPart(holder, RUNE_STAR_SPLIT, 2, self.x, self.y, self.z + 1.0, "FILE:STAR0.RGB", 0.55)
      if(child)
        child.flags = PART_LIGHT_ON | PART_SPIN_ON
        child.vspin = 3000
        child.red = 255
        child.green = 190
        child.blue = 255
        child.misc4 = i + 1
        child.misc5 = 22
        child.vx = (RollDice(1, 21)-11)*0.02
        child.vy = (RollDice(1, 21)-11)*0.02
        child.vz = 0.25
      i++
  GoPoof(POOF_SELF)
  return TRUE

//-----------------------------------------------------------------------
// Phoenix...  misc4 is the phase: 0 out, 1 back, 2 circling, 3 fading...
int DoPhoenix(int self)
  int holder, i, who
  float dx, dy, dist, angle
  holder = FindOwner()
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.timer = 1
  if(self.misc5 < 250)
    self.misc5++
  if(self.misc4 == 3)
    Fade(self, 20)
    return TRUE
  if((self.misc5 & 1) == 0)
    PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.03, 1.4, 220, 14, "FILE:FIRE1.RGB")
  if(self.misc4 == 0 && self.misc5 >= 30)
    ClearListed(self)
    self.misc5 = 0
    if(self.misc6 == 0)
      self.misc4 = 3
    if(self.misc6 == 1)
      self.misc4 = 1
      PlaySound("FILE:-SPELL02.RAW", 260 + RollDice(1, 20), 200)
    if(self.misc6 == 2)
      self.misc4 = 2
      PlaySound("FILE:-SPELL02.RAW", 260 + RollDice(1, 20), 200)
    return TRUE
  if(self.misc4 == 1)
    // Flying back to the caster...
    dx = holder.x - self.x
    dy = holder.y - self.y
    dist = sqrt(dx*dx + dy*dy)
    if(dist < 1.5 || self.misc5 > 90)
      self.misc4 = 3
      return TRUE
    self.vx = (dx/dist)*0.6
    self.vy = (dy/dist)*0.6
    self.vz = ((holder.z + (holder.height*0.7)) - self.z)*0.1
  if(self.misc4 == 2)
    // Circling the caster twice (60 steps a lap), then bursting...
    if(self.misc5 == 60)
      ClearListed(self)
    if(self.misc5 >= 120)
      PEXPLODE.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.0, DAMAGE_FIRE, 4, 2, self.owner, self.team, "FILE:FIRE1.RGB", 128, 150)
      self.misc4 = 3
      self.alpha = 120
      return TRUE
    angle = self.misc5 * 6.0
    self.vx = 0.0
    self.vy = 0.0
    self.vz = 0.0
    self.x = holder.x + (sin(angle)*5.0)
    self.y = holder.y + (sin(angle+90.0)*5.0)
    self.z = holder.z + 2.0
  // Burns whatever it passes through (not right after turning, it
  // would hit the same foes twice)...
  if(self.misc4 != 0 && self.misc5 < 8)
    return TRUE
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(Foe(holder, who))
      dx = who.x - self.x
      dy = who.y - self.y
      if(dx*dx + dy*dy < 4.0 && self.z > (who.z - 1.5) && self.z < (who.z + who.height + 2.5))
        if(!Listed(self, i))
          AddListed(self, i)
          Hurt(self, i, DAMAGE_FIRE, RollDice(1, 2)+1, 1)
          PGSHOT.Burn(i, self.owner, 3)
    i++
  return TRUE

//-----------------------------------------------------------------------
// Glacier Line crawler...  Runs along the ground raising ice spikes...
int DoGlacier(int self)
  int holder, i, who, span, cold, child
  float dx, dy
  holder = FindOwner()
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.timer = 1
  self.misc5++
  span = 22
  if(self.misc6 > 0)
    span = 40
  if(self.misc5 > span)
    GoPoof(POOF_SELF)
    return TRUE
  if((self.misc5 & 1) == 0)
    PEMBER.Effect(self.x, self.y, self.z + 0.4, 0.0, 0.0, 0.10, 1.6, 255, 10, "FILE:ICE1.RGB")
    PSMOKE.Effect(self.x, self.y, self.z + 0.5, 0.0, 0.0, 0.02, 1.2, 0.05, FALSE, ICE_SMOKE_COLOR, 160, 20)
  if((self.misc5 & 3) == 0)
    PEMBER.Effect(self.x, self.y, self.z + 0.6, 0.0, 0.0, 0.16, 1.1, 255, 12, "FILE:LITESPLI.RGB")
  if(self.misc6 == 2 && (self.misc5 % 6) == 0)
    // Slippery ice left behind...
    child = NewPart(holder, RUNE_ICE_PATCH, 2, self.x, self.y, self.z + 0.1, "FILE:ICE0.RGB", 2.4)
    if(child)
      child.flags = PART_LIGHT_ON | PART_FLAT_ON
      child.alpha = 150
      child.timer = 15
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(Foe(holder, who))
      dx = who.x - self.x
      dy = who.y - self.y
      if(dx*dx + dy*dy < 3.2 && !Listed(self, i))
        AddListed(self, i)
        cold = SWORDFX.Chilled(who)
        if(self.misc6 == 2)
          if(cold)
            // Shatters a foe that was already cold...
            Hurt(self, i, DAMAGE_ICE, RollDice(1, 3)+3, 1)
            PEMBER.Effect(who.x, who.y, who.z+1.0, 0.0, 0.0, 0.08, 3.0, 255, 10, "FILE:LITESPLI.RGB")
          else
            Hurt(self, i, DAMAGE_ICE, RollDice(1, 2)+1, 0)
          XITEM.Chill(who, CHILL_TIME*3)
        else
          Hurt(self, i, DAMAGE_ICE, RollDice(1, 2)+1, 0)
          XITEM.Chill(who, CHILL_TIME)
    i++
  return TRUE

//-----------------------------------------------------------------------
// Rank III slippery ice...  Keeps chilling foes standing on it...
int DoIcePatch(int self)
  int holder, i, who
  float dx, dy
  holder = FindOwner()
  self.timer = 15
  self.misc5++
  if(!holder || self.misc5 > 20)
    GoPoof(POOF_SELF)
    return TRUE
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(Foe(holder, who))
      dx = who.x - self.x
      dy = who.y - self.y
      if(dx*dx + dy*dy < 2.6 && who.z < (self.z + 1.5))
        if(SWORDFX.Chilled(who) < 60)
          XITEM.Chill(who, 60)
    i++
  if(self.misc5 > 16)
    self.alpha = self.alpha - 30
  return TRUE

//-----------------------------------------------------------------------
// Zaps a foe from a point (a lightning bolt owned by holder)...  power is
// the bolt's misc7 (48 hits for 2, 80 for 3, 112 for 4)...
int ZapFrom(int holder, float x, float y, float z, int who, int power)
  int child
  float dx, dy, sl
  dx = who.x - x
  dy = who.y - y
  sl = sqrt(dx*dx + dy*dy)
  if(sl < 0.1)
    return FALSE
  dx = dx/sl
  dy = dy/sl
  child = DWARFFX.Zap(holder, x + dx, y + dy, z, dx*1.2, dy*1.2, 22)
  if(child)
    child.misc7 = power
  return TRUE

//-----------------------------------------------------------------------
// Storm Orb...  Ticks every 2 frames...  Drifts toward the nearest foe and
// zaps up to 1/2/3 foes around it every 12 frames...
int DoStorm(int self)
  int holder, i, first, second, life, count, power, who
  float dx, dy, dist
  holder = FindOwner()
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.timer = 2
  self.misc5++
  life = 120 + (self.misc6*30)
  power = 48
  if(self.misc6 > 0)
    power = 80
  if((self.misc5 & 3) == 0)
    PEMBER.Effect(self.x, self.y, self.z, (RollDice(1, 21)-11)*0.01, (RollDice(1, 21)-11)*0.01, 0.02, 0.8, 255, 20, "FILE:SPARK2.RGB")
  if(self.misc5 >= life)
    if(self.misc6 == 2)
      // Bursts into chain lightning...
      PlaySound("FILE:-SHOCK.RAW", 240 + RollDice(1, 20), 255)
      PSPARK.Effect(self.x, self.y, self.z, 20, 4)
      count = 0
      while(count < 6)
        i = NthFoe(holder, self.x, self.y, 12.0, count)
        if(i < MAX_CHARACTER)
          ZapFrom(holder, self.x, self.y, self.z, FindByIndex(i), 112)
        count++
    GoPoof(POOF_SELF)
    return TRUE
  if((self.misc5 % 3) == 0)
    // Drifts toward the nearest foe (slower than a walk)...
    i = Nearest(holder, self.x, self.y, 14.0, 65535)
    if(i < MAX_CHARACTER)
      who = FindByIndex(i)
      dx = who.x - self.x
      dy = who.y - self.y
      dist = sqrt(dx*dx + dy*dy)
      if(dist > 2.0)
        self.vx = (self.vx*0.8) + ((dx/dist)*0.02)
        self.vy = (self.vy*0.8) + ((dy/dist)*0.02)
      else
        self.vx = self.vx*0.5
        self.vy = self.vy*0.5
  if((self.misc5 % 6) == 0)
    i = Nearest(holder, self.x, self.y, 9.0, 65535)
    if(i < MAX_CHARACTER)
      PlaySound("FILE:-SHOCK.RAW", 300 + RollDice(1, 40), 120)
      ZapFrom(holder, self.x, self.y, self.z, FindByIndex(i), power)
      if(self.misc6 > 0)
        first = Nearest(holder, self.x, self.y, 9.0, i)
        if(first < MAX_CHARACTER)
          ZapFrom(holder, self.x, self.y, self.z, FindByIndex(first), power)
          if(self.misc6 == 2)
            count = 0
            while(count < 3)
              second = NthFoe(holder, self.x, self.y, 9.0, count)
              if(second < MAX_CHARACTER && second != i && second != first)
                ZapFrom(holder, self.x, self.y, self.z, FindByIndex(second), power)
                count = 3
              count++
  return TRUE

//-----------------------------------------------------------------------
// A flying Leech Seed...  target is the foe it chases (65535 for none)...
int SeedShot(int holder, int rank, float x, float y, float z, int who_index, float vx, float vy)
  int child
  child = NewPart(holder, RUNE_SEED_SHOT, rank, x, y, z, "FILE:SPARK10.RGB", 0.9)
  if(child)
    child.flags = PART_LIGHT_ON | PART_SPIN_ON | PART_CHAR_COLLISION_ON | PART_WALL_COLLISION_ON
    child.vspin = 5000
    child.vx = vx
    child.vy = vy
    child.target = who_index
  return child

//-----------------------------------------------------------------------
int DoSeedShot(int self)
  int holder, who
  holder = FindOwner()
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.timer = 1
  self.misc5++
  if(self.misc5 > 90)
    Fade(self, 40)
    return TRUE
  if((self.misc5 & 3) == 0)
    PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.0, 0.5, 200, 16, "FILE:POISON1.RGB")
  who = FindTarget()
  if(Foe(holder, who))
    SteerAt(self, who, 0.6)
  return TRUE

//-----------------------------------------------------------------------
// The seed takes root in a foe...
int Plant(int self, int who)
  self.misc7 = RUNE_SEED
  self.flags = PART_LIGHT_ON | PART_SPIN_ON
  self.target = FindIndex(who)
  self.vx = 0.0
  self.vy = 0.0
  self.vz = 0.0
  self.misc5 = 0
  self.timer = 15
  self.length = 1.2
  self.width = 1.2
  PlaySound("FILE:-SPELL03.RAW", 330 + RollDice(1, 20), 200)
  PEMBER.Effect(who.x, who.y, who.z + who.height, 0.0, 0.0, 0.05, 2.5, 255, 12, "FILE:POISON1.RGB")
  STANDARD.PoisonCharacter(self.target, self.owner, 60)
  return TRUE

//-----------------------------------------------------------------------
// A planted seed...  Ticks every 15 frames for 6 seconds...
int DoSeed(int self)
  int holder, who, i, n, drain
  holder = FindOwner()
  who = FindTarget()
  self.timer = 15
  self.misc5++
  if(!holder || !who)
    GoPoof(POOF_SELF)
    return FALSE
  if(who.hits == 0)
    if(self.misc6 == 2)
      // Jumps to the nearest foes...
      n = 0
      while(n < 2)
        i = NthFoe(holder, who.x, who.y, 10.0, n)
        if(i < MAX_CHARACTER && i != self.target)
          SeedShot(holder, 2, who.x, who.y, who.z + who.height, i, 0.0, 0.0)
        n++
    GoPoof(POOF_SELF)
    return TRUE
  if(self.misc5 > 24)
    GoPoof(POOF_SELF)
    return TRUE
  self.x = who.x
  self.y = who.y
  self.z = who.z + who.height + 0.4
  if((self.misc5 & 1) == 0)
    STANDARD.PoisonCharacter(self.target, self.owner, 60)
  drain = 4
  if(self.misc6 > 0)
    drain = 2
  if((self.misc5 % drain) == 0)
    DWARFFX.Drain(holder, who, 1)
  return TRUE

//-----------------------------------------------------------------------
// A Halo blade circling the caster...  misc4 is its angle (256 a lap)...
// A blade breaks on the first foe it cuts.  When the Halo's time is up,
// the blades still circling fly off at the nearest foes (misc5 255)...
int DoHalo(int self)
  int holder, i, who, damage, wound
  float dx, dy, angle
  holder = FindOwner()
  if(!holder || holder.hits == 0)
    GoPoof(POOF_SELF)
    return FALSE
  self.timer = 1
  if(self.misc5 == 255)
    // Flying off...
    if(self.evtimer == 0)
      GoPoof(POOF_SELF)
      return TRUE
    who = FindTarget()
    if(Foe(holder, who))
      SteerAt(self, who, 0.7)
    else
      Fade(self, 20)
      return TRUE
  else
    self.misc4 = (self.misc4 + 3) & 255
    angle = self.misc4 * 1.40625
    self.x = holder.x + (sin(angle)*2.6)
    self.y = holder.y + (sin(angle+90.0)*2.6)
    self.z = holder.z + 1.8
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(Foe(holder, who))
      dx = who.x - self.x
      dy = who.y - self.y
      if(dx*dx + dy*dy < 2.0 && self.z > (who.z - 1.0) && self.z < (who.z + who.height + 1.5))
        damage = RollDice(1, 2)+1
        wound = 1
        if(Undead(who))
          damage = damage + 2
          wound = 2
        Hurt(self, i, DAMAGE_EDGE, damage, wound)
        PlaySound("FILE:-SPELL01.RAW", 420 + RollDice(1, 40), 140)
        PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.05, 2.5, 255, 12, "FILE:SPARK4.RGB")
        GoPoof(POOF_SELF)
        return TRUE
    i++
  return TRUE

//-----------------------------------------------------------------------
// The Halo's time is up...  The blade flies at the nearest foe, if any...
int HaloEnd(int self)
  int holder, i
  holder = FindOwner()
  i = 65535
  if(holder && self.misc5 != 255)
    i = NthFoe(holder, self.x, self.y, 12.0, self.misc4 >> 5)
  if(i >= MAX_CHARACTER)
    GoPoof(POOF_SELF)
    return TRUE
  self.misc5 = 255
  self.target = i
  self.evtimer = 90
  PlaySound("FILE:-SPELL01.RAW", 380 + RollDice(1, 40), 160)
  return TRUE

//-----------------------------------------------------------------------
// Singularity...  Flies 18 frames, pulls for 90, then implodes...
int DoSingularity(int self)
  int holder, i, who
  float dx, dy, dist, range, angle, pull
  holder = FindOwner()
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.timer = 1
  self.misc5++
  range = 5.0
  if(self.misc6 == 1)
    range = 7.0
  if(self.misc6 == 2)
    range = 9.5
  if(self.misc5 == 18)
    self.vx = 0.0
    self.vy = 0.0
    self.vz = 0.0
    PlaySound("FILE:-SPELL02.RAW", 140 + RollDice(1, 20), 255)
  if(self.misc5 < 18)
    return TRUE
  if(self.misc5 < 108)
    // Pulling...
    if(self.length < 3.0)
      self.length = self.length + 0.03
      self.width = self.length
    if((self.misc5 % 3) == 0)
      angle = RollDice(1, 360) * 1.0
      PEMBER.Effect(self.x + (sin(angle)*range), self.y + (sin(angle+90.0)*range), self.z, -sin(angle)*range*0.06, -sin(angle+90.0)*range*0.06, 0.0, 1.0, 255, 14, "FILE:SPARK6.RGB")
    i = 0
    while(i < MAX_CHARACTER)
      who = FindByIndex(i)
      if(Foe(holder, who))
        dx = self.x - who.x
        dy = self.y - who.y
        dist = sqrt(dx*dx + dy*dy)
        if(dist < range && dist > 0.8)
          pull = 0.22
          who.vx = (who.vx*0.5) + ((dx/dist)*pull)
          who.vy = (who.vy*0.5) + ((dy/dist)*pull)
      i++
    return TRUE
  // Implodes...
  PlaySound("FILE:BAD4.RAW", 160 + RollDice(1, 20), 255)
  SystemSet(SYS_SCREENSHAKE, 0, 2, 12)
  PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.0, range*1.2, 255, 10, "FILE:SPARK6.RGB")
  PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.0, range*0.8, 255, 8, "FILE:SPARK8.RGB")
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(Foe(holder, who))
      dx = self.x - who.x
      dy = self.y - who.y
      if((dx*dx + dy*dy) < (range*range))
        Hurt(self, i, DAMAGE_EDGE, RollDice(1, 3)+2, 2)
        if(self.misc6 > 0)
          HEALFX.Hex(holder, who)
        if(self.misc6 == 2)
          DWARFFX.KnockDown(who, self.x, self.y)
    i++
  GoPoof(POOF_SELF)
  return TRUE


//-----------------------------------------------------------------------
// Mystic turrets...
//-----------------------------------------------------------------------
// Places a turret in front of the caster...  Rank I and II allow one at
// a time, Rank III two (the oldest crumbles to make room)...
int Turret(int holder, int kind, int rank, int image, float size, float lift)
  int i, child, count, oldest, holder_index, kind_seen, limit
  float x, y, z
  holder_index = FindIndex(holder)
  limit = 1
  if(rank == 2)
    limit = 2
  count = 0
  oldest = NULL
  i = 0
  while(i < MAX_PARTICLE)
    child = FindParticle(i)
    if(child)
      if(child.owner == holder_index && child.misc7 >= RUNE_SHRINE && child.misc7 <= RUNE_SPORE && child.misc7 != RUNE_EYE_BOLT)
        if(SystemGet(SYS_PARTICLESCRIPTFILE, 0, i) == "FILE:RUNEFX.RUN")
          if(child.evtimer > 1)
            count++
            if(oldest == NULL)
              oldest = child
            else
              if(child.evtimer < oldest.evtimer)
                oldest = child
    i++
  if(count >= limit && oldest)
    oldest.evtimer = 1
  x = holder.x + (holder.frontx*3.0)
  y = holder.y + (holder.fronty*3.0)
  z = holder.z + lift
  if(kind == RUNE_EYE)
    // Rises from the caster's hands...
    x = holder.x + holder.frontx
    y = holder.y + holder.fronty
  PlaySound("FILE:-SPELL01.RAW", 220 + RollDice(1, 20), 255)
  PEMBER.Effect(x, y, z, 0.0, 0.0, 0.05, 4.0, 255, 10, "FILE:LITESPRK.RGB")
  child = NewPart(holder, kind, rank, x, y, z, image, size)
  if(child)
    child.flags = PART_LIGHT_ON
    child.timer = 15
    child.evtimer = 600 + (rank*300)
    if(kind == RUNE_SHRINE)
      child.red = 255
      child.green = 215
      child.blue = 120
      if(rank == 2)
        Wards(holder, x, y)
    if(kind == RUNE_EYE)
      child.red = 210
      child.green = 170
      child.blue = 255
      child.timer = 10
      child.vz = 0.06
    if(kind == RUNE_SPORE)
      child.red = 140
      child.green = 255
      child.blue = 110
  return child

//-----------------------------------------------------------------------
// Gives allies near a point a deflect sphere (Rank III Shrine)...
int Wards(int holder, float x, float y)
  int i, who
  float dx, dy
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(who)
      if(who.team == holder.team && who.hits > 0)
        dx = who.x - x
        dy = who.y - y
        if((dx*dx + dy*dy) < 36.0)
          HEALFX.Ward(who)
    i++
  return TRUE

//-----------------------------------------------------------------------
// Shrine...  Ticks every 15 frames...  Heals allies around it every 3
// ticks (Rank II every 2, Rank III every tick and wards them every 4
// seconds)...
int DoShrine(int self)
  int holder, every
  holder = FindOwner()
  self.timer = 15
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.misc5++
  every = 3 - self.misc6
  PEMBER.Effect(self.x, self.y, self.z + 0.5, 0.0, 0.0, 0.05, 1.0, 220, 10, "FILE:SPARK4.RGB")
  PEMBER.Effect(self.x + ((RollDice(1, 21)-11)*0.05), self.y + ((RollDice(1, 21)-11)*0.05), self.z, 0.0, 0.0, 0.12, 0.8, 200, 8, "FILE:SPARK4.RGB")
  if((self.misc5 % every) == 0)
    PEMBER.Effect(self.x, self.y, self.z - 0.4, 0.0, 0.0, 0.0, 8.0, 140, 14, "FILE:LITERING.RGB")
    HEALFX.Area(holder, self.x, self.y, 8.0, 4, 1 + (self.misc6 >> 1), 65535)
  if(self.misc6 == 2 && (self.misc5 % 16) == 0)
    Wards(holder, self.x, self.y)
  return TRUE

//-----------------------------------------------------------------------
// Arcane Eye...  Ticks every 10 frames...  Rises up over the caster, then
// shoots bolts that fly up and home in on foes anywhere in sight (Rank
// III shoots two at different foes)...
int DoEye(int self)
  int holder, i, every, count, first
  holder = FindOwner()
  self.timer = 10
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.misc5++
  if(self.misc5 < 7)
    // Still rising...
    self.vz = 0.06
    PEMBER.Effect(self.x, self.y, self.z - 0.5, 0.0, 0.0, -0.02, 1.0, 200, 12, "FILE:SPARK5.RGB")
    return TRUE
  self.vz = sin(self.misc5 * 20.0) * 0.01
  every = 4
  if(self.misc6 > 0)
    every = 3
  if((self.misc5 % every) != 0)
    return TRUE
  first = 65535
  count = 1
  if(self.misc6 == 2)
    count = 2
  while(count > 0)
    i = NthFoe(holder, self.x, self.y, 26.0, (self.misc5 / every) + count)
    if(i == first)
      i = Nearest(holder, self.x, self.y, 26.0, first)
    if(i < MAX_CHARACTER)
      EyeBolt(self, holder, i)
      first = i
    count--
  return TRUE

//-----------------------------------------------------------------------
// A bolt from the Arcane Eye at foe i...  Shoots up, then dives...
int EyeBolt(int self, int holder, int i)
  int child
  PlaySound("FILE:-SPELL01.RAW", 360 + RollDice(1, 40), 140)
  child = NewPart(holder, RUNE_EYE_BOLT, self.misc6, self.x, self.y, self.z + 0.5, "FILE:SPARK5.RGB", 0.9)
  if(child)
    child.flags = PART_LIGHT_ON | PART_CHAR_COLLISION_ON
    child.red = 230
    child.green = 190
    child.blue = 255
    child.vx = (RollDice(1, 21)-11)*0.02
    child.vy = (RollDice(1, 21)-11)*0.02
    child.vz = 0.35
    child.trail = 220
    child.target = i
    child.evtimer = 150
  return child

//-----------------------------------------------------------------------
// Eye bolt flying...
int DoEyeBolt(int self)
  int holder, who
  float dx, dy, dz, dist
  holder = FindOwner()
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.timer = 1
  if(self.misc5 < 250)
    self.misc5++
  if((self.misc5 & 1) == 0)
    PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.0, 0.5, 220, 14, "FILE:SPARK5.RGB")
  if(self.misc5 < 14)
    // Climbing...
    self.vz = self.vz*0.88
    return TRUE
  if(self.misc5 == 14)
    self.flags = PART_LIGHT_ON | PART_CHAR_COLLISION_ON | PART_WALL_COLLISION_ON
  who = FindTarget()
  if(!Foe(holder, who))
    self.target = Nearest(holder, self.x, self.y, 26.0, 65535)
    who = FindTarget()
  if(!who)
    Fade(self, 20)
    return TRUE
  // Turns toward the foe a little at a time...
  dx = who.x - self.x
  dy = who.y - self.y
  dz = (who.z + (who.height*0.5)) - self.z
  dist = sqrt(dx*dx + dy*dy + dz*dz)
  if(dist > 0.05)
    self.vx = (self.vx*0.8) + ((dx/dist)*0.16)
    self.vy = (self.vy*0.8) + ((dy/dist)*0.16)
    self.vz = (self.vz*0.8) + ((dz/dist)*0.16)
  return TRUE

//-----------------------------------------------------------------------
// Spore Pod...  Ticks every 15 frames...  Lobs poison balls...
int DoSpore(int self)
  int holder, i, who, every
  float dx, dy, dist, t
  holder = FindOwner()
  self.timer = 15
  if(!holder)
    GoPoof(POOF_SELF)
    return FALSE
  self.misc5++
  every = 4
  if(self.misc6 > 0)
    every = 3
  self.length = 2.2 + (sin(self.misc5 * 30.0)*0.15)
  self.width = self.length
  if((self.misc5 % every) != 0)
    return TRUE
  i = Nearest(holder, self.x, self.y, 16.0, 65535)
  if(i >= MAX_CHARACTER)
    return TRUE
  who = FindByIndex(i)
  // Gravity is 0.004 a frame, so a 0.18 lob lands back at its own height
  // after 90 frames...
  t = 90.0
  dx = (who.x - self.x)/t
  dy = (who.y - self.y)/t
  PPSNBALL.ShotEffect(self.x, self.y, self.z + 0.8, dx, dy, 0.18, self.owner, 80)
  return TRUE

//-----------------------------------------------------------------------
// A turret's time is up...
int TurretEnd(int self)
  int holder, i
  float angle
  holder = FindOwner()
  PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.03, 3.0, 255, 12, "FILE:LITESPRK.RGB")
  if(self.misc7 == RUNE_SPORE && self.misc6 == 2 && holder)
    // Bursts into a big poison cloud...
    i = 0
    while(i < 6)
      angle = i * 60.0
      PPSNBALL.ShotEffect(self.x, self.y, self.z + 0.8, sin(angle)*0.06, sin(angle+90.0)*0.06, 0.12, self.owner, 120)
      i++
  GoPoof(POOF_SELF)
  return TRUE


//-----------------------------------------------------------------------
// Mystic monster forms...
//-----------------------------------------------------------------------
// Script and subtype (spawn eqcol01) of the form a Mystic rune turns its
// caster into...  Returns the script, or NULL if the rune makes a turret.
// want_subtype TRUE returns the subtype instead...
int FormScript(int ext, int want_subtype)
  int element, rank
  element = RuneElement(ext)
  rank = RuneRank(ext)
  if(element == WEAPON_VARIANT_FIRE)
    if(rank == 0)
      if(want_subtype)
        return 192  // Hot Dog
      return "FILE:CWUFF.RUN"
    if(rank == 1)
      if(want_subtype)
        return 0    // Red Whelp
      return "FILE:CWHELP.RUN"
    if(want_subtype)
      return 0      // Red Dragon
    return "FILE:CDRAGON.RUN"
  if(element == WEAPON_VARIANT_ICE)
    if(want_subtype)
      return 128    // Winter Wuff
    return "FILE:CWUFF.RUN"
  if(element == WEAPON_VARIANT_VOLT)
    if(want_subtype)
      return 64     // Dire Wuff
    return "FILE:CWUFF.RUN"
  if(element == WEAPON_VARIANT_UNHOLY)
    if(want_subtype)
      if(rank == 0)
        return 0    // Eye Bat
      return 64     // Petriff Eye
    return "FILE:CEYEBAT.RUN"
  return NULL

//-----------------------------------------------------------------------
// Rune of a monster form (0 if it isn't one)...
int FormOf(int who)
  if(who)
    if(who.eflags & ENCHANT_FLAG_MORPH)
      return FileReadByte(who, RUNE_FORM_OFFSET)
  return 0

//-----------------------------------------------------------------------
// Dire Wuff form...  How many wuffs it may call (CWUFF.SRC asks)...
int PackSize(int self)
  int form
  form = FormOf(self)
  if(form)
    return (RuneRank(form) + 1)
  return 0

//-----------------------------------------------------------------------
// Number of pack wuffs a form has out...
int PackCount(int self)
  int i, who, index, count
  index = FindIndex(self)
  count = 0
  i = 0
  while(i < MAX_CHARACTER)
    who = FindByIndex(i)
    if(who && i != index)
      if(who.owner == index && FileReadByte(who, RUNE_FORM_OFFSET))
        count++
    i++
  return count

//-----------------------------------------------------------------------
// A pack wuff was called (CWUFF.SRC)...  It carries the rune so its
// bites can shock at Rank III, and goes when the form ends...
int PackJoined(int self, int child)
  FileWriteByte(child, RUNE_FORM_OFFSET, FileReadByte(self, RUNE_FORM_OFFSET))
  return TRUE

//-----------------------------------------------------------------------
// A form (or its pack) bumped a foe for damage (STANDARD.BumpDamageEvent)...
int Bite(int self, int who)
  int form, rank, element, holder
  form = FileReadByte(self, RUNE_FORM_OFFSET)
  if(!form || self.team != TEAM_GOOD || !who)
    return FALSE
  rank = RuneRank(form)
  element = RuneElement(form)
  if(element == WEAPON_VARIANT_ICE && rank > 0)
    if(rank == 2)
      XITEM.Chill(who, CHILL_TIME*3)
    else
      XITEM.Chill(who, CHILL_TIME)
    PSMOKE.Effect(who.x, who.y, who.z+1.0, 0.0, 0.0, 0.03, 1.5, 0.05, FALSE, ICE_SMOKE_COLOR, 200, 25)
  if(element == WEAPON_VARIANT_VOLT && rank == 2 && who.hits > 0)
    PSPARK.Effect(who.x, who.y, who.z+1.0, 6, 4)
    PlaySound("FILE:-SHOCK.RAW", 280 + RollDice(1, 20), 160)
    DWARFFX.KnockDown(who, self.x, self.y)
  if(element == WEAPON_VARIANT_UNHOLY && rank == 2 && who.hits == 0)
    // A kill feeds mana to the Mystic and allies...
    HEALFX.Area(self, self.x, self.y, 10.0, 5, 0, 65535)
  return TRUE

//-----------------------------------------------------------------------
// Length of a form, in ticks of 16 frames...
int FormTicks(int rank)
  if(rank == 0)
    return 56   // ~15 seconds
  if(rank == 1)
    return 94   // ~25 seconds
  return 150    // ~40 seconds

//-----------------------------------------------------------------------
// The form's timer particle (self, target is the Mystic)...  First call
// changes the Mystic, the rest count down and change him back...
int FormStart(int self)
  int who, form, script
  who = FindTarget()
  form = self.misc4
  script = FormScript(form, FALSE)
  if(!who || !script || (who.eflags & ENCHANT_FLAG_MORPH))
    GoPoof(POOF_SELF)
    return FALSE
  PlaySound("FILE:-SPELL02.RAW", 200 + RollDice(1, 20), 255)
  if(!IMORPH.MorphTarget(who, script, FormScript(form, TRUE)))
    GoPoof(POOF_SELF)
    return FALSE
  // Same slot, new body...
  who = FindTarget()
  if(who)
    FileWriteByte(who, RUNE_FORM_OFFSET, form)
    FileWriteByte(who, RUNE_LEFT_OFFSET, FormTicks(self.misc6))
    FileWriteByte(who, RUNE_WATCH_OFFSET, 48)
  self.misc5 = 0
  self.timer = 16
  self.evtimer = 0
  return TRUE

//-----------------------------------------------------------------------
int DoForm(int self)
  int who, ticks
  float dx, dy
  self.timer = 16
  who = FindTarget()
  if(!who && self.misc0 < MAX_CHARACTER)
    // Lost its target...  misc0 keeps the Mystic's index too...
    self.target = self.misc0
    who = FindTarget()
  if(!who)
    GoPoof(POOF_SELF)
    return FALSE
  if(!(who.eflags & ENCHANT_FLAG_MORPH) || FileReadByte(who, RUNE_FORM_OFFSET) == 0)
    // Disenchanted early...
    GoPoof(POOF_SELF)
    return FALSE
  if(who.hits == 0)
    GoPoof(POOF_SELF)
    return FALSE
  self.misc5++
  ticks = FormTicks(self.misc6)
  if(self.misc5 < ticks)
    FileWriteByte(who, RUNE_LEFT_OFFSET, ticks - self.misc5)
  FileWriteByte(who, RUNE_WATCH_OFFSET, 48)
  if(RuneElement(self.misc4) == WEAPON_VARIANT_ICE && self.misc6 == 2)
    // Frost breath freezes solid...
    if(who.daction == ACTION_THRUST_LEFT)
      FreezeCone(who)
  if(self.misc5 > (ticks - 4))
    // Almost over...  Flicker...
    PFLASH.Effect(who, "FILE:LITESPRK.RGB", WHITE, TRUE, 1.0)
  if(self.misc5 >= ticks)
    Unmorph(who)
    GoPoof(POOF_SELF)
  return TRUE

//-----------------------------------------------------------------------
// Called every frame by a held rune (IRUNE.Refresh, self is the holder)...
// Going through a door poofs every particle, timers too, so a monster
// form whose timer stopped ticking gets a new one with the time it had
// left...
int Watch(int self)
  int form, watch, left, child, index
  form = FileReadByte(self, RUNE_FORM_OFFSET)
  if(!form || !(self.eflags & ENCHANT_FLAG_MORPH) || self.hits == 0)
    return FALSE
  watch = FileReadByte(self, RUNE_WATCH_OFFSET)
  if(watch > 0)
    FileWriteByte(self, RUNE_WATCH_OFFSET, watch - 1)
    return TRUE
  FileWriteByte(self, RUNE_WATCH_OFFSET, 48)
  left = FileReadByte(self, RUNE_LEFT_OFFSET)
  if(left > FormTicks(RuneRank(form)))
    left = FormTicks(RuneRank(form))
  index = FindIndex(self)
  child = NewPart(self, RUNE_FORM, RuneRank(form), self.x, self.y, self.z, NULL, 0.0)
  if(child)
    child.flags = 0
    child.misc4 = form
    child.misc0 = index
    child.target = index
    child.misc5 = FormTicks(RuneRank(form)) - left
    child.timer = 16
    child.evtimer = 0
  return TRUE

//-----------------------------------------------------------------------
// Rank III Winter Wuff breath...  Long chill on foes in front...
int FreezeCone(int who)
  int i, enemy
  float dx, dy, dist
  i = 0
  while(i < MAX_CHARACTER)
    enemy = FindByIndex(i)
    if(Foe(who, enemy))
      dx = enemy.x - who.x
      dy = enemy.y - who.y
      dist = sqrt(dx*dx + dy*dy)
      if(dist < 8.0 && dist > 0.1)
        if(((dx*who.frontx) + (dy*who.fronty)) > (dist*0.6))
          XITEM.Chill(enemy, CHILL_TIME*3)
    i++
  return TRUE

//-----------------------------------------------------------------------
// Turns a form back into the Mystic (same as Disenchant does, IDCHANT.SRC)...
int Unmorph(int target)
  int child, i, item_type, player, rider, index
  index = FindIndex(target)
  // Pack wuffs go too...
  i = 0
  while(i < MAX_CHARACTER)
    child = FindByIndex(i)
    if(child && i != index)
      if(child.owner == index && FileReadByte(child, RUNE_FORM_OFFSET))
        PEMBER.Effect(child.x, child.y, child.z+1.0, 0.0, 0.0, 0.03, 3.0, 255, 12, "FILE:LITESPRK.RGB")
        Poof(i)
    i++
  target.eflags = target.eflags & (255-ENCHANT_FLAG_MORPH)
  FileWriteByte(target, RUNE_FORM_OFFSET, 0)
  PFLASH.Effect(target, "FILE:LITESPRK.RGB", WHITE, TRUE, 1.5)
  PFLASH.BlossomEffect(target.x, target.y, (target.z+target.height*0.5), target.boxsize, "FILE:SPARK2.RGB", 50)
  SystemSet(SYS_RESPAWNCHARACTER, 0, 0, target.morphoc)
  child = FindByIndex(target.morphoc)
  if(!child)
    return FALSE
  SystemSet(SYS_RESERVECHARACTER, FALSE, 0, FindIndex(child))
  SystemSet(SYS_RESERVECHARACTER, FALSE, 0, FindIndex(target))
  child.eflags = (target.eflags & (255 - ENCHANT_FLAG_MORPH - ENCHANT_FLAG_LEVITATE)) | (child.eflags & ENCHANT_FLAG_LEVITATE)
  child.x = target.x
  child.y = target.y
  child.z = target.z
  StringClear(child.name)
  StringAppend(child.name, target.name, 16)
  child.hitsmax = target.hitsmax
  child.hitstap = target.hitstap
  child.hits = target.hits
  child.manamax = target.manamax
  child.manatap = target.manatap
  child.mana = target.mana
  child.manacst = target.manacst
  child.str = target.str
  child.dex = target.dex
  child.int = target.int
  child.statpts = target.statpts
  child.aitimer = target.aitimer
  child.keys = target.keys
  child.money = target.money
  child.vircomp = target.vircomp
  child.virdill = target.virdill
  child.virhono = target.virhono
  child.virfait = target.virfait
  child.vircour = target.vircour
  child.pstimer = target.pstimer
  child.pttimer = target.pttimer
  child.class = target.class
  child.food = target.food
  child.level = target.level
  child.exp = target.exp
  child.spin = target.spin
  child.alpha = target.alpha
  child.nctimer = 15
  child.flatten = 60
  child.b0timer = 0
  child.b1timer = 0
  child.b2timer = 0
  child.b3timer = 0
  child.bflags = 0
  FixCharacterLocation(child)
  child.z = target.z
  SetupTargetMatrix(child)
  // Copy items & stuff...
  i = 224
  while(i < 250)
    if(i != 240 && i != 241)
      item_type = FileReadByte(target, i)
      FileWriteByte(child, i, item_type)
    i++
  // If something was riding the form, knock it off...
  rider = FindByIndex(target.rider)
  if(rider)
    if(rider.mount == FindIndex(target))
      rider.mount = 65535
      rider.action = ACTION_STAND
      rider.daction = ACTION_STAND
      rider.event = EVENT_DISMOUNTED
      SystemSet(SYS_CHARFASTFUNCTION, FindIndex(rider), 0, FAST_FUNCTION_EVENT)
      target.event = EVENT_DISMOUNTED
      SystemSet(SYS_CHARFASTFUNCTION, FindIndex(target), 0, FAST_FUNCTION_EVENT)
      child.aitimer = target.aitimer
  // Swap them back, so the Mystic keeps his slot...
  SystemSet(SYS_SWAPCHARACTERS, 0, FindIndex(child), FindIndex(target))
  i = target
  target = child
  child = i
  player = 0
  while(player < 4)
    if(SystemGet(SYS_LOCALPLAYER, player, 0) == FindIndex(child))
      SystemSet(SYS_LOCALPLAYER, player, 0, FindIndex(child))
    player++
  // Poof the monster body...
  Poof(FindIndex(target))
  index = FindIndex(child)
  SystemSet(SYS_CHARFASTFUNCTION, index, 0, FAST_FUNCTION_MODELSETUP)
  SystemSet(SYS_CHARFASTFUNCTION, index, 0, FAST_FUNCTION_DEFENSERATING)
  return TRUE

//-----------------------------------------------------------------------
// Poofs character i (self is a particle)...
int Poof(int i)
  int self, old
  self = FindSelf()
  old = self.target
  self.target = i
  GoPoof(POOF_TARGET)
  self.target = old
  return TRUE


//-----------------------------------------------------------------------
// Particle callbacks...
//-----------------------------------------------------------------------
int Refresh()
  int self, kind
  self = FindSelf()
  kind = self.misc7
  if(kind == RUNE_STAR || kind == RUNE_STAR_SPLIT)
    return DoStar(self)
  if(kind == RUNE_PHOENIX)
    return DoPhoenix(self)
  if(kind == RUNE_GLACIER)
    return DoGlacier(self)
  if(kind == RUNE_ICE_PATCH)
    return DoIcePatch(self)
  if(kind == RUNE_STORM)
    return DoStorm(self)
  if(kind == RUNE_SEED_SHOT)
    return DoSeedShot(self)
  if(kind == RUNE_SEED)
    return DoSeed(self)
  if(kind == RUNE_HALO)
    return DoHalo(self)
  if(kind == RUNE_SINGULARITY)
    return DoSingularity(self)
  if(kind == RUNE_SHRINE)
    return DoShrine(self)
  if(kind == RUNE_EYE)
    return DoEye(self)
  if(kind == RUNE_EYE_BOLT)
    return DoEyeBolt(self)
  if(kind == RUNE_SPORE)
    return DoSpore(self)
  if(kind == RUNE_FORM)
    return DoForm(self)
  return FALSE

//-----------------------------------------------------------------------
int Event()
  int self, kind, holder, who, ext
  self = FindSelf()
  kind = self.misc7
  holder = FindOwner()
  if(self.event == EVENT_TIMER)
    if(kind == RUNE_CAST)
      ext = self.misc4
      if(holder)
        Release(self, holder, ext)
      GoPoof(POOF_SELF)  // (Nothing runs after a poof)...
      return TRUE
    if(kind == RUNE_FORM)
      return FormStart(self)
    if(kind == RUNE_HALO)
      return HaloEnd(self)
    if(kind == RUNE_EYE_BOLT)
      GoPoof(POOF_SELF)
      return TRUE
    if(kind >= RUNE_SHRINE && kind <= RUNE_SPORE)
      return TurretEnd(self)
    return FALSE
  if(self.event == EVENT_HIT_CHARACTER)
    who = FindTarget()
    if(!Foe(holder, who))
      return FALSE
    if(kind == RUNE_STAR || kind == RUNE_STAR_SPLIT || kind == RUNE_EYE_BOLT || kind == RUNE_SEED_SHOT)
      if(DEFLECT.Event(50, 1.0, TRUE))
        return TRUE
    if(kind == RUNE_STAR || kind == RUNE_STAR_SPLIT)
      return StarHit(self, holder, who)
    if(kind == RUNE_EYE_BOLT)
      Hurt(self, FindIndex(who), DAMAGE_BASH, RollDice(1, 2)+1+(self.misc6 >> 1), 1)
      PEMBER.Effect(self.x, self.y, self.z, 0.0, 0.0, 0.0, 3.0, 255, 16, "FILE:SPARK5.RGB")
      PSPARK.Effect(self.x, self.y, self.z, 8, 2)
      GoPoof(POOF_SELF)
      return TRUE
    if(kind == RUNE_SEED_SHOT)
      return Plant(self, who)
    return FALSE
  if(self.event == EVENT_HIT_WALL || self.event == EVENT_HIT_FLOOR)
    if(kind == RUNE_STAR || kind == RUNE_STAR_SPLIT || kind == RUNE_EYE_BOLT || kind == RUNE_SEED_SHOT)
      PSPARK.Effect(self.x, self.y, self.z, 8, 2)
      GoPoof(POOF_SELF)
      return TRUE
    if(kind == RUNE_GLACIER)
      GoPoof(POOF_SELF)
      return TRUE
    if(kind == RUNE_STORM || kind == RUNE_SINGULARITY)
      self.x = self.x - self.vx
      self.y = self.y - self.vy
      self.vx = 0.0
      self.vy = 0.0
      return TRUE
  return FALSE

//-----------------------------------------------------------------------
// NOTE: Files must end with a function-level line (see XITEM.SRC)...
int Unused()
  return FALSE
