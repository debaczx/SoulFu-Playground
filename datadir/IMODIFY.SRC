//-----------------------------------------------------------------------
// <ZZ> Modify...  G'nome skill.  Works like Tinker (hold, pick a direction
//      with the stick/keys, let go), but works on the weapon in the right
//      hand instead of building something new.
//
//      The directions are a compass of elements, clockwise from Up, in the
//      same order as the game's enchantments (WEAPON_VARIANT_*):
//          Up         1 Magic          Down       5 Poison
//          Up-right   2 Fire           Down-left  6 Holy
//          Right      3 Ice            Left       7 Unholy
//          Down-right 4 Volt           Up-left    8 SALVAGE
//      The held weapon decides what each element does.  A matching Magic
//      Core in the backpack is used up and makes it certain; otherwise the
//      chance comes from Intelligence.  Failing blows up in your face...
//
//      Salvage breaks an enchanted weapon into a core of its element, or
//      strips a modded tinker weapon back to normal and refunds its core.
//-----------------------------------------------------------------------
#define SMOKE_COLOR   128
#define MODIFY_SLOT   243     // Right hand
#define SALVAGE_DIR   8       // Compass direction (Up-left)
#define NO_VARIANT    (-1)

//-----------------------------------------------------------------------
int GetName()
  STANDARD.ItemName("MODIFY", NULL, 255, 0, 0, 0, 0)

//-----------------------------------------------------------------------
// What does element (1-7) turn the held weapon into?  NO_VARIANT if
// nothing (yet)...  0 means the weapon's plain version...
int VariantFor(int self, int element)
  if(self.eqright == ITEM_FLAMER)
    if(element == WEAPON_VARIANT_FIRE)
      return 0
    if(element == WEAPON_VARIANT_ICE)
      return XITEM_FROST_THROWER
    if(element == WEAPON_VARIANT_VOLT)
      return XITEM_LIGHTNING_CANNON
    if(element == WEAPON_VARIANT_UNHOLY)
      return XITEM_LEECH_BEAM
  return NO_VARIANT

//-----------------------------------------------------------------------
// Which element is a modded tinker weapon?  0 if it isn't one...
int ElementOfVariant(int variant)
  if(variant == XITEM_FROST_THROWER)
    return WEAPON_VARIANT_ICE
  if(variant == XITEM_LIGHTNING_CANNON)
    return WEAPON_VARIANT_VOLT
  if(variant == XITEM_LEECH_BEAM)
    return WEAPON_VARIANT_UNHOLY
  return 0

//-----------------------------------------------------------------------
// Element Salvage would get from the held weapon, or 0 if it can't be
// salvaged...  Enchanted weapons (not bows/armor, which aren't right hand)
// and modded tinker weapons only...
int SalvageElement(int self)
  int item
  item = self.eqright
  if(item >= ITEM_DAGGER && item <= (ITEM_WAR_HAMMER+7))
    return (item & 7)
  return ElementOfVariant(XITEM.Get(self, MODIFY_SLOT))

//-----------------------------------------------------------------------
// Percent chance to work...  0 means it can't be done...
int ChanceOfWorking(int self, int expression)
  int chance, variant
  if(expression == SALVAGE_DIR)
    if(SalvageElement(self))
      return 100
    return 0
  variant = VariantFor(self, expression)
  if(variant == NO_VARIANT)
    return 0
  if(variant == XITEM.Get(self, MODIFY_SLOT))
    return 0  // Already is that...
  if(variant == 0)
    return 100  // Going back to the plain version always works
  if(XITEM.FindCore(self, expression))
    return 100
  chance = 30 + ((self.int - 20)*4)
  if(chance > 90)
    chance = 90
  if(chance < 0)
    chance = 0
  return chance

//-----------------------------------------------------------------------
// Icon floating over the G'nome's head for each choice...
int IconFor(int self, int expression)
  if(expression == SALVAGE_DIR)
    if(SalvageElement(self))
      return "FILE:=IMODIFY.RGB"
    return "FILE:=TINKASK.RGB"
  if(expression > 0 && VariantFor(self, expression) != NO_VARIANT)
    return XITEM.CoreIcon(expression)
  return "FILE:=TINKASK.RGB"

//-----------------------------------------------------------------------
// Called when item is first used (and repeatedly while held)...
int Event()
  int self, child, expression, chance
  float z


  self = FindSelf()
  if(CharacterScriptFile(FindIndex(self)) != "FILE:CPLAYER.RUN")
    return FALSE


  if(self.action == ACTION_STAND || self.action == ACTION_WALK || self.action == ACTION_JUMP || self.action == ACTION_DOUBLE || self.action == ACTION_SPECIAL_10 || self.action == ACTION_SPECIAL_11)
    if(self.daction != ACTION_SPECIAL_11)
      PlaySound("FILE:-GNOME05.RAW", 256, 255)
    self.daction = ACTION_SPECIAL_11
    if(self.action != ACTION_SPECIAL_11)
      self.action = ACTION_SPECIAL_10
    else
      PDUST.Effect(1)
      z = self.z-0.5+self.height
      child = PEXCLAIM.Effect(self.x, self.y, z, 2.0, TRUE)
      if(child)
        expression = ITALK.ExpressionFromAxis(self.baxis)
        child.image = IconFor(self, expression)


        // Chance bulb (same as Tinker)...
        if(expression != 0)
          chance = ChanceOfWorking(self, expression)
          child = PEXCLAIM.Effect(self.x, self.y, z, 3.5, TRUE)
          if(child)
            child.width = 1.0
            child.length = 1.0
            child.image = "FILE:=DIMBULB.RGB"
          child = PEXCLAIM.Effect(self.x, self.y, z+0.15, 3.5, TRUE)
          if(child)
            child.width = 0.5 + (chance*0.01)
            child.length = child.width
            child.image = "FILE:LITESPRK.RGB"
            child.flags = child.flags | PART_LIGHT_ON
            child.alpha = (chance * 5) >> 1
            if(chance >= 100)
              child.alpha = 255
              child.blue = 128
  return TRUE

//-----------------------------------------------------------------------
// Breaks down the held weapon...  Returns TRUE if it worked...
int Salvage(int self)
  int element, variant
  element = SalvageElement(self)
  if(element == 0)
    return FALSE
  variant = XITEM.Get(self, MODIFY_SLOT)
  if(ElementOfVariant(variant))
    // Modded tinker weapon...  Strip the mod, keep the weapon, refund the core...
    if(XITEM.GiveCore(self, element) == FALSE)
      return FALSE
    XITEM.Set(self, MODIFY_SLOT, 0)
  else
    // Enchanted weapon...  Gone, but we get its core...
    if(XITEM.GiveCore(self, element) == FALSE)
      return FALSE
    self.eqright = ITEM_NONE
  return TRUE

//-----------------------------------------------------------------------
// Called when the button is let go...  Does the modification...
int Unpressed()
  int self, expression, variant, chance, slot, oldtarget, index


  self = FindSelf()
  ButtonHandled()
  if(CharacterScriptFile(FindIndex(self)) != "FILE:CPLAYER.RUN")
    return FALSE


  if(self.action == ACTION_SPECIAL_10)
    // Too little time...
    self.action = ACTION_SPECIAL_12
    self.daction = ACTION_STAND
    return FALSE


  if(self.action == ACTION_SPECIAL_11)
    self.action = ACTION_SPECIAL_12
    self.daction = ACTION_STAND


    expression = ITALK.ExpressionFromAxis(self.baxis)
    if(expression == 0)
      return FALSE
    chance = ChanceOfWorking(self, expression)
    if(chance <= 0)
      BuzzerSound()
      return FALSE
    index = FindIndex(self)


    if(expression == SALVAGE_DIR)
      if(Salvage(self))
        SystemSet(SYS_CHARFASTFUNCTION, index, 0, FAST_FUNCTION_MODELSETUP)
        SystemSet(SYS_CHARFASTFUNCTION, index, 0, FAST_FUNCTION_DEFENSERATING)
        PSPARK.Effect(self.x, self.y, self.z+(self.height*0.5), 12, 4)
        PSMOKE.Effect(self.x, self.y, self.z+(self.height*0.5), 0.0, 0.0, 0.05, 1.5, 0.05, FALSE, SMOKE_COLOR, 160, 20)
        ButtonSound()
      else
        BuzzerSound()  // No room in the backpack for the core...
      return TRUE


    variant = VariantFor(self, expression)


    // Use up the core, if we have one...
    if(variant != 0)
      slot = XITEM.FindCore(self, expression)
      if(slot)
        FileWriteByte(self, slot, ITEM_NONE)


    if((RollDice(1, 20)*5) > chance)
      // Botched it...  Blows up in our face, weapon stays as it was...
      PEXPLODE.Effect(self.x, self.y, self.z, 0.0, 0.0, 3.34, DAMAGE_FIRE, 0, 0, index, self.team, "FILE:FIRE1.RGB", SMOKE_COLOR, 200)
      oldtarget = self.target
      self.target = index
      DamageTarget(DAMAGE_BASH, 0, 4)
      self.target = oldtarget
      return FALSE


    // It worked...
    XITEM.Set(self, MODIFY_SLOT, variant)
    self.charge = 0
    SystemSet(SYS_CHARFASTFUNCTION, index, 0, FAST_FUNCTION_MODELSETUP)
    PSPARK.Effect(self.x, self.y, self.z+(self.height*0.5), 12, 4)
    ButtonSound()
  return TRUE

//-----------------------------------------------------------------------
