//-----------------------------------------------------------------------
// <ZZ> Modify...  Class skill.  Works like Tinker (hold, pick a direction
//      with the stick/keys, let go), but works on a held weapon instead of
//      building something new.  Each class works on its own gear, in
//      whichever hand holds it, and calls the skill its own name:
//          G'nome   MODIFY   Flamer, Gonne, Gronnade
//          Elf      FLETCH   Bow, Long Bow
//          Soldier  TEMPER   Swords
//          Hubbin   HONE     Daggers
//          D'warf   FORGE    Picks, axes and shields
//          Healer   HALLOW   Hammers and maces
//      (Wizard and Mystic get theirs later, through a rune item.)
//
//      The directions are a compass of elements, clockwise from Up, in the
//      same order as the game's enchantments (WEAPON_VARIANT_*):
//          Up         1 Magic          Down       5 Poison
//          Up-right   2 Fire           Down-left  6 Holy
//          Right      3 Ice            Left       7 Unholy
//          Down-right 4 Volt           Up-left    8 SALVAGE
//      The held item decides what each element does.  A matching Magic
//      Core in the backpack is used up and makes it certain; otherwise the
//      chance comes from the class's stat (SkillStat()).  Failing blows up in your face...
//      Only plain items can be modified, and modded items can't be
//      enchanted (IBRAND.SRC), so each item takes one road or the other.
//
//      Re-modding swaps the energy source: the old core (if a real one was
//      used) pops back into the backpack and the new one goes in.  Salvage
//      strips a mod back to the plain item (refunding its core, if it has a
//      real one), or breaks an enchanted item into a core of its element...
//
//      Adding a class wheel:  list its gear in ClassTool(), give each item a
//      XITEM_*_BASE in DEFINE.TXT and turn it on in FamilyBase()...
//-----------------------------------------------------------------------
#define SMOKE_COLOR   128
#define SALVAGE_DIR   8       // Compass direction (Up-left)
#define NO_VARIANT    (-1)

//-----------------------------------------------------------------------
int GetName()
  int binding
  binding = FindBinding()
  if(binding)
    STANDARD.ItemName(SkillName(binding.class), NULL, 255, 0, 0, 0, 0)
    return TRUE
  STANDARD.ItemName("MODIFY", NULL, 255, 0, 0, 0, 0)

//-----------------------------------------------------------------------
// Per class...  What the skill is called...
int SkillName(int kind)
  if(kind == CLASS_ELF)
    return "FLETCH"
  if(kind == CLASS_SOLDIER)
    return "TEMPER"
  if(kind == CLASS_HUBBIN)
    return "HONE"
  if(kind == CLASS_DWARF)
    return "FORGE"
  if(kind == CLASS_HEALER)
    return "HALLOW"
  return "MODIFY"

//-----------------------------------------------------------------------
// Per class...  TRUE if the (plain) item type is this class's own gear...
int ClassTool(int kind, int item)
  if(kind == CLASS_GNOME)
    if(item == ITEM_FLAMER || item == ITEM_GONNE || item == ITEM_GRONNADE)
      return TRUE
  if(kind == CLASS_ELF)
    if(item == ITEM_BOW || item == ITEM_LONG_BOW)
      return TRUE
  if(kind == CLASS_SOLDIER)
    if(item == ITEM_SHORT_SWORD || item == ITEM_SWORD || item == ITEM_GREAT_SWORD || item == ITEM_OBSIDIAN_BLADE || item == ITEM_DRAGON_SWORD)
      return TRUE
  if(kind == CLASS_HUBBIN)
    if(item == ITEM_DAGGER)
      return TRUE
  if(kind == CLASS_DWARF)
    if(item == ITEM_PICK_AXE || item == ITEM_HATCHET || item == ITEM_BROAD_AXE || item == ITEM_SHIELD || item == ITEM_MIRROR_SHIELD)
      return TRUE
  if(kind == CLASS_HEALER)
    if(item == ITEM_HAMMER || item == ITEM_MACE || item == ITEM_WAR_HAMMER)
      return TRUE
  return FALSE

//-----------------------------------------------------------------------
// Per class...  Stat that sets the chance without a core...
int SkillStat(int self)
  if(self.class == CLASS_SOLDIER || self.class == CLASS_DWARF)
    return self.str  // Brawn, not brains...
  if(self.class == CLASS_HUBBIN)
    return self.dex
  return self.int

//-----------------------------------------------------------------------
// Per item...  Extension base of its variants (variant = base + element),
// or 0 if its wheel isn't built yet...  (The Flamer has its own table, see
// VariantFor())...
int FamilyBase(int item)
  if(item == ITEM_GONNE)
    return XITEM_GONNE_BASE
  if(item == ITEM_GRONNADE)
    return XITEM_GRON_BASE
  if(item == ITEM_BOW || item == ITEM_LONG_BOW)
    return XITEM_BOW_BASE
  if(item == ITEM_SHORT_SWORD)
    return (XITEM_SWORD_BASE + (SWORD_TIER_SHORT<<3))  // Effects in SWORDFX.SRC
  if(item == ITEM_SWORD)
    return (XITEM_SWORD_BASE + (SWORD_TIER_SWORD<<3))
  if(item == ITEM_GREAT_SWORD)
    return (XITEM_SWORD_BASE + (SWORD_TIER_GREAT<<3))
  if(item == ITEM_OBSIDIAN_BLADE)
    return (XITEM_SWORD_BASE + (SWORD_TIER_OBSIDIAN<<3))
  if(item == ITEM_DRAGON_SWORD)
    return (XITEM_SWORD_BASE + (SWORD_TIER_DRAGON<<3))
  // Wheels still to build (bases in DEFINE.TXT)...  Add each one as its effects go in:
  //   Dagger                                       XITEM_DAGGER_BASE
  //   Pick Axe, Hatchet, Broad Axe                 XITEM_PICK_AXE_BASE, XITEM_HATCHET_BASE, XITEM_BROAD_AXE_BASE
  //   Shield, Mirror Shield                        XITEM_SHIELD_BASE, XITEM_MIRROR_BASE
  //   Hammer, Mace, War Hammer                     XITEM_HAMMER_BASE, XITEM_MACE_BASE, XITEM_WAR_HAMMER_BASE
  return 0

//-----------------------------------------------------------------------
// Item type without its enchantment...
int PlainOf(int item)
  if(item >= ITEM_DAGGER)
    return (item & 248)
  if(item >= ITEM_SHIELD && item < ITEM_FISH)
    return (item & 252)
  return item

//-----------------------------------------------------------------------
// Which hand slot gets worked on?  Whichever hand holds the class's own
// gear, right hand first...  With nothing to work on, the usual hand
// (left for the Elf's bow, right for everyone else)...
int ModSlot(int self)
  if(ClassTool(self.class, PlainOf(self.eqright)))
    return 243
  if(ClassTool(self.class, PlainOf(self.eqleft)))
    return 242
  if(self.class == CLASS_ELF)
    return 242
  return 243

//-----------------------------------------------------------------------
// What does element (1-7) turn the held item into?  NO_VARIANT if
// nothing (yet)...  0 means the item's plain version...  Only plain
// (unenchanted) gear of the class's own kind can be modified, and never
// an artifact...
int VariantFor(int self, int element)
  int item, slot, ext, base
  slot = ModSlot(self)
  item = FileReadByte(self, slot)
  ext = XITEM.Get(self, slot) & 255
  if(ext && !ElementOfVariant(ext))
    return NO_VARIANT  // Artifact...  Has its own powers...
  if(!ClassTool(self.class, item))
    return NO_VARIANT
  if(element < WEAPON_VARIANT_MAGIC || element > WEAPON_VARIANT_UNHOLY)
    return NO_VARIANT
  if(item == ITEM_FLAMER)
    if(element == WEAPON_VARIANT_FIRE)
      return 0
    if(element == WEAPON_VARIANT_ICE)
      return XITEM_FROST_THROWER
    if(element == WEAPON_VARIANT_VOLT)
      return XITEM_LIGHTNING_CANNON
    if(element == WEAPON_VARIANT_UNHOLY)
      return XITEM_LEECH_BEAM
    if(element == WEAPON_VARIANT_MAGIC)
      return XITEM_ARCANE_BEAM
    if(element == WEAPON_VARIANT_POISON)
      return XITEM_VENOM_SPRAY
    return XITEM_SANCTIFIER
  base = FamilyBase(item)
  if(base == 0)
    return NO_VARIANT
  return (base + element)

//-----------------------------------------------------------------------
// Which element is a modded item?  0 if it isn't one (plain, artifact or
// core)...
int ElementOfVariant(int variant)
  if(variant == XITEM_FROST_THROWER)
    return WEAPON_VARIANT_ICE
  if(variant == XITEM_LIGHTNING_CANNON)
    return WEAPON_VARIANT_VOLT
  if(variant == XITEM_LEECH_BEAM)
    return WEAPON_VARIANT_UNHOLY
  if(variant == XITEM_ARCANE_BEAM)
    return WEAPON_VARIANT_MAGIC
  if(variant == XITEM_VENOM_SPRAY)
    return WEAPON_VARIANT_POISON
  if(variant == XITEM_SANCTIFIER)
    return WEAPON_VARIANT_HOLY
  if(variant > XITEM_GONNE_BASE && variant <= (XITEM_GONNE_BASE+7))
    return (variant - XITEM_GONNE_BASE)
  // Every other wheel sits on a multiple of 8 (bows 24, gronnades 40, melee 48-159),
  // and its base value itself is never a variant (48 is the Testing Bracelet)...
  if(variant > XITEM_BOW_BASE && variant <= (XITEM_BOW_BASE+7))
    return (variant & 7)
  if(variant > XITEM_GRON_BASE && variant < (XITEM_WAR_HAMMER_BASE+8))
    return (variant & 7)
  return 0

//-----------------------------------------------------------------------
// Element Salvage would get from the held item, or 0 if it can't be
// salvaged...  Modded gear is stripped (its core comes back if it has a
// real one), enchanted weapons, shields and bows break into a core...
int SalvageElement(int self)
  int item, slot, element
  slot = ModSlot(self)
  item = FileReadByte(self, slot)
  element = ElementOfVariant(XITEM.Get(self, slot) & 255)
  if(element)
    return element
  if(item >= ITEM_DAGGER && (item & 7))
    return (item & 7)
  if(item >= ITEM_SHIELD && item <= (ITEM_LONG_BOW+3) && (item & 3))
    return (item & 3)
  return 0

//-----------------------------------------------------------------------
// Element of the core powering the held modded item, or 0 if it holds
// no real core (plain, or modded on Intelligence alone)...
int CoreInside(int self)
  int ext
  ext = XITEM.Get(self, ModSlot(self))
  if(ext & XITEM_CORED)
    return ElementOfVariant(ext & 255)
  return 0

//-----------------------------------------------------------------------
// TRUE if the backpack has an empty slot...
int HasRoom(int self)
  int i
  i = 224
  while(i < 240)
    if(FileReadByte(self, i) == ITEM_NONE)
      return TRUE
    i++
  return FALSE

//-----------------------------------------------------------------------
// Percent chance to work...  0 means it can't be done...
int ChanceOfWorking(int self, int expression)
  int chance, variant
  if(expression == SALVAGE_DIR)
    if(SalvageElement(self))
      return 100
    return 0
  variant = VariantFor(self, expression)
  if(variant == NO_VARIANT)
    return 0
  if(variant == (XITEM.Get(self, ModSlot(self)) & 255))
    return 0  // Already is that...
  if(variant == 0)
    return 100  // Going back to the plain version always works
  if(XITEM.FindCore(self, expression))
    return 100
  if(variant > XITEM_GRON_BASE && variant <= (XITEM_GRON_BASE+7))
    return 0  // Gronnades need a real core...
  chance = 30 + ((SkillStat(self) - 20)*4)
  if(chance > 90)
    chance = 90
  if(chance < 0)
    chance = 0
  return chance

//-----------------------------------------------------------------------
// Icon floating over the head for each choice...  For Salvage it shows
// what comes back: a core, or the Modify icon when the mod holds none...
int IconFor(int self, int expression)
  int element
  if(expression == SALVAGE_DIR)
    element = SalvageElement(self)
    if(element == 0)
      return "FILE:=TINKASK.RGB"
    if(ElementOfVariant(XITEM.Get(self, ModSlot(self)) & 255) && !CoreInside(self))
      return "FILE:=IMODIFY.RGB"
    return XITEM.CoreIcon(element)
  if(expression > 0 && VariantFor(self, expression) != NO_VARIANT)
    return XITEM.CoreIcon(expression)
  return "FILE:=TINKASK.RGB"

//-----------------------------------------------------------------------
// Called when item is first used (and repeatedly while held)...
int Event()
  int self, child, expression, chance
  float z


  self = FindSelf()
  if(CharacterScriptFile(FindIndex(self)) != "FILE:CPLAYER.RUN")
    return FALSE


  if(self.action == ACTION_STAND || self.action == ACTION_WALK || self.action == ACTION_JUMP || self.action == ACTION_DOUBLE || self.action == ACTION_SPECIAL_10 || self.action == ACTION_SPECIAL_11)
    if(self.daction != ACTION_SPECIAL_11)
      PlaySound("FILE:-GNOME05.RAW", 256, 255)
    self.daction = ACTION_SPECIAL_11
    if(self.action != ACTION_SPECIAL_11)
      self.action = ACTION_SPECIAL_10
    else
      PDUST.Effect(1)
      z = self.z-0.5+self.height
      child = PEXCLAIM.Effect(self.x, self.y, z, 2.0, TRUE)
      if(child)
        expression = ITALK.ExpressionFromAxis(self.baxis)
        child.image = IconFor(self, expression)


        // Chance bulb (same as Tinker)...
        if(expression != 0)
          chance = ChanceOfWorking(self, expression)
          child = PEXCLAIM.Effect(self.x, self.y, z, 3.5, TRUE)
          if(child)
            child.width = 1.0
            child.length = 1.0
            child.image = "FILE:=DIMBULB.RGB"
          child = PEXCLAIM.Effect(self.x, self.y, z+0.15, 3.5, TRUE)
          if(child)
            child.width = 0.5 + (chance*0.01)
            child.length = child.width
            child.image = "FILE:LITESPRK.RGB"
            child.flags = child.flags | PART_LIGHT_ON
            child.alpha = (chance * 5) >> 1
            if(chance >= 100)
              child.alpha = 255
              child.blue = 128
  return TRUE

//-----------------------------------------------------------------------
// Breaks down the held item...  Returns TRUE if it worked...
int Salvage(int self)
  int element, slot
  element = SalvageElement(self)
  if(element == 0)
    return FALSE
  slot = ModSlot(self)
  if(ElementOfVariant(XITEM.Get(self, slot) & 255))
    // Modded...  Strip the mod, keep the item, refund the core if it has a real one...
    if(CoreInside(self))
      if(XITEM.GiveCore(self, element) == FALSE)
        return FALSE
    XITEM.Set(self, slot, 0)
  else
    // Enchanted...  Gone, but we get its core...
    if(XITEM.GiveCore(self, element) == FALSE)
      return FALSE
    FileWriteByte(self, slot, ITEM_NONE)
    XITEM.Set(self, slot, 0)
  return TRUE

//-----------------------------------------------------------------------
// Called when the button is let go...  Does the modification...
int Unpressed()
  int self, expression, variant, chance, slot, oldtarget, index, oldcore


  self = FindSelf()
  ButtonHandled()
  if(CharacterScriptFile(FindIndex(self)) != "FILE:CPLAYER.RUN")
    return FALSE


  if(self.action == ACTION_SPECIAL_10)
    // Too little time...
    self.action = ACTION_SPECIAL_12
    self.daction = ACTION_STAND
    return FALSE


  if(self.action == ACTION_SPECIAL_11)
    self.action = ACTION_SPECIAL_12
    self.daction = ACTION_STAND


    expression = ITALK.ExpressionFromAxis(self.baxis)
    if(expression == 0)
      return FALSE
    chance = ChanceOfWorking(self, expression)
    if(chance <= 0)
      BuzzerSound()
      return FALSE
    index = FindIndex(self)


    if(expression == SALVAGE_DIR)
      if(Salvage(self))
        SystemSet(SYS_CHARFASTFUNCTION, index, 0, FAST_FUNCTION_MODELSETUP)
        SystemSet(SYS_CHARFASTFUNCTION, index, 0, FAST_FUNCTION_DEFENSERATING)
        PSPARK.Effect(self.x, self.y, self.z+(self.height*0.5), 12, 4)
        PSMOKE.Effect(self.x, self.y, self.z+(self.height*0.5), 0.0, 0.0, 0.05, 1.5, 0.05, FALSE, SMOKE_COLOR, 160, 20)
        ButtonSound()
      else
        BuzzerSound()  // No room in the backpack for the core...
      return TRUE


    variant = VariantFor(self, expression)
    oldcore = CoreInside(self)


    // Use up the new core, if we have one...
    slot = 0
    if(variant != 0)
      slot = XITEM.FindCore(self, expression)
      if(slot)
        FileWriteByte(self, slot, ITEM_NONE)


    // Need somewhere to put the old core when swapping...
    if(oldcore && !slot && !HasRoom(self))
      BuzzerSound()
      return FALSE


    if((RollDice(1, 20)*5) > chance)
      // Botched it...  Blows up in our face, weapon stays as it was...
      PEXPLODE.Effect(self.x, self.y, self.z, 0.0, 0.0, 3.34, DAMAGE_FIRE, 0, 0, index, self.team, "FILE:FIRE1.RGB", SMOKE_COLOR, 200)
      oldtarget = self.target
      self.target = index
      DamageTarget(DAMAGE_BASH, 0, 4)
      self.target = oldtarget
      return FALSE


    // It worked...  Swap the energy source...
    if(oldcore)
      XITEM.GiveCore(self, oldcore)
    if(slot)
      variant = variant | XITEM_CORED
    XITEM.Set(self, ModSlot(self), variant)
    self.charge = 0
    SystemSet(SYS_CHARFASTFUNCTION, index, 0, FAST_FUNCTION_MODELSETUP)
    SystemSet(SYS_CHARFASTFUNCTION, index, 0, FAST_FUNCTION_DEFENSERATING)
    PSPARK.Effect(self.x, self.y, self.z+(self.height*0.5), 12, 4)
    ButtonSound()
  return TRUE

//-----------------------------------------------------------------------
