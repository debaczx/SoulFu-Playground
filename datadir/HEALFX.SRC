    if(element == WEAPON_VARIANT_VOLT)
      return "FILE:=IHAM4.RGB"
    if(element == WEAPON_VARIANT_POISON)
      return "FILE:=IHAM5.RGB"
    if(element == WEAPON_VARIANT_HOLY)
      return "FILE:=IHAM6.RGB"
    if(element == WEAPON_VARIANT_UNHOLY)
      return "FILE:=IHAM7.RGB"
  if(kind == HALLOW_MACE)
    if(element == WEAPON_VARIANT_MAGIC)
      return "FILE:=IMAC1.RGB"
    if(element == WEAPON_VARIANT_FIRE)
      return "FILE:=IMAC2.RGB"
    if(element == WEAPON_VARIANT_ICE)
      return "FILE:=IMAC3.RGB"
    if(element == WEAPON_VARIANT_VOLT)
      return "FILE:=IMAC4.RGB"
    if(element == WEAPON_VARIANT_POISON)
      return "FILE:=IMAC5.RGB"
    if(element == WEAPON_VARIANT_HOLY)
      return "FILE:=IMAC6.RGB"
    if(element == WEAPON_VARIANT_UNHOLY)
      return "FILE:=IMAC7.RGB"
  if(kind == HALLOW_WAR)
    if(element == WEAPON_VARIANT_MAGIC)
      return "FILE:=IWAR1.RGB"
    if(element == WEAPON_VARIANT_FIRE)
      return "FILE:=IWAR2.RGB"
    if(element == WEAPON_VARIANT_ICE)
      return "FILE:=IWAR3.RGB"
    if(element == WEAPON_VARIANT_VOLT)
      return "FILE:=IWAR4.RGB"
    if(element == WEAPON_VARIANT_POISON)
      return "FILE:=IWAR5.RGB"
    if(element == WEAPON_VARIANT_HOLY)
