//-----------------------------------------------------------------------
// <ZZ> Hallowed hammers (the Healer's Hallow, see IMODIFY.SRC)...
//      A plain Hammer, Mace or War Hammer plus a Magic Core.  The
//      extension is base + element:
//          137-143  Hammer       Simple chances
//          145-151  Mace         Support on hit
//          153-159  War Hammer   Big support moments and auras
//      The Healer supports the party: heals, shields, haste for allies,
//      debuffs for enemies...  "Allies" are the holder's team (the
//      Healer himself when playing alone).  Design: healer-wheel-ideas.md
//      Hex: a hexed foe deals 1 less damage and takes 1 more (PATTACK),
//      for about 5 seconds.  Stored on the foe's character data at
//      HEX_OFFSET, counted down by a small mark particle that floats over
//      its head (this file is that particle's script, see Refresh)...
//      PATTACK.FrameEvent() stores on a hammer's attack particle:
//          red     The variant (its extension)
//          green   1 if the effect goes off this swing (SwingProc)
//          blue    1 once a once-per-swing effect has been used
//-----------------------------------------------------------------------
#define ICE_SMOKE_COLOR (4239600)
#define UNHOLY_COLOR    (8388608)
#define HALLOW_HAMMER   0
#define HALLOW_MACE     1
#define HALLOW_WAR      2
#define HEX_OFFSET      668   // Foe's character data (unsaved): hex ticks left (only foes of TEAM_GOOD, players use it for Thunder Cleaver)
#define HEX_TICKS       60    // Ticks of 5 frames...  5 seconds


//-----------------------------------------------------------------------
// TRUE if ext is a hallowed hammer...
int IsHallowed(int ext)
  ext = ext & 255
  if(ext > XITEM_HAMMER_BASE && ext < (XITEM_WAR_HAMMER_BASE+8))
    if(ext & 7)
      return TRUE
  return FALSE

//-----------------------------------------------------------------------
// HALLOW_ kind of a hallowed hammer...
int HallowKind(int ext)
  return (((ext & 255) - XITEM_HAMMER_BASE) >> 3)

//-----------------------------------------------------------------------
// WEAPON_VARIANT_ element of a hallowed hammer...
int HallowElement(int ext)
  return (ext & 7)

//-----------------------------------------------------------------------
// Percent chance per swing (0: works another way)...
int Chance(int ext)
  int kind, element
  kind = HallowKind(ext)
  element = HallowElement(ext)
  if(kind == HALLOW_HAMMER)
    if(element == WEAPON_VARIANT_MAGIC)
      return 20
    if(element == WEAPON_VARIANT_FIRE)
      return 20
    if(element == WEAPON_VARIANT_ICE)
      return 25
    if(element == WEAPON_VARIANT_VOLT)
      return 15
    if(element == WEAPON_VARIANT_POISON)
      return 25
    if(element == WEAPON_VARIANT_HOLY)
      return 20
    if(element == WEAPON_VARIANT_UNHOLY)
      return 25
  if(kind == HALLOW_MACE)
    if(element == WEAPON_VARIANT_MAGIC)
      return 20
    if(element == WEAPON_VARIANT_FIRE)
      return 25
    if(element == WEAPON_VARIANT_ICE)
      return 25
    if(element == WEAPON_VARIANT_VOLT)
      return 20
    if(element == WEAPON_VARIANT_POISON)
      return 0
    if(element == WEAPON_VARIANT_HOLY)
      return 25
    if(element == WEAPON_VARIANT_UNHOLY)
      return 100
  if(kind == HALLOW_WAR)
    if(element == WEAPON_VARIANT_MAGIC)
      return 25
    if(element == WEAPON_VARIANT_FIRE)
      return 100
    if(element == WEAPON_VARIANT_ICE)
      return 25
    if(element == WEAPON_VARIANT_VOLT)
      return 25
    if(element == WEAPON_VARIANT_POISON)
      return 0
    if(element == WEAPON_VARIANT_HOLY)
      return 30
    if(element == WEAPON_VARIANT_UNHOLY)
      return 100
  return 0
//-----------------------------------------------------------------------
// Item name...
int Name(int ext)
  int kind, element
  kind = HallowKind(ext)
  element = HallowElement(ext)
  if(kind == HALLOW_HAMMER)
    if(element == WEAPON_VARIANT_MAGIC)
      return "SAGES HAMMER"
    if(element == WEAPON_VARIANT_FIRE)
      return "EMBER HAMMER"
    if(element == WEAPON_VARIANT_ICE)
      return "FROST HAMMER"
    if(element == WEAPON_VARIANT_VOLT)
      return "SHOCK HAMMER"
    if(element == WEAPON_VARIANT_POISON)
      return "VENOM HAMMER"
    if(element == WEAPON_VARIANT_HOLY)
      return "MENDING HAMMER"
    if(element == WEAPON_VARIANT_UNHOLY)
      return "HEX HAMMER"
  if(kind == HALLOW_MACE)
    if(element == WEAPON_VARIANT_MAGIC)
      return "WARD MACE"
    if(element == WEAPON_VARIANT_FIRE)
      return "KINDLING"
    if(element == WEAPON_VARIANT_ICE)
      return "CALM"
    if(element == WEAPON_VARIANT_VOLT)
      return "RALLY"
    if(element == WEAPON_VARIANT_POISON)
      return "CENSER"
    if(element == WEAPON_VARIANT_HOLY)
      return "MENDER"
    if(element == WEAPON_VARIANT_UNHOLY)
      return "HEXER"
  if(kind == HALLOW_WAR)
    if(element == WEAPON_VARIANT_MAGIC)
      return "SANCTUM"
    if(element == WEAPON_VARIANT_FIRE)
      return "PURGE"
    if(element == WEAPON_VARIANT_ICE)
      return "STILLNESS"
    if(element == WEAPON_VARIANT_VOLT)
      return "VERDICT"
    if(element == WEAPON_VARIANT_POISON)
      return "BLIGHT"
    if(element == WEAPON_VARIANT_HOLY)
      return "SUNBURST"
    if(element == WEAPON_VARIANT_UNHOLY)
      return "DOOM"
  return 0
