//-----------------------------------------------------------------------
// Magic Core...  Crafting ingredient for the G'nome's Modify skill.  The
// element (magic, fire, ice, volt, poison, holy, unholy) is stored in the
// item extension.  Get them by Salvaging enchanted weapons...
//-----------------------------------------------------------------------
int GetName()
  int ext
  ext = SystemGet(SYS_ITEMEXT, 0, 0)
  STANDARD.ItemName(XITEM.CoreName(ext - XITEM_CORE_BASE), "MODIFY INGREDIENT", 255, 0, 0, 0, 0)
  return TRUE

//-----------------------------------------------------------------------
