//-----------------------------------------------------------------------
// <ZZ> Item extension layer (artifacts)...
//      Every inventory/equipment slot (offsets 224-248) has a hidden
//      16 bit extension value stored after the normal character data.
//      0 means a normal item.  Anything else is an artifact, defined
//      below.  An artifact is a normal item type (which supplies the
//      model, animation and attack) plus its own name, look and perks.
//
//      The engine carries extensions along automatically whenever a
//      script moves an item from one slot to another, so most of the
//      old scripts don't need to know about any of this.
//-----------------------------------------------------------------------
#define XITEM_OFFSET 616


// Artifact numbers...  Never reuse or renumber these once they've been
// in a release, or saved games will turn one artifact into another...
#define ARTIFACT_NONE           0
#define ARTIFACT_BEARDS_DELVER  1
#define ARTIFACT_SPLITTER       2
// 48 is the Testing Bracelet (XITEM_TESTING_BRACELET, a Magic Ring)...
// 3-5 and 13-15 (Flamer), 6-12 (Gonne), 25-31 (Bows), 41-47 (Gronnades), 49-87 (Swords, see SWORDFX.SRC) are
// weapon variants made with the class Modify skill (XITEM_ defines in DEFINE.TXT)...  17-23 are Magic Cores...


//-----------------------------------------------------------------------
// Returns the extension value of a character's slot (224-248)...
int Get(int who, int slot)
  int offset, low, high
  if(!who)
    return 0
  if(slot < 224 || slot > 248)
    return 0
  offset = XITEM_OFFSET + ((slot-224)<<1)
  low = FileReadByte(who, offset)
  high = FileReadByte(who, offset+1)
  return (low + (high<<8))  // Parentheses matter!  See NOTE at the end of this file...

//-----------------------------------------------------------------------
// Sets the extension value of a character's slot (224-248)...
int Set(int who, int slot, int ext)
  int offset
  if(!who)
    return FALSE
  if(slot < 224 || slot > 248)
    return FALSE
  offset = XITEM_OFFSET + ((slot-224)<<1)
  FileWriteByte(who, offset, ext&255)
  FileWriteByte(who, offset+1, (ext>>8)&255)
  return TRUE

//-----------------------------------------------------------------------
// Returns the extension of the item whose callback is running right now
// (GetName, ModelSetup, Event, FrameEvent, Refresh, DefenseRating)...
int Current()
  return SystemGet(SYS_ITEMEXT, 0, 0)


//-----------------------------------------------------------------------
// Artifact definitions...
//-----------------------------------------------------------------------
// Name shown instead of the base item's name...
int ArtifactName(int ext)
  if(ext == ARTIFACT_BEARDS_DELVER)
    return "BEARD'S DELVER"
  if(ext == ARTIFACT_SPLITTER)
    return "SPLITTER"
  if(ext == XITEM_TESTING_BRACELET)
    return "TESTING BRACELET"
  return NULL

//-----------------------------------------------------------------------
// Texture used instead of the base weapon's main texture...
int ArtifactTexture(int ext)
  if(ext == ARTIFACT_BEARDS_DELVER)
    return "FILE:=PICKGLD.RGB"
  if(ext == ARTIFACT_SPLITTER)
    return "FILE:=PICKSPL.RGB"
  return NULL

//-----------------------------------------------------------------------
// Texture used instead of the base weapon's shine/body texture (model slot
// +4)...  Bows use this one for their limbs...
int ArtifactShine(int ext)
  ext = ext & 255
  if(SWORDFX.IsSword(ext))
    return SWORDFX.Steel(ext)  // Tempered swords get a tinted blade...
  if(ext == ARTIFACT_SPLITTER)
    return "FILE:WOODSPL.RGB"
  if(ext == XITEM_BOW_BASE+WEAPON_VARIANT_MAGIC)
    return "FILE:WOODSPL.RGB"
  if(ext == XITEM_BOW_BASE+WEAPON_VARIANT_FIRE)
    return "FILE:WOODB2.RGB"
  if(ext == XITEM_BOW_BASE+WEAPON_VARIANT_ICE)
    return "FILE:WOODB3.RGB"
  if(ext == XITEM_BOW_BASE+WEAPON_VARIANT_VOLT)
    return "FILE:WOODB4.RGB"
  if(ext == XITEM_BOW_BASE+WEAPON_VARIANT_POISON)
    return "FILE:WOODB5.RGB"
  if(ext == XITEM_BOW_BASE+WEAPON_VARIANT_HOLY)
    return "FILE:WOODB6.RGB"
  if(ext == XITEM_BOW_BASE+WEAPON_VARIANT_UNHOLY)
    return "FILE:WOODB7.RGB"
  return NULL

//-----------------------------------------------------------------------
// Inventory icon used instead of the base item's icon...
int ArtifactIcon(int ext)
  ext = ext & 255  // Ignore the XITEM_CORED flag on modded weapons...
  if(ext == ARTIFACT_BEARDS_DELVER)
    return "FILE:=IPICKAR.RGB"
  if(ext == ARTIFACT_SPLITTER)
    return "FILE:=IBOWSPL.RGB"
  if(ext == XITEM_TESTING_BRACELET)
    return "FILE:=ITBRACE.RGB"
  if(ext == XITEM_FROST_THROWER)
    return "FILE:=IFLFRO.RGB"
  if(ext == XITEM_LEECH_BEAM)
    return "FILE:=IFLLEE.RGB"
  if(ext == XITEM_LIGHTNING_CANNON)
    return "FILE:=IFLLIT.RGB"
  if(ext == XITEM_ARCANE_BEAM)
    return "FILE:=IFLARC.RGB"
  if(ext == XITEM_VENOM_SPRAY)
    return "FILE:=IFLVEN.RGB"
  if(ext == XITEM_SANCTIFIER)
    return "FILE:=IFLSAN.RGB"
  if(ext > XITEM_GONNE_BASE && ext <= (XITEM_GONNE_BASE+7))
    return GonneIcon(ext-XITEM_GONNE_BASE)
  if(ext > XITEM_GRON_BASE && ext <= (XITEM_GRON_BASE+7))
    return GronIcon(ext-XITEM_GRON_BASE)
  if(ext > XITEM_CORE_BASE && ext <= XITEM_CORE_BASE+7)
    return CoreIcon(ext-XITEM_CORE_BASE)
  if(SWORDFX.IsSword(ext))
    return SWORDFX.Icon(ext)
  return NULL

//-----------------------------------------------------------------------
// Inventory icon for an item with an extension...  Some variants look
// different depending on the base item (short bow vs long bow)...
int ItemIcon(int ext, int item_type)
  int element, longbow
  element = (ext & 255) - XITEM_BOW_BASE
  if(element < WEAPON_VARIANT_MAGIC || element > WEAPON_VARIANT_UNHOLY)
    return ArtifactIcon(ext)
  // Bow variants...  (Icons draw red when the holder lacks the item's stat requirement, e.g. Long Bow STR)
  longbow = ((item_type & 252) == ITEM_LONG_BOW)
  if(longbow && element == WEAPON_VARIANT_MAGIC)
    return "FILE:=ILB1.RGB"
  if(longbow && element == WEAPON_VARIANT_FIRE)
    return "FILE:=ILB2.RGB"
  if(longbow && element == WEAPON_VARIANT_ICE)
    return "FILE:=ILB3.RGB"
  if(longbow && element == WEAPON_VARIANT_VOLT)
    return "FILE:=ILB4.RGB"
  if(longbow && element == WEAPON_VARIANT_POISON)
    return "FILE:=ILB5.RGB"
  if(longbow && element == WEAPON_VARIANT_HOLY)
    return "FILE:=ILB6.RGB"
  if(longbow)
    return "FILE:=ILB7.RGB"
  if(element == WEAPON_VARIANT_MAGIC)
    return "FILE:=IBOWSPL.RGB"
  if(element == WEAPON_VARIANT_FIRE)
    return "FILE:=IBOW2.RGB"
  if(element == WEAPON_VARIANT_ICE)
    return "FILE:=IBOW3.RGB"
  if(element == WEAPON_VARIANT_VOLT)
    return "FILE:=IBOW4.RGB"
  if(element == WEAPON_VARIANT_POISON)
    return "FILE:=IBOW5.RGB"
  if(element == WEAPON_VARIANT_HOLY)
    return "FILE:=IBOW6.RGB"
  return "FILE:=IBOW7.RGB"

//-----------------------------------------------------------------------
// Magic Cores...  Element is WEAPON_VARIANT_MAGIC (1) to WEAPON_VARIANT_UNHOLY (7)
int CoreIcon(int element)
  if(element == WEAPON_VARIANT_MAGIC)
    return "FILE:=ICORE1.RGB"
  if(element == WEAPON_VARIANT_FIRE)
    return "FILE:=ICORE2.RGB"
  if(element == WEAPON_VARIANT_ICE)
    return "FILE:=ICORE3.RGB"
  if(element == WEAPON_VARIANT_VOLT)
    return "FILE:=ICORE4.RGB"
  if(element == WEAPON_VARIANT_POISON)
    return "FILE:=ICORE5.RGB"
  if(element == WEAPON_VARIANT_HOLY)
    return "FILE:=ICORE6.RGB"
  if(element == WEAPON_VARIANT_UNHOLY)
    return "FILE:=ICORE7.RGB"
  return "FILE:=TINKASK.RGB"

//-----------------------------------------------------------------------
