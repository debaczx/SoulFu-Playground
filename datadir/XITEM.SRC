//-----------------------------------------------------------------------
int CoreName(int element)
  if(element == WEAPON_VARIANT_MAGIC)
    return "MAGIC CORE"
  if(element == WEAPON_VARIANT_FIRE)
    return "FIRE CORE"
  if(element == WEAPON_VARIANT_ICE)
    return "ICE CORE"
  if(element == WEAPON_VARIANT_VOLT)
    return "VOLT CORE"
  if(element == WEAPON_VARIANT_POISON)
    return "POISON CORE"
  if(element == WEAPON_VARIANT_HOLY)
    return "HOLY CORE"
  if(element == WEAPON_VARIANT_UNHOLY)
    return "UNHOLY CORE"
  return "DEAD CORE"

//-----------------------------------------------------------------------
// Puts an item with the given extension in the first free backpack slot...
// Returns TRUE if there was room...
int GiveArtifact(int who, int item, int ext)
  int i
  i = 224
  while(i < 240)
    if(FileReadByte(who, i) == ITEM_NONE)
      FileWriteByte(who, i, item)
      Set(who, i, ext)
      return TRUE
    i++
  return FALSE

//-----------------------------------------------------------------------
// Puts a core of the given element in the first free backpack slot...
// Returns TRUE if there was room...
int GiveCore(int who, int element)
  int i
  i = 224
  while(i < 240)
    if(FileReadByte(who, i) == ITEM_NONE)
      FileWriteByte(who, i, ITEM_CORE)
      Set(who, i, XITEM_CORE_BASE + element)
      return TRUE
    i++
  return FALSE

//-----------------------------------------------------------------------
// Backpack slot holding a core of the given element, or 0 if none...
int FindCore(int who, int element)
  int i
  i = 224
  while(i < 240)
    if(FileReadByte(who, i) == ITEM_CORE)
      if(Get(who, i) == XITEM_CORE_BASE + element)
        return i
    i++
  return 0

//-----------------------------------------------------------------------
// Chills a character for the given number of frames (if longer than what
// it has left)...  Chilled characters move and animate slower (engine)...
// Ice resistance shortens the chill by 1/8 per point (8 or more is immune),
// and ice weakness lengthens it the same way...
int Chill(int who, int frames)
  int now, resist
  if(!who)
    return FALSE
  resist = who.defice
  if(resist > 127)
    resist = resist - 256
  if(resist >= 8)
    return FALSE
  frames = (frames * (8 - resist)) / 8
  if(frames < 1)
    return FALSE
  if(frames > 65535)
    frames = 65535
  now = FileReadByte(who, CHILL_OFFSET+1)
  now = (now<<8) | FileReadByte(who, CHILL_OFFSET)
  if(frames > now)
    FileWriteByte(who, CHILL_OFFSET, frames & 255)
    FileWriteByte(who, CHILL_OFFSET+1, (frames>>8) & 255)
  return TRUE

//-----------------------------------------------------------------------
// Extra damage per hit...
int ArtifactDamage(int ext)
  if(ext == ARTIFACT_BEARDS_DELVER)
    return 1
  return 0

//-----------------------------------------------------------------------
// Extra SPECIAL_FLAG_ bits for attacks (DRAIN, POISON, etc.)...
int ArtifactFlags(int ext)
  if(ext == ARTIFACT_BEARDS_DELVER)
    return SPECIAL_FLAG_DRAIN
  return 0

//-----------------------------------------------------------------------
// Most soft hits a draining artifact restores per hit (heals 1 to this)...
// 0 means normal drain (as much as the hit dealt)...
int ArtifactDrainAmount(int ext)
  if(ext == ARTIFACT_BEARDS_DELVER)
    return 2
  return 0

//-----------------------------------------------------------------------
// Mending: percent chance, per damaging hit, to heal hard wounds...
int ArtifactMendChance(int ext)
  if(ext == ARTIFACT_BEARDS_DELVER)
    return 25
  return 0

//-----------------------------------------------------------------------
// Mending: most hard wounds healed when it triggers (heals 1 to this)...
int ArtifactMendAmount(int ext)
  if(ext == ARTIFACT_BEARDS_DELVER)
    return 2
  return 0

//-----------------------------------------------------------------------
// TRUE if the artifact bow's arrows burst into two magic missiles on hit...
int ArtifactSplits(int ext)
  if(ext == ARTIFACT_SPLITTER)
    return TRUE
  return FALSE


//-----------------------------------------------------------------------
// Hooks called from the item scripts...
//-----------------------------------------------------------------------
// Call at the end of a weapon's ModelSetup()...  Swaps in the artifact's
// texture, if it has one...
int WeaponModelSetup(int self, int grip)
  int texture
  texture = ArtifactTexture(SystemGet(SYS_ITEMEXT, 0, 0))
  if(texture)
    ModelAssign(self+grip+8, texture)
  texture = ArtifactShine(SystemGet(SYS_ITEMEXT, 0, 0))
  if(texture)
    ModelAssign(self+grip+4, texture)
  return TRUE

//-----------------------------------------------------------------------
// NOTE: The script compiler doesn't close an if() block that sits on the
// very last line of a file (its jump target is left at 0, which crashes).
// Always end a file with a line at function level, like the return above.
// NOTE: "return a + b" compiles as "return a" (the rest is silently lost).
// Always wrap returned expressions in parentheses: return (a + b)
// NOTE: Names are case-insensitive and #defines win over variables, so a
// variable called "character" silently becomes CHARACTER (0)...  Check
// DEFINE.TXT before picking variable names.
//-----------------------------------------------------------------------
