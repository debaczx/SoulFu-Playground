//-----------------------------------------------------------------------
// <ZZ> Forged gear (the D'warf's Forge, see IMODIFY.SRC)...
//      A plain Pick Axe, Hatchet, Broad Axe, Shield or Mirror Shield plus
//      a Magic Core.  The extension is base + element:
//          97-103   Pick Axe       Simple chances
//          105-111  Hatchet        Crowd control on a wide swing
//          113-119  Broad Axe      Rare, big moments
//          121-127  Shield         Small effects when blocking
//          129-135  Mirror Shield  Big effects when blocking
//      The D'warf is a tank, so it's about staying alive, controlling
//      crowds and protecting...  Many effects get stronger at Last Stand
//      (below half health).  Design: dwarf-wheel-ideas.md
//      PATTACK.FrameEvent() stores on a weapon's attack particle:
//          red     The variant (its extension)
//          green   1 if the effect goes off this swing (SwingProc)
//          blue    Once-per-swing counter
//      PATTACK.Event() calls Hit() for each enemy hit, Hurt() for each
//      character hurt (Grudge), and Blocked() when a hit is blocked...
//-----------------------------------------------------------------------
#define ICE_SMOKE_COLOR (4239600)
#define UNHOLY_COLOR    (8388608)
#define FORGE_PICK      0
#define FORGE_HATCHET   1
#define FORGE_BROAD     2
#define FORGE_SHIELD    3
#define FORGE_MIRROR    4
#define GRUDGE_OFFSET   671   // Character data (unsaved): Grudge hatchet's stored hits


//-----------------------------------------------------------------------
// TRUE if ext is forged gear...
int IsForged(int ext)
  ext = ext & 255
  if(ext > XITEM_PICK_AXE_BASE && ext < (XITEM_MIRROR_BASE+8))
    if(ext & 7)
      return TRUE
  return FALSE

//-----------------------------------------------------------------------
// FORGE_ kind of forged gear...
int ForgeKind(int ext)
  return (((ext & 255) - XITEM_PICK_AXE_BASE) >> 3)

//-----------------------------------------------------------------------
// WEAPON_VARIANT_ element of forged gear...
int ForgeElement(int ext)
  return (ext & 7)

//-----------------------------------------------------------------------
// TRUE when the holder is below half health...
int LastStand(int who)
  if((who.hits<<1) < who.hitsmax)
    return TRUE
  return FALSE

//-----------------------------------------------------------------------
// Percent chance (per swing for weapons, per block for shields)...
int Chance(int ext, int holder)
  int kind, element
  kind = ForgeKind(ext)
  element = ForgeElement(ext)
  if(kind == FORGE_PICK)
    if(element == WEAPON_VARIANT_MAGIC)
      return 15
    if(element == WEAPON_VARIANT_FIRE)
      return 20
    if(element == WEAPON_VARIANT_ICE)
      return 25
    if(element == WEAPON_VARIANT_VOLT)
      return 15
    if(element == WEAPON_VARIANT_POISON)
      return 25
    if(element == WEAPON_VARIANT_HOLY)
      return 15
    if(element == WEAPON_VARIANT_UNHOLY)
      return 20
  if(kind == FORGE_HATCHET)
    if(element == WEAPON_VARIANT_MAGIC)
      return 100
    if(element == WEAPON_VARIANT_FIRE)
      if(LastStand(holder))
        return 100
      return 25
    if(element == WEAPON_VARIANT_ICE)
      return 20
    if(element == WEAPON_VARIANT_VOLT)
      return 20
    if(element == WEAPON_VARIANT_POISON)
      return 25
    if(element == WEAPON_VARIANT_HOLY)
      if(LastStand(holder))
        return 40
      return 15
    if(element == WEAPON_VARIANT_UNHOLY)
      return 0
  if(kind == FORGE_BROAD)
    if(element == WEAPON_VARIANT_MAGIC)
      return 100
    if(element == WEAPON_VARIANT_FIRE)
      return 25
    if(element == WEAPON_VARIANT_ICE)
      return 25
    if(element == WEAPON_VARIANT_VOLT)
      return 25
    if(element == WEAPON_VARIANT_POISON)
      return 100
    if(element == WEAPON_VARIANT_HOLY)
      return 100
    if(element == WEAPON_VARIANT_UNHOLY)
      return 100
  if(kind == FORGE_SHIELD)
    if(element == WEAPON_VARIANT_MAGIC)
      return 25
    if(element == WEAPON_VARIANT_FIRE)
      return 30
    if(element == WEAPON_VARIANT_ICE)
      return 100
    if(element == WEAPON_VARIANT_VOLT)
      return 30
    if(element == WEAPON_VARIANT_POISON)
      return 30
    if(element == WEAPON_VARIANT_HOLY)
      if(LastStand(holder))
        return 50
      return 25
    if(element == WEAPON_VARIANT_UNHOLY)
      return 25
  if(kind == FORGE_MIRROR)
    if(element == WEAPON_VARIANT_MAGIC)
      return 100
    if(element == WEAPON_VARIANT_FIRE)
      return 30
    if(element == WEAPON_VARIANT_ICE)
      return 30
    if(element == WEAPON_VARIANT_VOLT)
      return 30
    if(element == WEAPON_VARIANT_POISON)
      return 30
    if(element == WEAPON_VARIANT_HOLY)
      return 25
    if(element == WEAPON_VARIANT_UNHOLY)
      return 30
  return 0
//-----------------------------------------------------------------------
