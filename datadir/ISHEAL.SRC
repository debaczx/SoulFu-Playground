//-----------------------------------------------------------------------
int GetName()
  STANDARD.ItemName("SUPER HEALING POTION", NULL, 255, 0, 0, 0, 0)

//-----------------------------------------------------------------------
// What this item does when used...
int Effect(int self)
  int old_defedge
  if(self)
    PlaySound("FILE:-POTION.RAW", 256, 255)
    PPOTION.Effect(self.x, self.y, self.z, self.height*0.05, self.boxsize*1.5, 20, WHITE, "FILE:SPARK4.RGB", 20)
    PFLASH.Effect(self, "FILE:SPARK4.RGB", WHITE, TRUE, 1.0)
    if(self.action == ACTION_STAND || self.action == ACTION_WALK)
      self.action = ACTION_SPECIAL_2
    if(self.defwoun > 0)
      // An undead monster is drinking a healing potion...
      old_defedge = self.defedge
      self.defedge = 0
      SystemSet(SYS_DAMAGECHARACTER, FindIndex(self), (DAMAGE_EDGE<<16) | (self.hitsmax<<8) | 0, FindIndex(self))
      self.defedge = old_defedge
    else
      if(!(self.oflags & OTHER_FLAG_NO_HEARTS))
        if(self.hits < self.hitsmax)
          ExperienceFunction(self.owner, EXPERIENCE_VIRTUE_COMPASSION, 5, FALSE)
        RestoreCharacterHits(self, self.hitsmax, 1)
        if(self.pstimer > 30)
          self.pstimer = 30
        ExperienceFunction(FindIndex(self), EXPERIENCE_VIRTUE_COURAGE, -20, FALSE)

//-----------------------------------------------------------------------
// Called when item is first used, to start proper animation
int Event()
  int self, grip

  self = FindSelf()
  grip = SystemGet(SYS_WEAPONGRIP, 0, 0)
  STANDARD.AutoReload(self, grip)
  Effect(self)
  ButtonHandled()

//-----------------------------------------------------------------------
// Called when right clicked in inventory...
int DirectUsage()
  int self

  self = FindBinding()
  if(self)
    Effect(self)
    SystemSet(SYS_KEEPITEM, 0, 0, FALSE)

//-----------------------------------------------------------------------

